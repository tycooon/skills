#!/usr/bin/env python3
"""Tests for bin/review-scan. Run: bin/test-review-scan"""

import contextlib
import importlib.machinery
import importlib.util
import io
import json
import os
import sys
import tempfile
import unittest
from pathlib import Path

sys.dont_write_bytecode = True  # loading bin/review-scan as a module would litter bin/
SCRIPT = Path(__file__).resolve().parent / "review-scan"
TMP = tempfile.TemporaryDirectory()
os.environ["REVIEW_SCAN_HOME"] = TMP.name


def load_module():
    loader = importlib.machinery.SourceFileLoader("review_scan", str(SCRIPT))
    spec = importlib.util.spec_from_loader("review_scan", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


rs = load_module()
A, B = "a" * 40, "b" * 40
PR1 = "https://github.com/acme/app/pull/1"
PR2 = "https://github.com/acme/app/pull/2"
RECENT = "2026-10-23T10:00:00Z"


def act(head=A, updated=RECENT, authors=(), approvers=("review-bot",), threads=(), approved_at=None):
    if approved_at is None:
        approved_at = {(who, head) for who in approvers}
    return {"head": head, "updated": updated, "authors": set(authors), "approved_at": set(approved_at),
            "noted_at": set(), "author": "dev", "threads": set(threads)}


SINCE = ["--since", "2026-10-23T11:00:00Z", "--verdict", "approved"]


def row(url, head=A, updated=RECENT, draft=False, state="open", named=False):
    return rs.pr_row(url, head, updated, draft, f"title {url[-1]}", "master", f"br{url[-1]}", "dev", state, named)


class Base(unittest.TestCase):
    def setUp(self):
        self.listing = {"acme/app": [row(PR1), row(PR2)]}
        self.activity = {}
        self.spawned = []
        rs.list_target = lambda spec: self.listing[spec]
        rs.activity_since = lambda url, since: self.activity[url]
        rs.now_utc = lambda: rs.parse_time("2026-10-23T12:00:00Z")
        self.notified = []
        rs.notify = self.notified.append
        self.watch = f"w{self.id().split('.')[-1]}"
        self.cli("init", self.watch, "--target", "acme/app", "--own", "review-bot", "--reviewer-model", "sonnet")

    def cli(self, *argv, spawn=None):
        out = io.StringIO()
        with contextlib.redirect_stdout(out):
            code = rs.main(list(argv)) if argv[0] != "tick" else rs.cmd_tick(self.tick_args(*argv[1:]),
                                                                                spawn=spawn or self.spawn)
        return code, out.getvalue()

    def tick_args(self, watch, *flags):
        class A_: pass
        a = A_()
        a.watch, a.full, a.only, a.dry_run = watch, "--full" in flags, None, "--dry-run" in flags
        a.chained = "--chained" in flags
        if "--only" in flags:
            a.only = flags[flags.index("--only") + 1]
        return a

    def spawn(self, w, url, brief):
        self.spawned.append((url, brief))

    def prs(self):
        return json.loads((Path(TMP.name) / self.watch / "prs.json").read_text())


class Tick(Base):
    def test_first_tick_starts_a_run_per_unreviewed_pr(self):
        code, out = self.cli("tick", self.watch)
        self.assertEqual(code, 0)
        self.assertEqual([u for u, _ in self.spawned], [PR1, PR2])
        self.assertIn("2 listed, 2 kept", out)

    def test_settled_unchanged_pr_costs_no_run(self):
        self.cli("tick", self.watch)
        self.activity[PR1] = act(authors={"review-bot"})
        self.activity[PR2] = act()
        self.cli("settle", self.watch, PR1, "--head", A, *SINCE)
        self.cli("settle", self.watch, PR2, "--head", A, *SINCE)
        self.spawned.clear()
        self.cli("tick", self.watch)
        self.assertEqual(self.spawned, [])

    def test_new_head_or_activity_makes_a_pr_owed(self):
        self.cli("tick", self.watch)
        for u in (PR1, PR2):
            self.activity[u] = act()
            self.cli("settle", self.watch, u, "--head", A, *SINCE)
        self.listing["acme/app"] = [row(PR1, head=B), row(PR2, updated="2026-10-23T11:30:00Z")]
        self.spawned.clear()
        _, out = self.cli("tick", self.watch)
        self.assertEqual([u for u, _ in self.spawned], [PR1, PR2])
        self.assertIn("new head", out)
        self.assertIn("activity at", out)

    def test_drafts_and_dormant_prs_are_skipped(self):
        self.listing["acme/app"] = [row(PR1, draft=True), row(PR2, updated="2026-09-01T00:00:00Z")]
        _, out = self.cli("tick", self.watch)
        self.assertEqual(self.spawned, [])
        self.assertIn("1 draft, 1 dormant", out)

    def test_parallel_cap_holds_the_rest_for_a_later_tick(self):
        self.listing["acme/app"] = [row(f"https://github.com/acme/app/pull/{n}") for n in range(1, 6)]
        _, out = self.cli("tick", self.watch)
        self.assertEqual(len(self.spawned), 3)
        self.assertEqual(out.count("waiting for a free slot"), 2)

    def test_unreadable_target_is_reported_not_silent(self):
        def boom(spec):
            raise rs.ScanError("403")
        rs.list_target = boom
        code, out = self.cli("tick", self.watch)
        self.assertEqual(code, 5)
        self.assertIn("UNREAD", out)

    def test_listing_behind_the_settle_is_not_news(self):
        self.cli("tick", self.watch)
        for u in (PR1, PR2):
            self.activity[u] = act(head=B, updated="2026-10-23T11:50:00Z")
            self.cli("settle", self.watch, u, "--head", B, *SINCE)
        self.spawned.clear()
        self.cli("tick", self.watch)  # search still shows the old head and time
        self.assertEqual(self.spawned, [])

    def test_a_run_that_fails_to_start_does_not_end_the_tick(self):
        def spawn(w, url, brief):
            if url == PR1:
                raise FileNotFoundError("claude")
            self.spawned.append((url, brief))
        code, out = self.cli("tick", self.watch, spawn=spawn)
        self.assertEqual(code, 5)
        self.assertEqual([u for u, _ in self.spawned], [PR2])
        self.assertIn("FAILED to start", out)
        self.assertNotIn("last_run", self.prs()[PR1])
        self.assertEqual(len(self.notified), 1)

    def test_every_target_unread_notifies_once(self):
        def boom(spec):
            raise rs.ScanError("401")
        rs.list_target = boom
        self.cli("tick", self.watch)
        self.cli("tick", self.watch)
        self.assertEqual(len(self.notified), 1)
        _, out = self.cli("status", self.watch)
        self.assertIn("PROBLEM", out)
        rs.list_target = lambda spec: self.listing[spec]
        self.cli("tick", self.watch)
        _, out = self.cli("status", self.watch)
        self.assertNotIn("PROBLEM", out)

    def test_brief_carries_the_settle_command_and_the_reviewed_head(self):
        self.cli("tick", self.watch)
        brief = self.spawned[0][1]
        self.assertIn(f"review-scan settle {self.watch} {PR1} --head", brief)
        self.assertIn("*One run reviews one PR*", brief)
        self.assertIn(PR2, brief)  # siblings listed for related-PR checks

    def test_unsettled_earlier_run_is_flagged_to_the_next(self):
        self.cli("tick", self.watch)
        self.spawned.clear()
        self.cli("tick", self.watch)  # never settled: owed again, with the warning
        self.assertIn("never settled", self.spawned[0][1])


class Settle(Base):
    def setUp(self):
        super().setUp()
        self.cli("tick", self.watch)

    def test_refuses_when_head_moved(self):
        self.activity[PR1] = act(head=B)
        code, _ = self.cli("settle", self.watch, PR1, "--head", A, *SINCE)
        self.assertEqual(code, 3)
        self.assertNotIn("settled", self.prs()[PR1])

    def test_refuses_when_someone_else_posted_during_the_run(self):
        self.activity[PR1] = act(authors={"review-bot", "author"})
        code, out = self.cli("settle", self.watch, PR1, "--head", A, *SINCE)
        self.assertEqual(code, 4)
        self.assertIn("author", out)

    def test_records_weighed_threads_and_sibling_rechecks(self):
        self.activity[PR1] = act(authors={"review-bot"})
        code, _ = self.cli("settle", self.watch, PR1, "--head", A, *SINCE, "--weighed", "t1", "--recheck", PR2)
        self.assertEqual(code, 0)
        prs = self.prs()
        self.assertEqual(prs[PR1]["settled"]["weighed"], ["t1"])
        self.assertTrue(prs[PR2]["recheck"])

    def test_refuses_a_verdict_the_pr_does_not_show(self):
        self.activity[PR1] = act(approvers=(), threads=("someone-else",))
        code, _ = self.cli("settle", self.watch, PR1, "--head", A, *SINCE)
        self.assertEqual(code, 6)
        code, _ = self.cli("settle", self.watch, PR1, "--head", A, "--since", "2026-10-23T11:00:00Z",
                           "--verdict", "findings")
        self.assertEqual(code, 6)
        self.activity[PR1] = act(approvers=(), threads=("review-bot",))
        code, _ = self.cli("settle", self.watch, PR1, "--head", A, "--since", "2026-10-23T11:00:00Z",
                           "--verdict", "findings")
        self.assertEqual(code, 0)
        self.assertNotIn("settled", self.prs()[PR2])

    def test_an_approval_of_an_earlier_covering_head_settles(self):
        self.activity[PR1] = act(head=B, approvers=(), approved_at={("review-bot", A)})
        code, _ = self.cli("settle", self.watch, PR1, "--head", B, *SINCE)
        self.assertEqual(code, 6)
        code, _ = self.cli("settle", self.watch, PR1, "--head", B, *SINCE, "--covered-by", A[:12])
        self.assertEqual(code, 0)
        self.activity[PR2] = act(head=B, approvers=(), approved_at={("someone-else", A)})
        code, _ = self.cli("settle", self.watch, PR2, "--head", B, *SINCE, "--covered-by", A)
        self.assertEqual(code, 6)

    def test_an_approved_comment_covers_only_where_a_formal_approval_is_impossible(self):
        pr = act(head=B, approvers=())
        pr.update(noted_at={("review-bot", A[:12])}, author="dev")
        self.activity[PR1] = pr
        code, _ = self.cli("settle", self.watch, PR1, "--head", B, *SINCE, "--covered-by", A[:12])
        self.assertEqual(code, 6)
        pr["author"] = "review-bot"  # GitHub refuses a self-approval
        code, _ = self.cli("settle", self.watch, PR1, "--head", B, *SINCE, "--covered-by", A[:12])
        self.assertEqual(code, 0)

    def test_sibling_recheck_registers_once_and_only_on_success(self):
        self.activity[PR1] = act(approvers=())
        code, _ = self.cli("settle", self.watch, PR1, "--head", A, *SINCE, "--recheck", PR2)
        self.assertEqual(code, 6)
        self.assertNotIn("recheck", self.prs()[PR2])
        self.activity[PR1] = act()
        self.cli("settle", self.watch, PR1, "--head", A, *SINCE, "--recheck", PR2)
        self.cli("settle", self.watch, PR1, "--head", A, *SINCE, "--recheck", PR2)
        self.assertEqual(len(self.prs()[PR2]["recheck"]), 1)

    def test_rechecks_survive_a_failed_run_and_clear_on_settle(self):
        self.activity[PR1] = act()
        self.cli("settle", self.watch, PR1, "--head", A, *SINCE)
        self.activity[PR2] = act()
        self.cli("settle", self.watch, PR2, "--head", A, *SINCE, "--recheck", PR1)
        self.spawned.clear()
        self.cli("tick", self.watch)
        self.assertEqual([u for u, _ in self.spawned], [PR1])
        self.assertTrue(self.prs()[PR1]["recheck"])  # the run may die: still owed
        self.spawned.clear()
        self.cli("tick", self.watch)
        self.assertEqual([u for u, _ in self.spawned], [PR1])
        self.cli("settle", self.watch, PR1, "--head", A, *SINCE)
        self.assertNotIn("recheck", self.prs()[PR1])


class NamedPr(Base):
    def test_named_pr_reviewed_as_draft_and_leaves_when_merged(self):
        self.cli("init", self.watch, "--target", PR1, "--own", "review-bot")
        self.listing[PR1] = [row(PR1, draft=True, named=True)]
        self.cli("tick", self.watch)
        self.assertEqual([u for u, _ in self.spawned], [PR1])
        self.listing[PR1] = [row(PR1, state="merged", named=True)]
        _, out = self.cli("tick", self.watch)
        self.assertIn("left the watch", out)
        self.assertIn("nothing left to watch", out)


class Spawn(Base):
    def test_run_uses_the_configured_reviewer_model(self):
        seen = {}

        class FakePopen:
            def __init__(self, cmd, **kw):
                seen["cmd"], self.pid = cmd, 4242

        real, real_start, real_login = rs.subprocess.Popen, rs.proc_start, rs.claude_logged_in
        rs.subprocess.Popen = FakePopen
        rs.claude_logged_in = lambda: True
        rs.proc_start = lambda pid: "Fri Oct 23 12:00:00 2026" if pid == 4242 else None
        try:
            w = rs.Watch(self.watch).load()
            rs.spawn_run(w, PR1, "brief")
            cmd = seen["cmd"]
            self.assertEqual(cmd[cmd.index("--model") + 1], "sonnet")
            self.assertEqual(cmd[cmd.index("--permission-mode") + 1], "auto")
            self.assertTrue(w.running(PR1))
            rs.proc_start = lambda pid: "Sat Oct 24 09:00:00 2026"  # pid reused by another process
            self.assertFalse(w.running(PR1))
        finally:
            rs.subprocess.Popen, rs.proc_start, rs.claude_logged_in = real, real_start, real_login

    def test_a_logged_out_cli_fails_the_start_and_notifies(self):
        real_login = rs.claude_logged_in
        rs.claude_logged_in = lambda: False
        try:
            code, out = self.cli("tick", self.watch, spawn=rs.spawn_run)
        finally:
            rs.claude_logged_in = real_login
        self.assertEqual(code, 5)
        self.assertEqual(out.count("FAILED to start (the claude CLI is logged out"), 2)
        self.assertNotIn("last_run", self.prs()[PR1])
        self.assertEqual(len(self.notified), 1)

    def test_login_status_is_read_once_and_unreadable_is_not_logged_out(self):
        calls = []

        def fake_run(cmd, **kw):
            calls.append(cmd)
            return rs.subprocess.CompletedProcess(cmd, 1, stdout=self.status_out, stderr="")

        real_run = rs.subprocess.run
        rs.subprocess.run = fake_run
        try:
            for out, expected in (('{"loggedIn": false}', False), ('{"loggedIn": true}', True), ("garbage", True)):
                rs._logged_in, self.status_out = None, out
                self.assertEqual(rs.claude_logged_in(), expected)
                rs.claude_logged_in()
            self.assertEqual(len(calls), 3)
        finally:
            rs.subprocess.run, rs._logged_in = real_run, None


class Nudge(Base):
    def test_nudge_marks_a_recheck_and_starts_a_tick_for_that_pr(self):
        started = []

        class FakePopen:
            def __init__(self, cmd, **kw):
                started.append(cmd)

        real = rs.subprocess.Popen
        rs.subprocess.Popen = FakePopen
        try:
            code, out = self.cli("nudge", PR1, "--head", B)
            _, miss = self.cli("nudge", "https://github.com/other/repo/pull/9", "--head", B)
        finally:
            rs.subprocess.Popen = real
        self.assertEqual(code, 0)
        self.assertIn(f"nudged watch {self.watch}", out)
        self.assertIn(["tick", self.watch, "--only", PR1], [c[1:] for c in started])
        self.assertIn("nudge after a push", self.prs()[PR1]["recheck"][0])
        self.assertNotIn(self.watch, miss)


class VerdictNotes(unittest.TestCase):
    def test_only_a_note_that_opens_with_approved_counts(self):
        notes = rs.verdict_notes([("bot", f"APPROVED (formal approval refused: self-approval). AI reviewer: Claude. Reviewed {A}."),
                                  ("bot", f"P3: an APPROVED comment naming {B} is not a formal approval")])
        self.assertEqual(notes, {("bot", A)})
        bold = rs.verdict_notes([("bot", f"**APPROVED** at {B} — AI reviewer: Claude")])
        self.assertEqual(bold, {("bot", B)})


class Init(unittest.TestCase):
    def test_own_accounts_are_required(self):
        with contextlib.redirect_stderr(io.StringIO()), self.assertRaises(SystemExit):
            rs.main(["init", "noown", "--target", "acme/app"])


class List(Base):
    def test_list_and_bare_status_show_every_watch(self):
        real, real_sched = rs.our_pid, rs.is_scheduled
        rs.our_pid = lambda pidfile: None
        rs.is_scheduled = lambda name: False
        try:
            _, out = self.cli("list")
            _, bare = self.cli("status")
        finally:
            rs.our_pid, rs.is_scheduled = real, real_sched
        self.assertIn(f"{self.watch}: reviewer sonnet, not scheduled, 0 run(s) in flight", out)
        self.assertIn("  acme/app", out)
        self.assertEqual(out, bare)


class Status(Base):
    def test_status_separates_running_waiting_ended_and_settled(self):
        self.listing["acme/app"] = [row(f"https://github.com/acme/app/pull/{n}") for n in range(1, 6)]
        self.cli("tick", self.watch)  # 1-3 start, 4-5 wait
        self.activity[PR1] = act()
        self.cli("settle", self.watch, PR1, "--head", A, *SINCE)
        real_running, real_sched = rs.Watch.running, rs.is_scheduled
        rs.Watch.running = lambda w, url: url.endswith("/3")
        rs.is_scheduled = lambda name: True
        try:
            _, out = self.cli("status", self.watch)
        finally:
            rs.Watch.running, rs.is_scheduled = real_running, real_sched
        self.assertIn("3 started, 2 waiting for a slot", out)
        self.assertIn(f"  started {PR1}: settled approved at", out)
        self.assertIn("  started https://github.com/acme/app/pull/3: running for", out)
        self.assertIn("  started https://github.com/acme/app/pull/2: ended without settling", out)
        self.assertIn("running (1):\n  https://github.com/acme/app/pull/3: started", out)
        self.assertIn("waiting for a slot (2):", out)
        self.assertIn("ended without settling (1):\n  https://github.com/acme/app/pull/2", out)
        self.assertIn(f"settled, newest first (1):\n  {PR1}: approved at {A[:12]}", out)


class Scheduled(unittest.TestCase):
    def test_off_macos_the_crontab_line_counts(self):
        tab = "*/5 * * * * /bin/bash -lc 'exec /home/u/.claude/bin/review-scan tick work' >> /x/cron.log 2>&1\n"
        real_platform, real_run = rs.sys.platform, rs.subprocess.run
        rs.sys.platform = "linux"
        rs.subprocess.run = lambda cmd, **kw: rs.subprocess.CompletedProcess(cmd, 0, stdout=tab, stderr="")
        try:
            self.assertTrue(rs.is_scheduled("work"))
            self.assertFalse(rs.is_scheduled("wor"))
            self.assertFalse(rs.is_scheduled("main"))
        finally:
            rs.sys.platform, rs.subprocess.run = real_platform, real_run


class TargetToken(Base):
    def test_a_target_token_reaches_the_brief_and_status(self):
        self.cli("init", self.watch, "--target", "acme/app", "--own", "review-bot",
                 "--token", "acme/app=PR_REVIEW_TOKEN_ACME")
        self.cli("tick", self.watch)
        self.assertIn("`$PR_REVIEW_TOKEN_ACME`", self.spawned[0][1])
        self.assertIn('`PR_REVIEW_GH_TOKEN="$PR_REVIEW_TOKEN_ACME"` exported', self.spawned[0][1])
        _, out = self.cli("status", self.watch)
        self.assertIn("posts with $PR_REVIEW_TOKEN_ACME", out)

    def test_a_token_for_an_unknown_target_is_refused(self):
        with contextlib.redirect_stderr(io.StringIO()), self.assertRaises(SystemExit):
            rs.main(["init", self.watch, "--target", "acme/app", "--own", "x", "--token", "other=VAR"])


class ChainedTick(Base):
    def test_a_chained_tick_does_nothing_once_the_watch_is_uninstalled(self):
        real = rs.is_scheduled
        try:
            rs.is_scheduled = lambda name: False
            self.assertEqual(self.cli("tick", self.watch, "--chained")[0], 0)
            self.assertEqual(self.spawned, [])
            rs.is_scheduled = lambda name: True
            self.cli("tick", self.watch, "--chained")
            self.assertEqual(len(self.spawned), 2)
        finally:
            rs.is_scheduled = real

    def test_a_manual_tick_runs_whether_or_not_the_watch_is_installed(self):
        real = rs.is_scheduled
        rs.is_scheduled = lambda name: False
        try:
            self.cli("tick", self.watch)
        finally:
            rs.is_scheduled = real
        self.assertEqual(len(self.spawned), 2)


class ChainTick(unittest.TestCase):
    def wrap(self, min_seconds, command):
        """Runs the real wrapper with a stand-in review-scan that records the tick it was asked for."""
        d = Path(tempfile.mkdtemp(dir=TMP.name))
        marker, pidfile, exe = d / "ticked", d / "run.pid", d / "review-scan"
        exe.write_text(f"#!/bin/sh\necho \"$@\" > {marker}\n")
        exe.chmod(0o755)
        pidfile.write_text("1 x")
        rc = rs.subprocess.run(["/bin/sh", "-c", rs.WRAPPER, str(pidfile), str(exe), "work", str(min_seconds), *command]).returncode
        for _ in range(50):  # the tick goes to the background
            if marker.exists():
                break
            rs.time.sleep(0.02)
        return rc, marker.read_text().strip() if marker.exists() else None, pidfile.exists()

    def test_a_finished_run_starts_a_tick_and_keeps_its_exit_code(self):
        rc, ticked, pidfile_left = self.wrap(0, ["sh", "-c", "exit 3"])
        self.assertEqual((rc, ticked, pidfile_left), (3, "tick --chained work", False))

    def test_a_run_under_the_threshold_starts_none(self):
        rc, ticked, pidfile_left = self.wrap(60, ["true"])
        self.assertEqual((rc, ticked, pidfile_left), (0, None, False))

    def test_spawn_passes_the_watch_and_threshold_to_the_wrapper(self):
        seen = {}

        class FakePopen:
            def __init__(self, cmd, **kw):
                seen["cmd"], self.pid = cmd, 4242

        real = rs.subprocess.Popen, rs.proc_start, rs.claude_logged_in, rs.shutil.which
        rs.subprocess.Popen, rs.proc_start = FakePopen, (lambda pid: "t")
        rs.claude_logged_in, rs.shutil.which = (lambda: True), (lambda name: "/bin/claude")
        try:
            with contextlib.redirect_stdout(io.StringIO()):
                rs.main(["init", "chain", "--target", "acme/app", "--own", "x"])
            rs.spawn_run(rs.Watch("chain").load(), PR1, "brief")
        finally:
            rs.subprocess.Popen, rs.proc_start, rs.claude_logged_in, rs.shutil.which = real
        cmd = seen["cmd"]
        self.assertEqual(cmd[:3], ["/bin/sh", "-c", rs.WRAPPER])
        self.assertEqual(cmd[5:9], ["chain", str(rs.CHAIN_AFTER), "claude", "-p"])


class Covers(unittest.TestCase):
    def test_specs(self):
        self.assertTrue(rs.covers("acme/app", PR1))
        self.assertTrue(rs.covers("acme", PR1))
        self.assertFalse(rs.covers("other", PR1))
        mr = "https://gitlab.example.com/grp/sub/proj/-/merge_requests/5"
        self.assertTrue(rs.covers("gitlab:gitlab.example.com/grp", mr))
        self.assertTrue(rs.covers("gitlab:gitlab.example.com/grp/sub/proj!", mr))
        self.assertFalse(rs.covers("gitlab:gitlab.example.com/gr", mr))


if __name__ == "__main__":
    unittest.main(verbosity=1)
