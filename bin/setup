#!/usr/bin/env bash
#
# Copy every skill in this repo into each agent runtime's skills directory.
#
# A "skill" is any immediate subdirectory containing a SKILL.md. Each skill is
# rsync'd (mirrored) into every runtime's skills dir as a real copy rather than
# a symlink, because some runtimes (e.g. ZCODE) don't reliably follow symlinked
# skill directories. Safe to re-run: copies are re-synced in place, any
# pre-existing symlink (e.g. from an earlier version of this script) is replaced
# with a real copy, and unrelated skills already in the target dirs are left
# untouched. Re-run after editing a skill to propagate the changes.

set -euo pipefail
shopt -s nullglob

command -v rsync >/dev/null 2>&1 || {
  echo "rsync is required but was not found in PATH." >&2
  exit 1
}

# Resolve this repo's root (the parent of bin/), following symlinks to the script.
source="${BASH_SOURCE[0]}"
while [ -L "$source" ]; do
  dir="$(cd -P "$(dirname "$source")" && pwd)"
  source="$(readlink "$source")"
  [[ $source != /* ]] && source="$dir/$source"
done
repo_root="$(cd -P "$(dirname "$source")/.." && pwd)"

# One skills directory per agent runtime.
targets=(
  "$HOME/.claude/skills"
  "$HOME/.codex/skills"
  "$HOME/.zcode/skills"
)

# Collect skill directories (those holding a SKILL.md).
skills=()
for skill_md in "$repo_root"/*/SKILL.md; do
  skills+=("$(dirname "$skill_md")")
done

if [ ${#skills[@]} -eq 0 ]; then
  echo "No skills found in $repo_root (expected <skill>/SKILL.md)." >&2
  exit 1
fi

sync_skill() {
  local src="$1" dest="$2"
  # Replace a pre-existing symlink (or stray non-directory) with a real copy.
  if [ -L "$dest" ] || { [ -e "$dest" ] && [ ! -d "$dest" ]; }; then
    rm -f "$dest"
  fi
  rsync -a --delete --exclude='.DS_Store' "$src/" "$dest/"
  echo "  synced    $(basename "$dest")"
}

for target in "${targets[@]}"; do
  mkdir -p "$target"
  echo "$target"
  for skill in "${skills[@]}"; do
    sync_skill "$skill" "$target/$(basename "$skill")"
  done
done

echo
echo "Synced ${#skills[@]} skill(s) into ${#targets[@]} runtime(s)."
