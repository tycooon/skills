#!/usr/bin/env bash
#
# Copy every skill in this repo into each agent runtime's skills directory.
#
# A "skill" is any immediate subdirectory containing a SKILL.md. Each skill is
# rsync'd (mirrored) into every runtime's skills dir as a real copy rather than
# a symlink, because some runtimes (e.g. ZCODE) don't reliably follow symlinked
# skill directories. Safe to re-run: copies are re-synced in place, any
# pre-existing symlink (e.g. from an earlier version of this script) is replaced
# with a real copy, and unrelated skills already in the target dirs are left
# untouched. Re-run after editing a skill to propagate the changes. The shared
# references/ directory is mirrored beside the skills the same way, so a skill's
# ../references/ links resolve in every runtime.
#
# It also installs bin/claude-memory into ~/.claude/bin and registers its hook:
# on a Mac the SessionEnd push, and with --cloud (the Claude cloud environment's
# setup script) the SessionStart pull. bin/wait-pr-ready, which babysit-pr,
# release and codex run as a background waiter, goes into ~/.claude/bin as well,
# and so do bin/review-scan and its engine bin/agent-watch. review-scan loads
# both its engine and wait-pr-ready from beside itself.

set -euo pipefail
shopt -s nullglob

cloud=false
case "${1:-}" in
  "") ;;
  --cloud) cloud=true ;;
  *) echo "usage: bin/setup [--cloud]" >&2; exit 2 ;;
esac

command -v rsync >/dev/null 2>&1 || {
  echo "rsync is required but was not found in PATH." >&2
  exit 1
}

# Resolve this repo's root (the parent of bin/), following symlinks to the script.
source="${BASH_SOURCE[0]}"
while [ -L "$source" ]; do
  dir="$(cd -P "$(dirname "$source")" && pwd)"
  source="$(readlink "$source")"
  [[ $source != /* ]] && source="$dir/$source"
done
repo_root="$(cd -P "$(dirname "$source")/.." && pwd)"

# One skills directory per agent runtime.
targets=(
  "$HOME/.claude/skills"
  "$HOME/.codex/skills"
  "$HOME/.zcode/skills"
  "$HOME/.opencode/skills"
)

# Collect skill directories (those holding a SKILL.md).
skills=()
for skill_md in "$repo_root"/*/SKILL.md; do
  skills+=("$(dirname "$skill_md")")
done

if [ ${#skills[@]} -eq 0 ]; then
  echo "No skills found in $repo_root (expected <skill>/SKILL.md)." >&2
  exit 1
fi

sync_skill() {
  local src="$1" dest="$2"
  # Replace a pre-existing symlink (or stray non-directory) with a real copy.
  if [ -L "$dest" ] || { [ -e "$dest" ] && [ ! -d "$dest" ]; }; then
    rm -f "$dest"
  fi
  rsync -a --delete --exclude='.DS_Store' "$src/" "$dest/"
  echo "  synced    $(basename "$dest")"
}

for target in "${targets[@]}"; do
  mkdir -p "$target"
  echo "$target"
  for skill in "${skills[@]}"; do
    sync_skill "$skill" "$target/$(basename "$skill")"
  done
  # Skills link shared procedures as ../references/<file>; a sibling copy keeps
  # those links resolving in the installed layout. No SKILL.md, so no runtime
  # loads it as a skill.
  sync_skill "$repo_root/references" "$target/references"
done

echo
echo "Synced ${#skills[@]} skill(s) into ${#targets[@]} runtime(s)."

# A copy rather than a link: the cloud's setup script deletes this checkout.
memory="$HOME/.claude/bin/claude-memory"
mkdir -p "$(dirname "$memory")"
install -m 0755 "$repo_root/bin/claude-memory" "$memory"
install -m 0755 "$repo_root/bin/wait-pr-ready" "$(dirname "$memory")/wait-pr-ready"
install -m 0755 "$repo_root/bin/agent-watch" "$(dirname "$memory")/agent-watch"
install -m 0755 "$repo_root/bin/review-scan" "$(dirname "$memory")/review-scan"
if $cloud; then
  "$memory" hooks --cloud
  echo "Registered the memory pull hook."
elif [ "$(uname -s)" = Darwin ]; then
  "$memory" hooks --mac
  echo "Registered the memory push hook."
fi
