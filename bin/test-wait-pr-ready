    def test_a_failed_check_wakes_with_16_unless_the_last_round_saw_it(self):
        red = ready_pr(reviews={"totalCount": 0, "nodes": []})
        red["commits"]["nodes"][0]["commit"]["statusCheckRollup"] = {"contexts": {"nodes": [check("test", conclusion="FAILURE")]}}
        code, out, waits = self.run_main([red])
        self.assertEqual(code, 16, out)
        self.assertTrue(out.startswith("ci failed:"))
        self.assertEqual(waits, [])
        code, _, _ = self.run_main([red] * 60, args=["--after", "2026-10-15T10:00:00Z"])
        self.assertEqual(code, 13)

    def test_a_cancelled_check_is_no_ci_failure(self):
        cancelled = ready_pr()
        cancelled["commits"]["nodes"][0]["commit"]["statusCheckRollup"] = {"contexts": {"nodes": [check("test", conclusion="CANCELLED")]}}
        code, _, _ = self.run_main([cancelled, ready_pr()])
        self.assertEqual(code, 0)

    def test_no_ci_never_reports_a_ci_failure(self):
        red = ready_pr(reviews={"totalCount": 0, "nodes": []})
        red["commits"]["nodes"][0]["commit"]["statusCheckRollup"] = {"contexts": {"nodes": [check("test", conclusion="FAILURE")]}}
        self.assertEqual(self.run_main([red] * 60, args=["--no-ci"])[0], 13)

    def test_a_gitlab_mr_runs_through_the_same_gates(self):
        reads = iter([gl_pr(pipeline="running"), gl_pr()])
        original = w.gl_read_mr
        w.gl_read_mr = lambda *_: next(reads)
        try:
            with contextlib.redirect_stdout(io.StringIO()) as out, contextlib.redirect_stderr(io.StringIO()):
                code = w.main([GL_URL, "--reviewer", "review-bot"], now=lambda: w.ts("2026-10-15T10:00:00Z"), sleep=lambda s: None)
        finally:
            w.gl_read_mr = original
        self.assertEqual(code, 0, out.getvalue())
        self.assertIn("approved by review-bot", out.getvalue())

    def test_other_urls_are_unsupported(self):
        with contextlib.redirect_stderr(io.StringIO()):
            self.assertEqual(w.main(["https://bitbucket.org/acme/app/pull-requests/7"]), 2)
        self.assertEqual(w.parse_gitlab_url("https://gitlab.example.com/grp/sub/app/-/merge_requests/7"),
                         ("gitlab.example.com", "grp/sub/app", 7))
        self.assertIsNone(w.parse_gitlab_url(URL))


if __name__ == "__main__":
    unittest.main(verbosity=1)
