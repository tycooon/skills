            reviews={"totalCount": 1, "nodes": [review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {HEAD}.")]},
            comments={"totalCount": 1, "nodes": [comment("alice", "Please hold this until the migration lands.")]},
        )
        for pr in (waiting, landed):
            pr["commits"]["nodes"][0]["commit"]["statusCheckRollup"] = pending
