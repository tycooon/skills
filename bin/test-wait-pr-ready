#!/usr/bin/env python3
"""Tests for bin/wait-pr-ready. Run: bin/test-wait-pr-ready"""

import contextlib
import copy
import importlib.machinery
import importlib.util
import io
import json
import subprocess
import sys
import unittest
from pathlib import Path

sys.dont_write_bytecode = True  # loading bin/wait-pr-ready as a module would litter bin/
SCRIPT = Path(__file__).resolve().parent / "wait-pr-ready"
URL = "https://github.com/acme/app/pull/7"
HEAD = "a" * 40
OLD = "b" * 40


def load_module():
    loader = importlib.machinery.SourceFileLoader("wait_pr_ready", str(SCRIPT))
    spec = importlib.util.spec_from_loader("wait_pr_ready", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


w = load_module()


def review(login, state, body, sha=HEAD, at="2026-10-15T10:00:00Z"):
    return {"author": {"login": login}, "state": state, "body": body, "submittedAt": at, "commit": {"oid": sha}}


def comment(login, body, at="2026-10-15T10:00:00Z"):
    return {"author": {"login": login}, "body": body, "createdAt": at}


def check(name, status="COMPLETED", conclusion="SUCCESS"):
    return {"__typename": "CheckRun", "name": name, "status": status, "conclusion": conclusion, "completedAt": "2026-10-15T09:30:00Z"}


def ready_pr(**overrides):
    pr = {
        "state": "OPEN",
        "headRefOid": HEAD,
        "baseRefName": "master",
        "updatedAt": "2026-10-15T10:00:00Z",
        "mergeable": "MERGEABLE",
        "mergeStateStatus": "CLEAN",
        "reviewThreads": {"totalCount": 1, "nodes": [{"isResolved": True}]},
        "reviews": {"totalCount": 1, "nodes": [review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {HEAD}.")]},
        "comments": {"totalCount": 0, "nodes": []},
        "commits": {"nodes": [{"commit": {"oid": HEAD, "committedDate": "2026-10-15T09:00:00Z", "statusCheckRollup": {"contexts": {"nodes": [check("test")]}}}}]},
    }
    pr.update(overrides)
    return pr


def finding_thread(review_id, path, state="APPROVED", answered=True, opener="review-bot", line=40):
    """A thread a review opened on `line`; answered means the author replied after it."""
    last = "author" if answered else opener
    return {
        "isResolved": False,
        "path": path,
        "originalLine": line,
        "comments": {"nodes": [{"author": {"login": opener}, "pullRequestReview": {"id": review_id, "state": state}}]},
        "replies": {"totalCount": 2 if answered else 1, "nodes": [{"author": {"login": last}}]},
    }


def evaluate(pr, no_ci=False, reviewers=(), same=lambda old, new, at: False):
    return w.evaluate(pr, no_ci=no_ci, reviewers=set(reviewers), same_authored_lines=same)


GL_URL = "https://gitlab.example.com/grp/app/-/merge_requests/7"


def gl_note(nid, user, body, at="2026-10-15T10:00:00Z", system=False, resolvable=False, resolved=False):
    return {"id": nid, "author": {"username": user}, "body": body, "created_at": at, "system": system,
            "resolvable": resolvable, "resolved": resolved}


def gl_pr(pipeline="success", merge="mergeable", discussions=None, sha=HEAD, pipeline_sha=None, ref="feature"):
    mr = {"state": "opened", "iid": 7, "sha": sha, "target_branch": "master", "updated_at": "2026-10-15T10:00:00Z",
          "detailed_merge_status": merge, "has_conflicts": merge == "conflict",
          "head_pipeline": {"id": 1, "sha": pipeline_sha or sha, "ref": ref, "status": pipeline, "finished_at": "2026-10-15T09:30:00Z"}}
    if discussions is None:
        discussions = [{"notes": [gl_note(1, "review-bot", f"**APPROVED** at {HEAD} — AI reviewer: Claude")]}]
    return w.gl_mr_to_pr(mr, discussions, {"committed_date": "2026-10-15T09:00:00Z"})


class GitLab(unittest.TestCase):
    def test_a_verdict_note_and_green_pipeline_are_ready(self):
        ready, reasons = evaluate(gl_pr(), reviewers=["review-bot"])
        self.assertTrue(ready, reasons)

    def test_a_system_approval_counts_for_a_listed_reviewer(self):
        pr = gl_pr(discussions=[{"notes": [gl_note(1, "review-bot", "approved this merge request", system=True)]}])
        self.assertEqual(pr["reviews"]["nodes"][0]["state"], "APPROVED")
        self.assertTrue(evaluate(pr, reviewers=["review-bot"])[0])

    def test_pipeline_statuses(self):
        self.assertFalse(evaluate(gl_pr(pipeline="running"), reviewers=["review-bot"])[0])
        self.assertTrue(w.hard_failures(gl_pr(pipeline="failed"), []))
        self.assertFalse(w.hard_failures(gl_pr(pipeline="canceled"), []))
        self.assertTrue(evaluate(gl_pr(pipeline="manual"), reviewers=["review-bot"])[0])

    def test_merge_statuses(self):
        self.assertEqual(gl_pr(merge="conflict")["mergeable"], "CONFLICTING")
        self.assertEqual(gl_pr(merge="need_rebase")["mergeStateStatus"], "BEHIND")
        self.assertEqual(gl_pr(merge="checking")["mergeable"], "UNKNOWN")
        self.assertTrue(evaluate(gl_pr(merge="not_approved"), reviewers=["review-bot"])[0])
        self.assertFalse(evaluate(gl_pr(merge="draft_status"), reviewers=["review-bot"])[0])

    def test_discussions_become_threads_without_system_notes(self):
        approved = {"notes": [gl_note(1, "review-bot", f"**APPROVED** at {HEAD} — AI reviewer: Claude")]}
        open_finding = {"notes": [gl_note(2, "review-bot", "P1: broken", resolvable=True),
                                  gl_note(3, "dev", "changed this line in version 2 of the diff", system=True, resolvable=False)]}
        pr = gl_pr(discussions=[approved, open_finding])
        self.assertEqual(pr["reviewThreads"]["totalCount"], 1)
        self.assertEqual(pr["reviewThreads"]["nodes"][0]["replies"]["nodes"][0]["author"]["login"], "review-bot")
        self.assertFalse(evaluate(pr, reviewers=["review-bot"])[0])

    def test_an_answered_non_blocking_finding_does_not_hold_the_mr(self):
        approved = {"notes": [gl_note(1, "review-bot", f"**APPROVED** at {HEAD} — AI reviewer: Claude")]}
        nit = {"notes": [gl_note(2, "review-bot", "P3 (non-blocking): rename", resolvable=True),
                         gl_note(3, "dev", "Done", resolvable=True)]}
        self.assertTrue(evaluate(gl_pr(discussions=[approved, nit]), reviewers=["review-bot"])[0])

    def test_a_merged_results_pipeline_tests_the_head(self):
        merged = gl_pr(pipeline="failed", pipeline_sha="c" * 40, ref="refs/merge-requests/7/merge")
        self.assertTrue(w.has_checks(merged))
        self.assertTrue(w.hard_failures(merged, []))
        other_branch = gl_pr(pipeline="failed", pipeline_sha="c" * 40, ref="refs/merge-requests/8/merge")
        self.assertFalse(w.has_checks(other_branch))

    def test_a_blocking_manual_job_holds_the_mr_where_the_pipeline_gates_it(self):
        self.assertFalse(evaluate(gl_pr(pipeline="manual", merge="ci_still_running"), reviewers=["review-bot"])[0])
        self.assertFalse(evaluate(gl_pr(pipeline="manual", merge="ci_must_pass"), reviewers=["review-bot"])[0])
        self.assertFalse(w.hard_failures(gl_pr(pipeline="manual", merge="ci_must_pass"), []))

    def test_a_reply_in_a_discussion_counts_as_review_activity(self):
        opened = {"notes": [gl_note(2, "review-bot", "P1: broken", resolvable=True), gl_note(3, "dev", "It is fine", resolvable=True)]}
        held = {"notes": opened["notes"] + [gl_note(4, "review-bot", "Still broken", resolvable=True)]}
        self.assertGreater(w.review_count(gl_pr(discussions=[held])), w.review_count(gl_pr(discussions=[opened])))

    def test_an_approval_with_non_blocking_findings_covers_the_fix_on_those_lines(self):
        verdict = {"notes": [gl_note(1, "review-bot", f"**APPROVED** at {OLD} — AI reviewer: Claude", at="2026-10-15T10:00:00Z")]}
        nit = gl_note(2, "review-bot", "P3 (non-blocking): rename", at="2026-10-15T09:59:00Z", resolvable=True)
        nit["position"] = {"new_path": "src/a.rs", "new_line": 40, "head_sha": OLD}
        pr = gl_pr(discussions=[{"notes": [nit, gl_note(3, "dev", "Done", resolvable=True)]}, verdict])
        self.assertEqual(pr["reviewThreads"]["nodes"][0]["comments"]["nodes"][0]["pullRequestReview"]["id"], "verdict-1")
        def run(hunks):
            return w.evaluate(pr, no_ci=False, reviewers={"review-bot"}, same_authored_lines=lambda *_: False,
                              hunks_between=lambda old, new: hunks)
        ready, reasons = run({"src/a.rs": [(41, 41, 1)]})
        self.assertTrue(ready, reasons)
        self.assertIn("later commits change only its findings' lines", reasons[0])
        self.assertFalse(run({"src/a.rs": [(200, 200, 1)]})[0])
        # Re-anchored to a later head, the note's lines are in that head's numbering: no carry.
        nit["position"]["head_sha"] = HEAD
        moved = gl_pr(discussions=[{"notes": [nit, gl_note(3, "dev", "Done", resolvable=True)]}, verdict])
        self.assertIsNone(moved["reviewThreads"]["nodes"][0]["comments"]["nodes"][0]["pullRequestReview"]["id"])

    def test_a_pipeline_for_another_sha_is_no_check(self):
        pr = gl_pr()
        mr_sha_other = w.gl_mr_to_pr({"state": "opened", "sha": HEAD, "target_branch": "master", "updated_at": "2026-10-15T10:00:00Z",
                                      "detailed_merge_status": "mergeable", "head_pipeline": {"id": 1, "sha": OLD, "status": "success"}},
                                     [], {"committed_date": "2026-10-15T09:00:00Z"})
        self.assertTrue(w.has_checks(pr))
        self.assertFalse(w.has_checks(mr_sha_other))


class Approval(unittest.TestCase):
    def test_formal_approval_naming_the_head(self):
        ready, reasons = evaluate(ready_pr())
        self.assertTrue(ready, reasons)

    def test_teammate_approve_does_not_count(self):
        pr = ready_pr(reviews={"nodes": [review("alice", "APPROVED", "")]})
        self.assertFalse(evaluate(pr)[0])

    def test_listed_reviewer_counts_without_identity(self):
        pr = ready_pr(reviews={"nodes": [review("alice", "APPROVED", "")]})
        self.assertTrue(evaluate(pr, reviewers=["alice"])[0])

    def test_listed_reviewers_are_the_only_verdict_source(self):
        # A session reviewer posting from the author's account carries the identity line too.
        session = review("author", "COMMENTED", f"APPROVED. AI reviewer: Claude (session reviewer). Reviewed {HEAD}.")
        pr = ready_pr(reviews={"nodes": [session]})
        self.assertFalse(evaluate(pr, reviewers=["review-bot"])[0])
        self.assertTrue(evaluate(pr)[0], "without --reviewer the identity line still counts")
        both = ready_pr(reviews={"nodes": [session, review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {HEAD}.")]})
        self.assertTrue(evaluate(both, reviewers=["review-bot"])[0])

    def test_newer_findings_review_replaces_the_approval(self):
        pr = ready_pr(reviews={"nodes": [
            review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {OLD}.", sha=OLD, at="2026-10-15T08:00:00Z"),
            review("review-bot", "COMMENTED", "AI reviewer: Claude.", at="2026-10-15T10:00:00Z"),
        ]})
        self.assertFalse(evaluate(pr, same=lambda o, n, at: True)[0])

    def test_bodiless_thread_reply_is_not_a_verdict(self):
        pr = ready_pr()
        pr["reviews"]["nodes"].append(review("review-bot", "COMMENTED", "", at="2026-10-15T11:00:00Z"))
        self.assertTrue(evaluate(pr)[0])

    def test_approval_on_older_head_needs_base_sync(self):
        pr = ready_pr(reviews={"nodes": [review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {OLD}.", sha=OLD)]})
        self.assertFalse(evaluate(pr, same=lambda o, n, at: False)[0])
        ready, reasons = evaluate(pr, same=lambda o, n, at: (o, n) == (OLD, HEAD))
        self.assertTrue(ready)
        self.assertIn("base-sync", reasons[0])

    def test_go_signal_comment(self):
        pr = ready_pr(reviews={"nodes": []}, comments={"nodes": [comment("tycooon", f"APPROVED. AI reviewer: Codex. Reviewed {HEAD}.")]})
        self.assertTrue(evaluate(pr)[0])

    def test_negated_go_signal_is_not_approval(self):
        pr = ready_pr(reviews={"nodes": []}, comments={"nodes": [comment("tycooon", "AI reviewer: Codex. Not approving until the test is fixed.")]})
        self.assertFalse(evaluate(pr)[0])

    def test_person_naming_an_agent_is_not_a_verdict(self):
        pr = ready_pr(reviews={"nodes": []}, comments={"nodes": [comment("tycooon", "Claude's findings are addressed, Codex approved the earlier design", at="2026-10-15T09:10:00Z")]})
        self.assertFalse(evaluate(pr)[0])

    def test_shaless_comment_must_follow_the_head_commit(self):
        late = ready_pr(reviews={"nodes": []}, comments={"nodes": [comment("tycooon", "LGTM — AI reviewer: Codex", at="2026-10-15T09:10:00Z")]})
        early = ready_pr(reviews={"nodes": []}, comments={"nodes": [comment("tycooon", "LGTM — AI reviewer: Codex", at="2026-10-15T08:50:00Z")]})
        self.assertTrue(evaluate(late)[0])
        self.assertFalse(evaluate(early)[0])


def retarget(at="2026-10-15T10:30:00Z", previous="feature"):
    return {"nodes": [{"createdAt": at, "previousRefName": previous}]}


class BaseAt(unittest.TestCase):
    def test_no_retarget_reads_the_current_base(self):
        self.assertEqual(w.base_at(ready_pr(), "2026-10-15T10:00:00Z"), "master")

    def test_verdict_before_a_retarget_reads_the_base_it_was_posted_under(self):
        pr = ready_pr(timelineItems=retarget())
        self.assertEqual(w.base_at(pr, "2026-10-15T10:00:00Z"), "feature")
        self.assertEqual(w.base_at(pr, "2026-10-15T11:00:00Z"), "master")

    def test_the_first_retarget_after_the_verdict_wins(self):
        pr = ready_pr(timelineItems={"nodes": [
            {"createdAt": "2026-10-15T09:00:00Z", "previousRefName": "older"},
            {"createdAt": "2026-10-15T12:00:00Z", "previousRefName": "middle"},
            {"createdAt": "2026-10-15T11:00:00Z", "previousRefName": "feature"},
        ]})
        self.assertEqual(w.base_at(pr, "2026-10-15T10:00:00Z"), "feature")

    def test_githubs_automatic_retarget_counts(self):
        pr = ready_pr(timelineItems={"nodes": [{"createdAt": "2026-10-15T10:30:00Z", "oldBase": "feature"}]})
        self.assertEqual(w.base_at(pr, "2026-10-15T10:00:00Z"), "feature")


class OtherGates(unittest.TestCase):
    def test_pending_failed_or_missing_checks_block(self):
        for contexts in ([check("test", status="IN_PROGRESS", conclusion=None)], [check("test", conclusion="FAILURE")], []):
            pr = ready_pr()
            pr["commits"]["nodes"][0]["commit"]["statusCheckRollup"] = {"contexts": {"nodes": contexts}}
            self.assertFalse(evaluate(pr)[0], contexts)

    def test_no_ci_skips_the_checks_gate(self):
        pr = ready_pr()
        pr["commits"]["nodes"][0]["commit"]["statusCheckRollup"] = None
        self.assertFalse(evaluate(pr)[0])
        self.assertTrue(evaluate(pr, no_ci=True)[0])

    def test_status_context(self):
        pr = ready_pr()
        pr["commits"]["nodes"][0]["commit"]["statusCheckRollup"] = {"contexts": {"nodes": [{"__typename": "StatusContext", "context": "ci", "state": "PENDING", "createdAt": None}]}}
        self.assertFalse(evaluate(pr)[0])

    def test_unresolved_thread_blocks(self):
        self.assertFalse(evaluate(ready_pr(reviewThreads={"nodes": [{"isResolved": False}]}))[0])

    def test_merge_blocks(self):
        for mergeable, status in (("CONFLICTING", "DIRTY"), ("MERGEABLE", "BEHIND"), ("MERGEABLE", "BLOCKED"), ("MERGEABLE", "DRAFT"), ("UNKNOWN", "UNKNOWN")):
            self.assertFalse(evaluate(ready_pr(mergeable=mergeable, mergeStateStatus=status))[0], status)


class Loop(unittest.TestCase):
    def run_main(self, reads, args=(), clock_step=0, workflows=1, runs=1, head=()):
        """Feeds main() one PR per read; each sleep advances the fake clock by its wait plus clock_step.
        workflows and runs are what the Actions API reports for the repository and the head;
        head yields head_runs' (active, failed, oldest) per call, by default an hour-old green run."""
        reads = iter(reads)
        clock = [w.ts("2026-10-15T10:00:00Z")]
        waits = []

        def read_pr(*_):
            pr = next(reads)
            if isinstance(pr, Exception):
                raise pr
            return copy.deepcopy(pr)

        def sleep(seconds):
            waits.append(seconds)
            clock[0] += seconds + clock_step

        head = iter(head)
        originals = w.read_pr, w.workflow_count, w.workflow_runs, w.head_runs
        w.read_pr = read_pr
        w.workflow_count = lambda *_: workflows
        w.workflow_runs = lambda *_: runs
        w.head_runs = lambda *_: next(head, ([], [], w.ts("2026-10-15T09:00:00Z")))
        out = io.StringIO()
        try:
            with contextlib.redirect_stdout(out), contextlib.redirect_stderr(io.StringIO()):
                code = w.main([URL, *args], now=lambda: clock[0], sleep=sleep)
        finally:
            w.read_pr, w.workflow_count, w.workflow_runs, w.head_runs = originals
        return code, out.getvalue(), waits

    def unchecked(self):
        return ready_pr(commits={"nodes": [{"commit": {"oid": HEAD, "committedDate": "2026-10-15T09:00:00Z", "statusCheckRollup": None}}]})

    def test_a_repository_without_workflows_needs_no_checks_once_none_came(self):
        code, out, waits = self.run_main([self.unchecked()] * 20, workflows=0, runs=0)
        self.assertEqual(code, 0)
        self.assertIn("no Actions workflow", out)
        self.assertGreaterEqual(sum(waits), w.CI_SETTLE)

    def test_an_external_check_that_arrives_late_is_waited_for(self):
        pending = self.unchecked()
        pending["commits"]["nodes"][0]["commit"]["statusCheckRollup"] = {"contexts": {"nodes": [check("ci", status="IN_PROGRESS", conclusion=None)]}}
        code, out, _ = self.run_main([self.unchecked(), pending, ready_pr()], workflows=0, runs=0)
        self.assertEqual(code, 0)
        self.assertNotIn("no Actions workflow", out)

    def test_a_head_no_workflow_ran_for_is_ready_once_ci_had_time_to_start(self):
        code, out, waits = self.run_main([self.unchecked()] * 20, runs=0)
        self.assertEqual(code, 0)
        self.assertIn("no workflow ran", out)
        self.assertGreaterEqual(sum(waits), w.CI_SETTLE)

    def test_a_head_whose_workflows_ran_still_waits_for_their_checks(self):
        code, out, _ = self.run_main([self.unchecked()] * 60, runs=2)
        self.assertEqual(code, 13)
        self.assertIn("no checks reported yet", out)

    def test_ready_on_first_read(self):
        code, out, waits = self.run_main([ready_pr()])
        self.assertEqual(code, 0)
        self.assertTrue(out.startswith("ready:"))
        self.assertEqual(waits, [])

    def test_a_rerun_still_running_is_not_ready(self):
        # A rerun leaves only the finished checks in the rollup, so it reads green.
        code, out, waits = self.run_main([ready_pr(), ready_pr()], head=[(["CI", "CI"], [], None)])
        self.assertEqual(code, 0)
        self.assertEqual(len(waits), 1)

    def test_a_cancelled_run_dropped_from_the_rollup_is_not_ready(self):
        # GitHub drops a cancelled run's checks, leaving one green pull_request check.
        code, out, waits = self.run_main([ready_pr(), ready_pr()], head=[([], ["CI=cancelled"], w.ts("2026-10-15T09:00:00Z"))])
        self.assertEqual(code, 0)
        self.assertEqual(len(waits), 1)

    def test_young_runs_wait_for_a_push_run_actions_creates_late(self):
        # A quick pull_request run finished green; the push CI run is not created yet.
        young = ([], [], w.ts("2026-10-15T09:58:00Z"))
        code, out, waits = self.run_main([ready_pr()] * 30, head=[young] * 30)
        self.assertEqual(code, 0)
        self.assertGreaterEqual(sum(waits), w.CI_SETTLE - 120)

    def test_head_runs_judges_each_workflow_by_its_newest_run(self):
        rows = "\n".join([
            "1\t7\tCI\tcompleted\tcancelled\t2026-10-15T09:00:00Z",
            "1\t8\tCI\tcompleted\tsuccess\t2026-10-15T09:05:00Z",
            "2\t3\tp2p\tcompleted\tfailure\t2026-10-15T09:01:00Z",
            "3\t4\tlint\tin_progress\t\t2026-10-15T09:02:00Z",
        ])
        original = w.gh
        w.gh = lambda *_: subprocess.CompletedProcess([], 0, rows, "")
        try:
            active, failed, oldest = w.head_runs("o", "r", "sha")
        finally:
            w.gh = original
        self.assertEqual(active, ["lint"])
        self.assertEqual(failed, ["p2p=failure"])
        self.assertEqual(oldest, w.ts("2026-10-15T09:00:00Z"))

    def test_an_approval_wakes_when_a_cancelled_run_hides_from_the_rollup(self):
        waiting = ready_pr(reviews={"totalCount": 0, "nodes": []})
        approved = ready_pr(reviews={"totalCount": 1, "nodes": [review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {HEAD}.")]})
        cancelled = ([], ["CI=cancelled"], w.ts("2026-10-15T09:00:00Z"))
        code, out, waits = self.run_main([waiting, approved], head=[cancelled] * 2)
        self.assertEqual(code, 14, out)
        self.assertIn("CI=cancelled", out)
        self.assertEqual(len(waits), 1)

    def test_no_ci_does_not_ask_for_runs(self):
        code, _, _ = self.run_main([ready_pr()], args=["--no-ci"], head=[(["CI"], [], None)])
        self.assertEqual(code, 0)

    def test_waits_with_backoff_until_ready(self):
        waiting = ready_pr(reviewThreads={"nodes": [{"isResolved": False}]})
        code, _, waits = self.run_main([waiting, waiting, waiting, ready_pr()])
        self.assertEqual(code, 0)
        self.assertEqual(waits, [60, 60, 120])

    def test_merged_and_closed(self):
        self.assertEqual(self.run_main([ready_pr(state="MERGED")])[0], 10)
        self.assertEqual(self.run_main([ready_pr(state="CLOSED")])[0], 11)

    def test_head_change(self):
        moved = ready_pr(headRefOid="c" * 40, reviewThreads={"nodes": [{"isResolved": False}]})
        waiting = ready_pr(reviewThreads={"nodes": [{"isResolved": False}]})
        self.assertEqual(self.run_main([waiting, moved])[0], 12)

    def test_expected_head_settles_before_counting_as_change(self):
        stale = ready_pr(headRefOid=OLD)
        code, out, _ = self.run_main([stale, ready_pr()], args=["--head", HEAD])
        self.assertEqual(code, 0, out)
        code, _, _ = self.run_main([stale] * 10, args=["--head", HEAD])
        self.assertEqual(code, 12)

    def test_quiet_limit(self):
        waiting = ready_pr(reviewThreads={"nodes": [{"isResolved": False}]})
        code, out, waits = self.run_main([waiting] * 60)
        self.assertEqual(code, 13)
        self.assertTrue(out.startswith("quiet:"))
        self.assertGreaterEqual(sum(waits), w.QUIET_LIMIT)

    def test_activity_resets_backoff(self):
        waiting = ready_pr(reviewThreads={"nodes": [{"isResolved": False}]})
        later = ready_pr(reviewThreads={"nodes": [{"isResolved": False}]}, updatedAt="2026-10-15T10:20:00Z")
        _, _, waits = self.run_main([waiting, waiting, waiting, later, ready_pr()])
        self.assertEqual(waits, [60, 60, 120, 60])

    def test_transient_read_failures_retry_then_give_up(self):
        code, _, _ = self.run_main([RuntimeError("timeout"), ready_pr()])
        self.assertEqual(code, 0)
        code, out, waits = self.run_main([RuntimeError("bad credentials")] * w.MAX_FAILED_READS)
        self.assertEqual(code, 2)
        self.assertTrue(out.startswith("error:"))
        self.assertGreaterEqual(sum(waits), 15 * 60)

    def test_failure_while_evaluating_is_retried(self):
        original = w.authored_lines
        calls = []

        def slow(*_):
            calls.append(1)
            if len(calls) == 1:
                raise w.subprocess.TimeoutExpired("gh", 120)
            return ["x +line"]

        w.authored_lines = slow
        try:
            pr = ready_pr(reviews={"nodes": [review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {OLD}.", sha=OLD)]})
            code, out, waits = self.run_main([pr, pr])
        finally:
            w.authored_lines = original
        self.assertEqual(code, 0, out)
        self.assertEqual(waits, [w.RETRY_WAIT])

    def test_approval_survives_a_retarget_after_the_base_pr_merged(self):
        # Against the new base the old head also carries the merged base PR.
        lines = {("feature", OLD): ["x +mine"], ("master", OLD): ["x +base pr", "x +mine"], ("master", HEAD): ["x +mine"]}
        original = w.authored_lines
        w.authored_lines = lambda owner, name, base, sha: lines.get((base, sha))
        try:
            approved_old = {"nodes": [review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {OLD}.", sha=OLD)]}
            code, out, _ = self.run_main([ready_pr(reviews=approved_old, timelineItems=retarget())])
            self.assertEqual(code, 0, out)
            self.assertIn("base-sync", out)
            # Without the retarget the old head's lines differ, and the wait runs into the quiet cap.
            code, out, _ = self.run_main([ready_pr(reviews=approved_old)] * 60)
            self.assertEqual(code, 13, out)
        finally:
            w.authored_lines = original

    def test_a_deleted_base_branch_reads_against_its_merged_pr_head(self):
        tip = "d" * 40
        lines = {(tip, OLD): ["x +mine"], ("master", HEAD): ["x +mine"]}
        originals = w.authored_lines, w.merged_branch_tip
        w.authored_lines = lambda owner, name, base, sha: lines.get((base, sha))
        w.merged_branch_tip = lambda owner, name, branch: tip if branch == "feature" else None
        try:
            approved_old = {"nodes": [review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {OLD}.", sha=OLD)]}
            retargeted = {"nodes": [{"createdAt": "2026-10-15T10:30:00Z", "oldBase": "feature"}]}
            code, out, _ = self.run_main([ready_pr(reviews=approved_old, timelineItems=retargeted)])
            self.assertEqual(code, 0, out)
        finally:
            w.authored_lines, w.merged_branch_tip = originals

    def test_after_needs_newer_activity(self):
        code, out, _ = self.run_main([ready_pr()])
        mark = out.rsplit("activity ", 1)[1].strip()
        self.assertEqual(mark, "2026-10-15T10:00:00Z")
        newer = ready_pr(updatedAt="2026-10-15T10:30:00Z")
        code, _, waits = self.run_main([ready_pr(), ready_pr(), newer], args=["--after", mark])
        self.assertEqual(code, 0)
        self.assertEqual(len(waits), 2)

    def test_until_review_exits_on_new_review_activity(self):
        pr = ready_pr()
        more = ready_pr(reviewThreads={"totalCount": 2, "nodes": [{"isResolved": True}, {"isResolved": False}]})
        code, out, waits = self.run_main([pr, pr, more], args=["--until-review"])
        self.assertEqual(code, 14, out)
        self.assertEqual(len(waits), 2)

    def test_until_review_after_catches_a_verdict_before_the_first_read(self):
        approved = ready_pr(reviews={"totalCount": 2, "nodes": [review("review-bot", "APPROVED", "AI reviewer: Claude.", at="2026-10-15T10:05:00Z")]})
        code, _, waits = self.run_main([approved], args=["--until-review", "--after", "2026-10-15T10:01:00Z"])
        self.assertEqual(code, 14)
        self.assertEqual(waits, [])
        moved = copy.deepcopy(approved)
        moved["headRefOid"] = "c" * 40
        code, _, waits = self.run_main([approved, approved, moved], args=["--until-review", "--after", "2026-10-15T10:06:00Z"])
        self.assertEqual(code, 12)
        self.assertEqual(len(waits), 2)

    def test_until_review_exits_on_a_listed_verdict_already_on_the_head(self):
        # The verdict landed before the waiter was armed, and --after was taken at arming time.
        approved = ready_pr(reviews={"totalCount": 1, "nodes": [review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {HEAD}.", at="2026-10-15T10:05:00Z")]})
        code, out, waits = self.run_main([approved], args=["--until-review", "--reviewer", "review-bot", "--after", "2026-10-15T10:06:00Z"])
        self.assertEqual(code, 14, out)
        self.assertIn("review-bot's verdict is already on", out)
        self.assertEqual(waits, [])

    def test_until_review_keeps_waiting_on_a_listed_verdict_for_an_older_head(self):
        old = "d" * 40
        stale = ready_pr(reviews={"totalCount": 1, "nodes": [review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {old}.", sha=old)]})
        newer = copy.deepcopy(stale)
        newer["reviews"]["totalCount"] = 2
        newer["reviews"]["nodes"].append(review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {HEAD}.", at="2026-10-15T10:20:00Z"))
        code, _, waits = self.run_main([stale, stale, newer], args=["--until-review", "--reviewer", "review-bot"])
        self.assertEqual(code, 14)
        self.assertEqual(len(waits), 2)

    def test_until_review_ignores_an_unlisted_verdict_already_on_the_head(self):
        handoff = review("author", "COMMENTED", f"APPROVED. AI reviewer: Claude (Codex handoff). Reviewed {HEAD}.", at="2026-10-15T10:05:00Z")
        pr = ready_pr(reviews={"totalCount": 1, "nodes": [handoff]})
        more = ready_pr(reviews={"totalCount": 2, "nodes": [handoff, review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {HEAD}.", at="2026-10-15T10:20:00Z")]})
        code, _, waits = self.run_main([pr, pr, more], args=["--until-review", "--reviewer", "review-bot", "--after", "2026-10-15T10:06:00Z"])
        self.assertEqual(code, 14)
        self.assertEqual(len(waits), 2)

    def test_until_review_still_exits_on_head_change(self):
        moved = ready_pr(headRefOid="c" * 40)
        self.assertEqual(self.run_main([ready_pr(), moved], args=["--until-review"])[0], 12)

    def test_conflict_on_the_watched_head_exits(self):
        waiting = ready_pr(reviewThreads={"nodes": [{"isResolved": False}]})
        conflict = ready_pr(mergeable="CONFLICTING", mergeStateStatus="DIRTY")
        code, out, waits = self.run_main([waiting, conflict])
        self.assertEqual(code, 15, out)
        self.assertTrue(out.startswith("conflict:"))
        self.assertEqual(len(waits), 1)
        self.assertEqual(self.run_main([conflict], args=["--until-review"])[0], 15)

    def test_known_conflict_waits_for_the_head_to_move(self):
        conflict = ready_pr(mergeable="CONFLICTING", mergeStateStatus="DIRTY")
        moved = ready_pr(headRefOid="c" * 40)
        code, _, waits = self.run_main([conflict, conflict, moved], args=["--known-conflict"])
        self.assertEqual(code, 12)
        self.assertEqual(len(waits), 2)

    def test_findings_wake_a_readiness_wait(self):
        waiting = ready_pr(reviewThreads={"totalCount": 1, "nodes": [{"isResolved": True}]}, reviews={"totalCount": 0, "nodes": []})
        findings = ready_pr(
            reviewThreads={"totalCount": 2, "nodes": [{"isResolved": True}, {"isResolved": False}]},
            reviews={"totalCount": 1, "nodes": [review("review-bot", "COMMENTED", "AI reviewer: Claude.")]},
        )
        code, out, waits = self.run_main([waiting, waiting, findings])
        self.assertEqual(code, 14, out)
        self.assertIn("not ready", out)
        self.assertEqual(len(waits), 2)

    def test_an_approval_that_lands_is_ready_not_review_activity(self):
        waiting = ready_pr(reviews={"totalCount": 0, "nodes": []})
        code, out, _ = self.run_main([waiting, ready_pr(reviews={"totalCount": 1, "nodes": [review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {HEAD}.")]})])
        self.assertEqual(code, 0, out)

    def test_a_session_approval_neither_readies_nor_wakes_a_listed_reviewer_wait(self):
        waiting = ready_pr(reviews={"totalCount": 0, "nodes": []})
        session = ready_pr(reviews={"totalCount": 1, "nodes": [review("author", "COMMENTED", f"APPROVED. AI reviewer: Claude (session reviewer). Reviewed {HEAD}.")]})
        bot = ready_pr(reviews={"totalCount": 2, "nodes": [review("author", "COMMENTED", f"APPROVED. AI reviewer: Claude (session reviewer). Reviewed {HEAD}."), review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {HEAD}.")]})
        code, out, waits = self.run_main([waiting, session, session, bot], args=["--reviewer", "review-bot"])
        self.assertEqual(code, 0, out)
        self.assertIn("approved by review-bot", out)
        self.assertEqual(len(waits), 3)

    def test_an_approval_while_ci_runs_keeps_waiting(self):
        pending = {"contexts": {"nodes": [check("test", status="IN_PROGRESS", conclusion=None)]}}
        none = {"totalCount": 0, "nodes": []}
        approved = {"totalCount": 1, "nodes": [review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {HEAD}.")]}
        waiting, approved_pending = ready_pr(reviews=none), ready_pr(reviews=approved)
        for pr in (waiting, approved_pending):
            pr["commits"]["nodes"][0]["commit"]["statusCheckRollup"] = pending
        code, out, waits = self.run_main([waiting, approved_pending, approved_pending, ready_pr(reviews=approved)])
        self.assertEqual(code, 0, out)
        self.assertEqual(len(waits), 3)

    def test_an_approved_head_waiting_only_on_checks_polls_every_minute(self):
        pending = {"contexts": {"nodes": [check("test", status="IN_PROGRESS", conclusion=None)]}}
        approved_pending = ready_pr()
        approved_pending["commits"]["nodes"][0]["commit"]["statusCheckRollup"] = pending
        code, out, waits = self.run_main([approved_pending] * 6 + [ready_pr()])
        self.assertEqual(code, 0, out)
        self.assertEqual(waits, [w.CHECKS_ONLY_WAIT] * 6)

    def test_an_unapproved_head_backs_off_as_before(self):
        pending = {"contexts": {"nodes": [check("test", status="IN_PROGRESS", conclusion=None)]}}
        unapproved = ready_pr(reviews={"totalCount": 0, "nodes": []})
        unapproved["commits"]["nodes"][0]["commit"]["statusCheckRollup"] = pending
        code, out, waits = self.run_main([unapproved] * 6 + [ready_pr()])
        self.assertEqual(waits[:6], w.BACKOFF + [w.BACKOFF[-1]])

    def test_an_approval_wakes_when_what_blocks_wont_clear_by_itself(self):
        none = {"totalCount": 0, "nodes": []}
        approved = {"totalCount": 1, "nodes": [review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {HEAD}.")]}
        stale = {"totalCount": 1, "nodes": [review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {OLD}.", sha=OLD)]}
        failed = {"contexts": {"nodes": [check("test", conclusion="FAILURE")]}}
        for name, overrides, rollup in (
            ("behind", {"mergeStateStatus": "BEHIND"}, None),
            ("blocked", {"mergeStateStatus": "BLOCKED"}, None),
            ("failed check", {}, failed),
            ("uncovered verdict", {"reviews": stale}, None),
        ):
            waiting = ready_pr(**{**overrides, "reviews": none})
            landed = ready_pr(**{"reviews": approved, **overrides})
            for pr in (waiting, landed):
                if rollup:
                    pr["commits"]["nodes"][0]["commit"]["statusCheckRollup"] = rollup
            original = w.authored_lines
            w.authored_lines = lambda *_: None
            try:
                # The red check was there before the wait began: the last round already handled it.
                code, out, _ = self.run_main([waiting, landed], args=["--after", "2026-10-15T10:00:00Z"])
            finally:
                w.authored_lines = original
            self.assertEqual(code, 14, f"{name}: {out}")

    def test_an_unlisted_formal_approval_wakes_a_listed_reviewer_wait(self):
        # The wrong --reviewer: the repo's bot approves formally, and the wait must not sit on it.
        waiting = ready_pr(reviews={"totalCount": 0, "nodes": []})
        bot = ready_pr(reviews={"totalCount": 1, "nodes": [review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {HEAD}.")]})
        code, out, _ = self.run_main([waiting, bot], args=["--reviewer", "someone-else"])
        self.assertEqual(code, 14, out)
        self.assertIn("review-bot approved it formally but is not a listed --reviewer", out)

    def test_an_unanswered_non_blocking_finding_holds_until_answered(self):
        approve = {**review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {HEAD}."), "id": "R1"}
        open_finding = finding_thread("R1", "src/a.rs", answered=False)
        held = ready_pr(reviews={"totalCount": 1, "nodes": [approve]}, reviewThreads={"totalCount": 1, "nodes": [open_finding]})
        ready, reasons = evaluate(held)
        self.assertFalse(ready)
        self.assertIn("1 unresolved threads", reasons)
        answered = ready_pr(reviews={"totalCount": 1, "nodes": [approve]}, reviewThreads={"totalCount": 1, "nodes": [finding_thread("R1", "src/a.rs")]})
        self.assertTrue(evaluate(answered)[0])

    def test_a_blocking_thread_still_holds_once_answered(self):
        findings = {**review("review-bot", "COMMENTED", "AI reviewer: Claude."), "id": "R1"}
        thread = finding_thread("R1", "src/a.rs", state="COMMENTED")
        self.assertFalse(evaluate(ready_pr(reviewThreads={"totalCount": 1, "nodes": [thread]}, reviews={"totalCount": 2, "nodes": [findings, review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {HEAD}.")]}))[0])

    def test_an_approval_with_findings_carries_only_to_a_fix_on_their_lines(self):
        approve = {**review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {OLD}.", sha=OLD), "id": "R1"}
        pr = ready_pr(reviews={"totalCount": 1, "nodes": [approve]}, reviewThreads={"totalCount": 1, "nodes": [finding_thread("R1", "src/a.rs", line=40)]})
        same = lambda *_: False

        def run(hunks):
            return w.evaluate(pr, no_ci=False, reviewers=set(), same_authored_lines=same, hunks_between=lambda o, n: hunks)

        ok = run({"src/a.rs": [(39, 41, 3)]})
        self.assertTrue(ok[0], ok[1])
        self.assertIn("change only its findings' lines", ok[1][0])
        self.assertTrue(run({"src/a.rs": [(45, 45, 0)]})[0], "within the slack")
        self.assertFalse(run({"src/a.rs": [(46, 46, 0)]})[0], "past the slack")
        self.assertFalse(run({"src/a.rs": [(37, 400, 0)]})[0], "starts at the finding and runs past it")
        self.assertFalse(run({"src/a.rs": [(1, 600, 0)]})[0], "the whole file")
        self.assertFalse(run({"src/a.rs": [(40, 40, 500)]})[0], "one line swapped for 500")
        self.assertFalse(run({"src/a.rs": [(41, 41, 500)]})[0], "500 lines inserted beside it")
        self.assertTrue(run({"src/a.rs": [(40, 40, 11)]})[0], "as many lines as the range holds")
        self.assertFalse(run({"src/a.rs": [(39, 41, 3), (300, 320, 0)]})[0], "same file, unrelated lines")
        self.assertFalse(run({"src/a.rs": [(40, 40, 1)], "src/b.rs": [(1, 2, 0)]})[0], "another file")
        self.assertFalse(run(None)[0], "an unreadable compare")
        self.assertFalse(run({})[0], "nothing changed is no fix")

    def test_a_finding_on_a_removed_line_carries_nothing(self):
        approve = {**review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {OLD}.", sha=OLD), "id": "R1"}
        left = {**finding_thread("R1", "src/a.rs", line=40), "diffSide": "LEFT"}
        pr = ready_pr(reviews={"totalCount": 1, "nodes": [approve]}, reviewThreads={"totalCount": 1, "nodes": [left]})
        self.assertFalse(w.evaluate(pr, no_ci=False, reviewers=set(), same_authored_lines=lambda *_: False, hunks_between=lambda o, n: {"src/a.rs": [(40, 40, 1)]})[0])

    def test_hunk_ranges_are_read_on_the_old_side(self):
        original = w.gh
        # Context lines don't count: only the changed runs, at their old-side lines.
        patch = "@@ -10,7 +10,7 @@ fn a()\n a\n b\n c\n-d\n+D\n e\n f\n g\n@@ -50,0 +51,2 @@\n+x\n+y\n@@ -80,3 +81,1 @@\n-p\n-q\n r"
        w.gh = lambda *_: subprocess.CompletedProcess([], 0, json.dumps([{"filename": "src/a.rs", "patch": patch}]), "")
        try:
            self.assertEqual(w.changed_hunks("o", "n", OLD, HEAD), {"src/a.rs": [(13, 13, 1), (50, 50, 2), (80, 81, 0)]})
            w.gh = lambda *_: subprocess.CompletedProcess([], 0, json.dumps([{"filename": "big.bin"}]), "")
            self.assertIsNone(w.changed_hunks("o", "n", OLD, HEAD))
        finally:
            w.gh = original

    def test_listed_reviewer_matches_case_and_bot_suffix(self):
        # GraphQL gives a GitHub App bot's login without the [bot] suffix REST and gh show.
        bot = ready_pr(reviews={"totalCount": 1, "nodes": [review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {HEAD}.")]})
        for listed in ("Review-Bot", "review-bot[bot]"):
            code, out, _ = self.run_main([bot], args=["--reviewer", listed])
            self.assertEqual(code, 0, f"{listed}: {out}")
            self.assertIn("approved by review-bot", out)

    def test_a_session_approval_wakes_when_what_blocks_wont_clear_by_itself(self):
        none = {"totalCount": 0, "nodes": []}
        session = {"totalCount": 1, "nodes": [review("author", "COMMENTED", f"APPROVED. AI reviewer: Claude (session reviewer). Reviewed {HEAD}.")]}
        failed = {"contexts": {"nodes": [check("test", conclusion="FAILURE")]}}
        for name, overrides, rollup in (
            ("behind", {"mergeStateStatus": "BEHIND"}, None),
            ("blocked", {"mergeStateStatus": "BLOCKED"}, None),
            ("failed check", {}, failed),
        ):
            waiting = ready_pr(**{**overrides, "reviews": none})
            landed = ready_pr(**{"reviews": session, **overrides})
            for pr in (waiting, landed):
                if rollup:
                    pr["commits"]["nodes"][0]["commit"]["statusCheckRollup"] = rollup
            code, out, _ = self.run_main([waiting, landed], args=["--reviewer", "review-bot", "--after", "2026-10-15T10:00:00Z"])
            self.assertEqual(code, 14, f"{name}: {out}")

    def test_an_approval_while_mergeability_is_computed_keeps_waiting(self):
