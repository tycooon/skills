    def test_a_comment_beside_the_approval_still_wakes(self):
        pending = {"contexts": {"nodes": [check("test", status="IN_PROGRESS", conclusion=None)]}}
        waiting = ready_pr(reviews={"totalCount": 0, "nodes": []})
