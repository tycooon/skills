#!/usr/bin/env python3
"""Drive a review-open-prs watch without a long-running agent session.

  review-scan init <watch> --target SPEC... [--filter SPEC=TEXT]... [--token SPEC=ENV_VAR]...
                   [--reviewer-model MODEL] [--effort LEVEL]
                   --own LOGIN... [--max-parallel N] [--dormant-days N]
  review-scan tick <watch> [--full] [--only PR_URL] [--dry-run]
  review-scan pause <watch>
  review-scan resume <watch>
  review-scan settle <watch> <pr-url> --head SHA --since TIME --verdict approved|findings|outside-filter
                     [--covered-by SHA] [--weighed THREAD]... [--recheck PR_URL]...
  review-scan nudge <pr-url> --head SHA
  review-scan list
  review-scan status [<watch>]
  review-scan account <watch> [CONFIG_DIR | default]
  review-scan model <watch> [MODEL] [--effort LEVEL]
  review-scan install <watch> [--interval SECONDS]
  review-scan uninstall <watch>

A tick lists every open PR of the watch's targets in one cheap call per target and
starts a fresh `claude -p` or `codex exec` run, on the watch's reviewer model, for each PR that changed
since a run last settled it: a new head, new activity, or a recheck someone asked for.
The model selects the CLI: Claude IDs and opus/sonnet/haiku aliases use Claude;
gpt-*, codex/codex-* and o-series IDs use Codex. Unknown model names are rejected.
A PR that has not changed costs nothing: no agent runs. The run follows review-open-prs'
*One run reviews one PR* and ends with `settle`, which records the PR's state only when
nothing but our own posts landed while the run was working, and only once the PR shows
the verdict the run claims: an approval of ours at the head, or an open thread of ours.

`pause` persists across configuration and schedule changes: every tick skips work, including manual and dry-run ticks, and nudges queue rechecks without starting a tick. Reviews already in flight can finish and settle. `resume` keeps the schedule unchanged and leaves scanning to the next tick; use `tick` for an immediate scan. An unscheduled watch stays unscheduled.

A watch never stops on its own. A single tick that cannot read any target is logged but not alerted; the second consecutive unreadable tick sends a desktop notification. A review run failing to start or nothing being left to watch alerts immediately. `status` shows the same problem until it clears.

Targets: GitHub `owner/repo`, `owner` (every repo of an org or user) or a PR URL;
GitLab `gitlab:HOST/group[/subgroup]`, `gitlab:HOST/group/project!` (a single project:
note the trailing `!`) or an MR URL. A PR named by URL is reviewed even as a draft or
dormant, and leaves the watch once merged or closed.

State lives in $REVIEW_SCAN_HOME (default ~/.local/state/review-open-prs)/<watch>/.

Exit codes: 0 success; 2 bad usage; 3 settle refused because the head moved;
4 settle refused because someone else commented after --since; 5 a target could not
be read or a run could not start (the tick still handled the others); 6 settle refused
because the PR does not show the claimed verdict.
"""

import argparse
import datetime as dt
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import urllib.parse
from pathlib import Path


def load_engine():
    sys.dont_write_bytecode = True
    path = str(Path(__file__).resolve().parent / "agent-watch")
    loader = importlib.machinery.SourceFileLoader("review_scan_engine", path)
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    module.HOME = Path(os.environ.get("REVIEW_SCAN_HOME", "~/.local/state/review-open-prs")).expanduser()
    module.TOOL = "review-scan"
    return module


engine = load_engine()


def __getattr__(name):
    return getattr(engine, name)


GH_PR = re.compile(r"^https://github\.com/([^/]+/[^/]+)/pull/(\d+)/?$")
GL_MR = re.compile(r"^https://([^/]+)/(.+?)/-/merge_requests/(\d+)/?$")
SEARCH = """query($q: String!, $after: String) {
  search(query: $q, type: ISSUE, first: 100, after: $after) {
    issueCount
    pageInfo { hasNextPage endCursor }
    nodes { ... on PullRequest { url number title isDraft headRefOid updatedAt state
      baseRefName headRefName author { login } repository { nameWithOwner } } }
  }
}"""
ACTIVITY = """query($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) { pullRequest(number: $number) {
    headRefOid state updatedAt author { login }
    comments(last: 100) { nodes { author { login } createdAt body } }
    reviews(last: 100) { nodes { author { login } submittedAt state body commit { oid } } }
    reviewThreads(last: 100) { nodes { isResolved
      first: comments(first: 1) { nodes { author { login } } }
      comments(last: 50) { nodes { author { login } createdAt body } } } }
  } }
}"""


# --- host access (replaced in tests) ------------------------------------------------


def gh_graphql(query, **variables):
    cmd = ["gh", "api", "graphql", "-f", f"query={query}"]
    for k, v in variables.items():
        if v is not None:
            cmd += ["-F" if isinstance(v, int) else "-f", f"{k}={v}"]
    return engine.run_json(cmd)["data"]


def gh_rest(path):
    return engine.run_json(["gh", "api", path])


def glab_api(host, path):
    return engine.run_json(["glab", "api", "--hostname", host, path])


def glab_paged(host, path):
    out, page = [], 1
    sep = "&" if "?" in path else "?"
    while True:
        rows = glab_api(host, f"{path}{sep}per_page=100&page={page}")
        out += rows
        if len(rows) < 100:
            return out
        page += 1


# --- listing -----------------------------------------------------------------------

def pr_row(url, head, updated, draft, title, base, branch, author, state="open", named=False):
    return {"url": url, "head": head, "updated": updated, "draft": bool(draft), "title": title,
            "base": base, "branch": branch, "author": author, "state": state, "named": named}


def list_target(spec):
    """Every open PR of one target, as pr_row dicts. Raises ScanError when unreadable."""
    m = GH_PR.match(spec)
    if m:
        pr = gh_rest(f"repos/{m[1]}/pulls/{m[2]}")
        state = "merged" if pr.get("merged_at") else pr["state"]
        return [pr_row(pr["html_url"], pr["head"]["sha"], pr["updated_at"], pr.get("draft"), pr["title"],
                       pr["base"]["ref"], pr["head"]["ref"], pr["user"]["login"], state, named=True)]
    m = GL_MR.match(spec)
    if m:
        mr = glab_api(m[1], f"projects/{urllib.parse.quote(m[2], safe='')}/merge_requests/{m[3]}")
        return [gl_row(mr, named=True)]
    if spec.startswith("gitlab:"):
        host, _, path = spec[len("gitlab:"):].partition("/")
        if path.endswith("!"):
            api = f"projects/{urllib.parse.quote(path[:-1], safe='')}/merge_requests?state=opened"
        else:
            api = f"groups/{urllib.parse.quote(path, safe='')}/merge_requests?state=opened&include_subgroups=true"
        return [gl_row(mr) for mr in glab_paged(host, api)]
    if "/" in spec:
        qualifier = f"repo:{spec}"
    else:  # search wants org: for an organisation and user: for a personal account
        qualifier = ("org:" if gh_rest(f"users/{spec}").get("type") == "Organization" else "user:") + spec
    rows, after = [], None
    while True:
        res = gh_graphql(SEARCH, q=f"is:pr is:open archived:false {qualifier}", after=after)["search"]
        rows += [pr_row(n["url"], n["headRefOid"], n["updatedAt"], n["isDraft"], n["title"], n["baseRefName"],
                        n["headRefName"], (n.get("author") or {}).get("login")) for n in res["nodes"] if n]
        if not res["pageInfo"]["hasNextPage"]:
            if len(rows) < res["issueCount"]:
                raise engine.ScanError(f"{spec}: search returned {len(rows)} of {res['issueCount']} open PRs")
            return rows
        after = res["pageInfo"]["endCursor"]


def gl_row(mr, named=False):
    return pr_row(mr["web_url"], mr["sha"], mr["updated_at"], mr.get("draft") or mr.get("work_in_progress"),
                  mr["title"], mr["target_branch"], mr["source_branch"], (mr.get("author") or {}).get("username"),
                  {"opened": "open"}.get(mr["state"], mr["state"]), named)


def login(author):
    return (author or {}).get("login")


def activity_since(url, since):
    """The PR as settle needs it: current head and last-activity time; `authors`, who posted
    a human comment, review or reply after `since`; `approved_at`, (who, sha) for each formal
    approval; `noted_at`, (who, sha) for each APPROVED verdict note; `author`, the PR's author;
    `threads`, who opened each thread still unresolved. `covered` decides which of them count."""
    m = GH_PR.match(url)
    if m:
        owner, name = m[1].split("/")
        pr = gh_graphql(ACTIVITY, owner=owner, name=name, number=int(m[2]))["repository"]["pullRequest"]
        head = pr["headRefOid"]
        posts = [(login(c["author"]), c["createdAt"], c.get("body") or "") for c in pr["comments"]["nodes"]]
        posts += [(login(r["author"]), r["submittedAt"], r.get("body") or "") for r in pr["reviews"]["nodes"]
                  if r.get("submittedAt")]
        posts += [(login(c["author"]), c["createdAt"], c.get("body") or "")
                  for t in pr["reviewThreads"]["nodes"] for c in t["comments"]["nodes"]]
        recent = [(who, body) for who, at, body in posts if engine.parse_time(at) > since]
        approved_at = {(login(r["author"]), (r.get("commit") or {}).get("oid")) for r in pr["reviews"]["nodes"]
                       if r.get("state") == "APPROVED"}
        noted_at = verdict_notes((login(c["author"]), c.get("body")) for c in pr["comments"]["nodes"])
        threads = [login(t["first"]["nodes"][0]["author"]) for t in pr["reviewThreads"]["nodes"]
                   if not t["isResolved"] and t["first"]["nodes"]]
        return {"head": head, "updated": pr["updatedAt"], "authors": {w for w, _ in recent},
                "approved_at": approved_at, "noted_at": noted_at,
                "author": login(pr.get("author")), "threads": set(threads)}
    m = GL_MR.match(url)
    if m:
        base = f"projects/{urllib.parse.quote(m[2], safe='')}/merge_requests/{m[3]}"
        mr = glab_api(m[1], base)
        notes = glab_api(m[1], f"{base}/notes?sort=desc&order_by=created_at&per_page=100")
        recent = [n for n in notes if not n.get("system") and engine.parse_time(n["created_at"]) > since]
        # Approvals carry no sha here and may be stale after a push: only verdict notes say which head.
        noted_at = verdict_notes((n["author"]["username"], n.get("body")) for n in notes
                                 if not n.get("system") and n.get("type") is None)
        threads = {d["notes"][0]["author"]["username"] for d in glab_paged(m[1], f"{base}/discussions")
                   if d["notes"] and d["notes"][0].get("resolvable") and not d["notes"][0].get("resolved")}
        return {"head": mr["sha"], "updated": mr["updated_at"], "authors": {n["author"]["username"] for n in recent},
                "approved_at": set(), "noted_at": noted_at, "author": None,
                "notes_approve": True, "threads": threads}
    raise engine.ScanError(f"not a PR or MR URL: {url}")


def verdict_notes(posts):
    """(author, sha) for each top-level verdict note: a post that starts with APPROVED, bold or
    not, and names the head it approves, as review-pr writes one. A mention elsewhere is not one."""
    return {(who, sha) for who, body in posts if (body or "").lstrip(" \t\r\n*_#>`").startswith("APPROVED")
            for sha in re.findall(r"\b[0-9a-f]{7,40}\b", body)}


# --- commands ----------------------------------------------------------------------

def per_target(a, option, what):
    """--OPTION SPEC=VALUE pairs as {spec: value}, each spec one of --target."""
    out = {}
    for f in getattr(a, option) or []:
        spec, sep, value = f.partition("=")
        if not sep:
            raise SystemExit(f"--{option} takes SPEC={what}, got {f!r}")
        out[spec] = value
    unknown = set(out) - set(a.target)
    if unknown:
        raise SystemExit(f"--{option} names a target not in --target: {', '.join(sorted(unknown))}")
    return out


def cmd_init(a):
    w = engine.Watch(a.watch)
    filters = per_target(a, "filter", "TEXT")
    tokens = per_target(a, "token", "ENV_VAR")
    config = engine.initialize_watch(w, a, {
        "targets": [{"spec": t, "filter": filters.get(t), "token": tokens.get(t)} for t in a.target],
        "own": a.own, "dormant_days": a.dormant_days})
    print(f"watch {a.watch}: {len(a.target)} target(s), reviewer {config['runner']} {config['reviewer_model']} at {a.effort} effort, state in {w.dir}")
    return 0


def owed_reason(rec, row, full):
    """Why a PR needs a run now, or None. Only "nothing changed since a run settled it" is quiet:
    whether a changed PR actually owes anything is the run's to decide."""
    if full:
        return "full pass"
    if "settled" not in rec:
        return "never reviewed by this watch"
    if rec.get("recheck"):
        return "recheck: " + "; ".join(rec["recheck"])
    s = rec["settled"]
    listed, settled = engine.parse_time(row["updated"]), engine.parse_time(s["updated"])
    if listed < settled:  # a listing older than the settle (search lags): nothing it says is news
        return None
    if s["head"] != row["head"]:
        return f"new head {row['head'][:12]} (settled at {s['head'][:12]})"
    if listed > settled:
        return f"activity at {row['updated']}"
    return None


def build_brief(w, r, rec, reason, siblings, now):
    cfg = w.config
    prev = rec.get("last_run")
    lines = [
        f"Review one pull request for the `{w.name}` review watch: {r['url']}",
        "",
        "Use the review-open-prs skill, section *One run reviews one PR*, and follow it exactly; it points at",
        "review-pr for how to review and post. This is a headless run: nobody reads your chat output,",
        "so the PR is the whole report.",
        "",
        f"- Why this run: {reason}.",
        f"- Head when the scan listed it: `{r['head']}`; base branch `{r['base']}`; author `{r['author']}`.",
        f"- Run start time, for `settle --since`: `{engine.iso(now)}`.",
        f"- Accounts that post as you: {', '.join(cfg['own'])}.",
    ]
    if w.runner == "codex":
        lines.append("- This run is in Codex's workspace-write sandbox: a fetch into a shared clone is refused; "
                     "rerun that fetch with escalated permissions so the automatic approval reviewer can approve it.")
    for former in cfg.get("former_agents", []):
        since = former.get("since", cfg["created"])
        lines.append(f"- For reviews between {since} and {former['until']}, this watch ran on {former['agent']}; "
                     f"posts from the accounts above signed `AI reviewer: {former['agent']} …` with any model qualifier "
                     "are this watch's own history: count them as yours when finding the head you last reviewed, "
                     "your threads and your covering approval. A role-qualified identity such as "
                     f"`{former['agent']} (Codex handoff)` stays someone else's, as review-pr's *Whose comment it is* says.")
    if r.get("filter"):
        lines.append(f"- This target carries a filter: {r['filter']!r}. If the PR falls outside it, settle without reviewing.")
    if r.get("token"):
        default = "PR_REVIEW_GH_TOKEN" if GH_PR.match(r["url"]) else "PR_REVIEW_GITLAB_TOKEN"
        # Under the default name, so every posting command and helper that reads it gets this target's token.
        lines.append(f"- Post on this target with the token in `${r['token']}`: run every posting command, helper "
                     f"scripts included, with `{default}=\"${r['token']}\"` exported, never with the default value.")
    settled = rec.get("settled")
    if settled:
        lines.append(f"- Last settled by this watch at head `{settled['head']}` on {settled['at']}; that is the head you last reviewed.")
        if settled.get("weighed"):
            lines.append(f"- Threads weighed and left silent at that head: {', '.join(settled['weighed'])}.")
    if prev and prev.get("started") and not (settled and settled["at"] >= prev["started"]):
        lines.append(f"- An earlier run started {prev['started']} for head `{prev['head'][:12]}` and never settled: before posting,")
        lines.append("  check what of yours landed on the PR after that time, and don't post it again.")
    if siblings:
        lines.append("")
        lines.append("Other open PRs in this watch, for related-PR checks (a starting point; verify before relying on it):")
        lines += [f"- {s['url']} — {s['title']} (`{s['branch']}` → `{s['base']}`, head `{s['head'][:12]}`)" for s in siblings[:60]]
    lines += ["", "End with:",
              f"  ~/.claude/bin/review-scan settle {w.name} {r['url']} --head <the head you reviewed> --since {engine.iso(now)} \\",
              "    --verdict approved|findings|outside-filter [--covered-by <approved earlier head>] \\",
              "    [--weighed <thread url>]... [--recheck <sibling PR url>]...",
              "If it exits 6, the PR does not show that verdict yet: post it (for a refused --covered-by,",
              "  a fresh formal approval naming the head), then settle again as the message says.",
              "If it exits 3 or 4, stop without settling: the next tick picks the PR up again."]
    return "\n".join(lines) + "\n"


def cmd_settle(a):
    since = engine.parse_time(a.since)
    # Outside the lock: a slow API call must not hold up ticks.
    pr = activity_since(a.url, since)
    if a.verdict == "approved" and a.covered_by and pr["head"] == a.head:
        pr["carry"] = carry(a.url, a.covered_by, a.head, engine.Watch(a.watch).load().config["own"])
    with engine.Watch(a.watch).locked() as w:
        return settle(w, a, pr)


def settle(w, a, pr):
    own = set(w.config["own"])
    if pr["head"] != a.head:
        print(f"refused: head is now {pr['head']}, not {a.head}; the next tick reviews it")
        return 3
    others = sorted(x for x in pr["authors"] - own if x)
    if others:
        print(f"refused: {', '.join(others)} posted after {a.since}; the next tick reviews it")
        return 4
    if a.verdict == "approved" and not covered(pr, own, a.head) and not covered(pr, own, a.covered_by):
        print(f"refused: no approval of ours covers {a.head[:12]}"
              + (f" or {a.covered_by[:12]}" if a.covered_by else "") + "; post it, then settle again")
        return 6
    if a.verdict == "approved" and not covered(pr, own, a.head) and not pr.get("carry"):
        print(f"refused: the commits since {a.covered_by[:12]} are no base-sync and fail the answered-findings or line-cap check, "
              f"so its approval does not cover {a.head[:12]}; post a fresh formal approval naming {a.head}, "
              "then settle again without --covered-by")
        return 6
    if a.verdict == "findings" and not pr["threads"] & own:
        print("refused: no open thread of ours on the PR; post the findings, then settle again")
        return 6
    record = {"head": pr["head"], "updated": pr["updated"], "at": engine.iso(engine.now_utc()),
              "verdict": a.verdict, "weighed": a.weighed or []}
    return engine.finish_settle(w, a.url, record, f"{a.url}: settled at {pr['head'][:12]} ({a.verdict})",
                                f"settled {a.url} at {pr['head']}",
                                [(sib, f"sibling {a.url} changed") for sib in a.recheck or []])


def covered(pr, own, sha):
    """Whether an approval of ours exists at `sha`: the head itself, or the earlier head the run
    says still covers this one, which `carry` then tests.

    Only a formal approval counts, except where
    a formal one is impossible (GitLab, whose hosts may forbid it, and a GitHub PR authored by one
    of our accounts), where an APPROVED post naming the sha stands in for it."""
    if not sha:
        return False
    entries = set(pr.get("approved_at", ()))
    if pr.get("notes_approve") or pr.get("author") in own:
        entries |= set(pr.get("noted_at", ()))
    return any(who in own and oid and (oid.startswith(sha) or sha.startswith(oid)) and len(min(oid, sha, key=len)) >= 7
               for who, oid in entries)


_wait_pr_ready = None


def wait_pr_ready():
    """bin/wait-pr-ready as a module, for its covering test. setup installs the two side by side."""
    global _wait_pr_ready
    if _wait_pr_ready is None:
        sys.dont_write_bytecode = True  # loading it as a module would litter its directory
        path = str(Path(__file__).resolve().parent / "wait-pr-ready")
        loader = importlib.machinery.SourceFileLoader("wait_pr_ready", path)
        module = importlib.util.module_from_spec(importlib.util.spec_from_loader("wait_pr_ready", loader))
        loader.exec_module(module)
        _wait_pr_ready = module
    return _wait_pr_ready


def carry(url, sha, head, own):
    """Whether our newest approval of `sha` still covers `head` by wait-pr-ready's mechanical
    test: a base-sync, or at least one finding, all answered or resolved, and at most
    CARRY_LINE_CAP changed lines.
    The waiter reads nothing else, so a head settled as approved past that test would leave
    the PR's author waiting on a verdict that never shows on GitHub."""
    w = wait_pr_ready()
    host = w.forge(url)
    if not host:
        raise engine.ScanError(f"not a PR or MR URL: {url}")
    reviewers = {w.login_key(o) for o in own}
    try:
        pr = host["read"]()
        found = [(w.ts(at), named, at) for _, author, body, at, state, commit in w.posts(pr)
                 if w.counts_as_verdict(author, body, reviewers) and not w.is_thread_reply(body, state)
                 and w.is_go(body, state)
                 for named in [(w.SHA.findall(body) or [commit])[-1]] if named and named.startswith(sha.lower())]
        if not found:
            return False
        _, full, at = max(found)
        same = w.base_sync_test(host)
        return bool(w.carries(pr, full, head, at, reviewers, lambda o, n, t: same(pr, o, n, t), host["changed_hunks"]))
    except (RuntimeError, subprocess.SubprocessError, ValueError, KeyError, TypeError) as e:
        raise engine.ScanError(f"could not test whether {sha[:12]} covers {head[:12]}: {e}")


def covers(spec, url):
    if spec == url:
        return True
    m = GH_PR.match(url)
    if m and not spec.startswith("gitlab:") and not spec.startswith("https://"):
        return m[1] == spec or m[1].split("/")[0] == spec
    m = GL_MR.match(url)
    if m and spec.startswith("gitlab:"):
        host, _, path = spec[len("gitlab:"):].partition("/")
        path = path.rstrip("!")
        return host == m[1] and (m[2] == path or m[2].startswith(path + "/"))
    return False


def cmd_nudge(a):
    """Queue a recheck in every covering watch; start a tick unless that watch is paused."""
    hit = 0
    for d in sorted(engine.HOME.glob("*/config.json")):
        with engine.Watch(d.parent.name).locked() as w:
            if not any(covers(t["spec"], a.url) for t in w.config["targets"]):
                continue
            w.prs.setdefault(a.url, {}).setdefault("recheck", []).append(f"nudge after a push of {a.head[:12]}")
            w.save()
            paused = w.paused
        hit += 1
        if paused:
            print(f"watch {w.name}: paused; recheck queued for the next tick after resume")
        else:
            subprocess.Popen([str(Path(sys.argv[0]).resolve()), "tick", w.name, "--only", a.url], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print(f"nudged watch {w.name}")
    if not hit:
        print("no review watch covers this PR")
    return 0


class PRSource:
    listed_slots_only = True
    version_field = "head"
    noun = "PRs"

    def targets(self, w):
        return [t["spec"] for t in w.config["targets"]]

    def list(self, w, now):
        cutoff = now - dt.timedelta(days=w.config["dormant_days"])
        listed, failed, accounting = {}, [], []
        for t in w.config["targets"]:
            try:
                rows = list_target(t["spec"])
            except (engine.ScanError, OSError, subprocess.SubprocessError, json.JSONDecodeError, KeyError, TypeError) as e:
                failed.append(t["spec"])
                accounting.append(f"{t['spec']}: UNREAD ({e})")
                continue
            kept = dormant = drafts = 0
            for r in rows:
                if r["state"] != "open":
                    continue
                if r["draft"] and not r["named"]:
                    drafts += 1
                    continue
                if engine.parse_time(r["updated"]) < cutoff and not r["named"]:
                    dormant += 1
                    continue
                r["target"], r["filter"], r["token"] = t["spec"], t.get("filter"), t.get("token")
                listed[r["url"]] = r
                kept += 1
            accounting.append(f"{t['spec']}: {len(rows)} listed, {kept} kept, {drafts} draft, {dormant} dormant")
        finished = [t for t in w.config["targets"] if (GH_PR.match(t["spec"]) or GL_MR.match(t["spec"]))
                    and t["spec"] not in failed and not any(r["target"] == t["spec"] for r in listed.values())]
        return listed, failed, accounting, finished

    def finish(self, w, finished, accounting):
        for t in finished:
            w.config["targets"].remove(t)
            accounting.append(f"{t['spec']}: merged or closed, left the watch")
        if finished:
            engine.write_json(w.dir / "config.json", w.config)

    def owed(self, rec, row, full):
        return owed_reason(rec, row, full)

    def brief(self, w, batch, listed, now):
        key, row, reason, _ = batch[0]
        return build_brief(w, row, w.prs[key], reason, [r for k, r in listed.items() if k != key], now)

    def covers(self, spec, key):
        return covers(spec, key)

    def describe(self, w, detail):
        for t in w.config["targets"]:
            yield f"  {'target ' if detail else ''}{t['spec']}" + (f" (filter: {t['filter']})" if t.get("filter") else "") + (
                f" (posts with ${t['token']})" if detail and t.get("token") else "")

    def policy(self, w):
        return f"dormant after {w.config['dormant_days']} days, "


engine.SOURCE = PRSource()


def main(argv=None):
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    i = sub.add_parser("init")
    i.add_argument("watch")
    i.add_argument("--target", action="append", required=True)
    i.add_argument("--filter", action="append", help="SPEC=TEXT: a judgment-call filter the run applies")
    i.add_argument("--token", action="append",
                   help="SPEC=ENV_VAR: the variable holding this target's posting token, when the default reviewer-bot one can't post there")
    i.add_argument("--reviewer-model", help="model selects Claude or Codex automatically (default: opus; existing watches keep their model)")
    i.add_argument("--effort", default="medium", choices=["low", "medium", "high", "xhigh", "max"])
    i.add_argument("--own", action="append", required=True,
                   help="an account that posts as you: your default account and the reviewer bot (repeat)")
    i.add_argument("--max-parallel", type=int, default=3)
    i.add_argument("--dormant-days", type=int, default=14)
    t = sub.add_parser("tick")
    t.add_argument("watch")
    t.add_argument("--full", action="store_true", help="treat every PR as owed (first pass, lost state)")
    t.add_argument("--only", help="consider just this PR")
    t.add_argument("--dry-run", action="store_true")
    t.add_argument("--chained", action="store_true", help="started by a run that ended: do nothing unless the watch is installed")
    s = sub.add_parser("settle")
    s.add_argument("watch")
    s.add_argument("url")
    s.add_argument("--head", required=True)
    s.add_argument("--since", required=True)
    s.add_argument("--verdict", required=True, choices=["approved", "findings", "outside-filter"],
                   help="what the run left: an approval at the head, open threads of ours, or a PR outside the filter")
    s.add_argument("--covered-by", help="with --verdict approved: the earlier head whose approval of ours still "
                   "covers this one; settle refuses it unless the commits since are a base-sync or that "
                   "approval left findings, all are answered or resolved, and the changes total at most "
                   f"{wait_pr_ready().CARRY_LINE_CAP} lines, as wait-pr-ready reads them")
    s.add_argument("--weighed", action="append", help="a thread weighed and left silent at this head")
    s.add_argument("--recheck", action="append", help="a sibling PR this review changed the picture for")
    n = sub.add_parser("nudge")
    n.add_argument("url")
    n.add_argument("--head", required=True)
    sub.add_parser("list")
    mod = sub.add_parser("model", help="show or change the model and effort the watch's runs use")
    mod.add_argument("watch")
    mod.add_argument("model", nargs="?", help="e.g. opus, sonnet, gpt-6-astra or a full model id; selects the CLI automatically")
    mod.add_argument("--effort", choices=["low", "medium", "high", "xhigh", "max"])
    acc = sub.add_parser("account", help="show or switch the Claude account the watch's runs use")
    acc.add_argument("watch")
    acc.add_argument("config", nargs="?", help="a claude config directory with its own login, or `default`")
    sub.add_parser("status").add_argument("watch", nargs="?", help="omit to list every watch")
    sub.add_parser("pause", help="pause new reviews; runs in flight can finish").add_argument("watch")
    sub.add_parser("resume", help="resume reviews on the next tick; schedule unchanged").add_argument("watch")
    sub.add_parser("uninstall").add_argument("watch")
    ins = sub.add_parser("install")
    ins.add_argument("watch")
    ins.add_argument("--interval", type=int, default=120, help="seconds between scheduled ticks (default: 120)")
    a = p.parse_args(argv)
    try:
        return {"init": cmd_init, "tick": engine.cmd_tick, "settle": cmd_settle, "nudge": cmd_nudge, "status": engine.cmd_status, "list": engine.cmd_list, "account": engine.cmd_account, "model": engine.cmd_model,
                "install": engine.cmd_install, "uninstall": engine.cmd_uninstall,
                "pause": engine.cmd_pause_resume, "resume": engine.cmd_pause_resume}[a.cmd](a)
    except engine.ScanError as e:
        print(f"error: {e}", file=sys.stderr)
        return 5


if __name__ == "__main__":
    sys.exit(main())
