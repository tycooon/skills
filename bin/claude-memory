#!/usr/bin/env python3
"""Share Claude Code auto-memories between the Mac, trusted dev-box sessions and Claude cloud sessions.

  claude-memory start                SessionStart: git sync pull + link this project's memory folder; falls back to pull
  claude-memory end [--background]   SessionEnd: commit, rebase and push the checkout, then refresh the Secrets snapshot
  claude-memory pull                 cloud: fetch the Secrets snapshot, print this repo's memory (read-only)
  claude-memory push [--background]  publish the Secrets snapshot (git mode: from the checkout; otherwise from the Mac's project folders)
  claude-memory migrate [--from <backup>]  Mac, by hand: import the project memory folders (or a memory-backup folder) into the checkout and link them
  claude-memory hooks --git|--cloud  register start/end (--mac is an alias of --git) or the cloud's SessionStart pull

Memories are keyed by host/owner/repo from each project's git remote, because checkout paths never match between machines. A private git repo, named by "repo" in ~/.claude/memory-sync.json, is the shared store, laid out as <host>/<owner>/<repo>/<note>.md. Its presence turns on git mode: the Mac and trusted dev-box sessions read and write the checkout ("checkout", default ~/.claude/memory-repo), and each project's <config>/projects/<slug>/memory folder becomes a symlink to <checkout>/<key>. MEMORY.md merges as a union (.gitattributes); when another note conflicts in end's rebase, this machine's version keeps the path, the upstream one is saved as <name>.conflict-<host>-<ts>.md and MEMORY.md points at it. On a Mac without a usable checkout, start prints nothing and end keeps publishing the project folders (push), whether or not "repo" is set, until migrate runs; elsewhere start falls back to pull and end does nothing. migrate --from and the folder adoption never replace a note: MEMORY.md gains the source's missing lines, and any other differing note keeps the checkout's version with the source's saved as <name>.conflict-<host>-<ts>.md and a pointer in MEMORY.md (mtimes decide nothing). start never imports notes: a folder that is not the expected link is moved to <config>/memory-backup/ and linked afresh (the memory folders sit in a home directory other processes can write, the checkout only trusted sessions), and only a person's migrate [--from <backup>] imports notes. end stages only regular files inside the checkout and refuses any symlink there. Never mid-rebase: an unexpected git failure aborts the rebase, keeps the local commit and is logged for the next end to retry.

Cloud sessions cannot reach git, so every git writer also refreshes a snapshot in Kubernetes Secrets, which they reach through an agent proxy that injects the cluster credential. A Secret holds at most 1 MiB, so the archive is split over claude-memory (the index, written last) and claude-memory-1 to claude-memory-7, which is the fixed set of names the cluster grants read on. ~/.claude/memory-sync.json names the cluster on each machine: {"namespace": ..., "context": ..., "kubeconfig": ..., "repo": ..., "checkout": ...}, with only namespace required. A glob in ~/.claude/memory-sync.exclude matching host/owner/repo keeps that repo's folder out of the checkout, and one matching host/owner/repo/note.md keeps that note on this machine (listed in <checkout>/.git/info/exclude, so never committed or archived); migrate and the Mac's non-git push refuse to run until that file exists, even empty. Every sync result goes to CLAUDE_MEMORY_LOG, never file contents.
"""

import base64
import contextlib
import datetime
import fcntl
import fnmatch
import gzip
import hashlib
import io
import itertools
import json
import os
import platform
import re
import shutil
import signal
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request
from pathlib import Path, PurePosixPath
from urllib.parse import urlsplit

CONFIG = Path(os.environ.get("CLAUDE_CONFIG_DIR", "~/.claude")).expanduser()
KUBECTL = os.environ.get("KUBECTL", "kubectl")
SNAPSHOT = CONFIG / "memory-sync"
EXCLUDE = CONFIG / "memory-sync.exclude"
CLUSTER = CONFIG / "memory-sync.json"
INSTALLED = CONFIG / "bin" / "claude-memory"
# A cloud environment keeps the copy it was built with for about a week, so pull first replaces it with this one.
SOURCE = os.environ.get("CLAUDE_MEMORY_SOURCE", "https://raw.githubusercontent.com/tycooon/skills/master/bin/claude-memory")

SECRET = "claude-memory"
DATA_KEY = "memory.tar.gz"
HASH_ANNOTATION = "memory-sync/sha256"
PUSHED_AT_ANNOTATION = "memory-sync/pushed-at"
CHUNKS_ANNOTATION = "memory-sync/chunks"
SECRETS = [SECRET] + [f"{SECRET}-{i}" for i in range(1, 8)]
# A Secret holds at most 1 MiB of data.
CHUNK_BYTES = 900 * 1024
MAX_ARCHIVE_BYTES = CHUNK_BYTES * len(SECRETS)
# What Claude Code itself loads from MEMORY.md.
CONTEXT_LINES = 200
CONTEXT_BYTES = 25 * 1024

# (event, command, timeout) per flag; --mac is the old name of --git.
HOOK_COMMANDS = {
    "--git": [("SessionStart", "~/.claude/bin/claude-memory start", 15), ("SessionEnd", "~/.claude/bin/claude-memory end --background", None)],
    "--cloud": [("SessionStart", "~/.claude/bin/claude-memory pull", 15)],
}
HOOK_COMMANDS["--mac"] = HOOK_COMMANDS["--git"]

LOCK = "claude-memory.lock"
GITATTRIBUTES_LINE = "MEMORY.md merge=union"
OLD_GITATTRIBUTES_LINES = ("*/*/*/MEMORY.md merge=union",)  # matched three-part keys only
PULL_SECONDS = 8
LOCK_SECONDS = 60
PUSH_ATTEMPTS = 3


class Failure(Exception):
    pass


def normalize_remote(url):
    url = url.strip()
    if "://" in url:
        parts = urlsplit(url)
        host, path = parts.hostname, parts.path
    elif "@" in url.split(":", 1)[0] and ":" in url:
        host, path = url.split("@", 1)[1].split(":", 1)
    else:
        return None
    path = path.strip("/")
    if path.endswith(".git"):
        path = path[: -len(".git")]
    if not host or path.count("/") < 1:
        return None
    return f"{host.lower()}/{path}"


def repo_of(directory):
    result = subprocess.run(["git", "-C", str(directory), "remote", "get-url", "origin"], capture_output=True, text=True)
    return normalize_remote(result.stdout) if result.returncode == 0 else None


def sha256(data):
    return hashlib.sha256(data).hexdigest()


def kubectl(args, stdin=None):
    try:
        result = subprocess.run([KUBECTL, *args], input=stdin, capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise Failure(str(error))
    if result.returncode != 0:
        lines = result.stderr.strip().splitlines() or [f"kubectl exited {result.returncode}"]
        raise Failure(lines[-1])
    return result.stdout


def cluster(*extra):
    """Returns (namespace, kubectl arguments) from ~/.claude/memory-sync.json."""
    try:
        config = json.loads(CLUSTER.read_text())
        namespace = config["namespace"]
    except FileNotFoundError:
        raise Failure(f"{CLUSTER} is missing, so the cluster holding the snapshot is unknown")
    except (ValueError, KeyError, TypeError) as error:
        raise Failure(f"{CLUSTER} is invalid: {error!r}")
    args = []
    if config.get("kubeconfig"):
        args += ["--kubeconfig", str(Path(config["kubeconfig"]).expanduser())]
    if config.get("context"):
        args += ["--context", config["context"]]
    return namespace, [*args, "-n", namespace, *extra]


def get_secret(kube_args):
    try:
        return json.loads(kubectl(["get", "secret", SECRET, "-o", "json", *kube_args]))
    except Failure as error:
        if "NotFound" in str(error):
            return None
        raise


def secret_manifest(name, namespace, chunk, annotations=None):
    metadata = {"name": name, "namespace": namespace}
    if annotations:
        metadata["annotations"] = annotations
    return {"apiVersion": "v1", "kind": "Secret", "metadata": metadata, "type": "Opaque", "data": {DATA_KEY: base64.b64encode(chunk).decode()}}


def apply(manifests, kube_args):
    # Server-side apply keeps no last-applied copy, which would double each object's size.
    body = {"apiVersion": "v1", "kind": "List", "items": manifests}
    kubectl(["apply", "--server-side", "--force-conflicts", "--field-manager", "claude-memory", "-f", "-", *kube_args], stdin=json.dumps(body))


# --- archive -----------------------------------------------------------------


def build_archive(files, manifest):
    """Same files and manifest give the same bytes, so the hash tells whether anything changed."""
    entries = dict(files)
    entries["manifest.json"] = (json.dumps(manifest, indent=2, sort_keys=True) + "\n").encode()
    buffer = io.BytesIO()
    with gzip.GzipFile(fileobj=buffer, mode="wb", mtime=0) as gz:
        with tarfile.open(fileobj=gz, mode="w", format=tarfile.PAX_FORMAT) as tar:
            for name in sorted(entries):
                info = tarfile.TarInfo(name)
                info.size = len(entries[name])
                info.mode = 0o644
                tar.addfile(info, io.BytesIO(entries[name]))
    return buffer.getvalue()


def read_archive(data):
    files = {}
    try:
        with tarfile.open(fileobj=io.BytesIO(data), mode="r:gz") as tar:
            for member in tar:
                path = PurePosixPath(member.name)
                if not member.isfile() or path.is_absolute() or ".." in path.parts:
                    raise Failure(f"corrupt archive: unexpected entry {member.name!r}")
                files[member.name] = tar.extractfile(member).read()
        manifest = json.loads(files.pop("manifest.json"))
    except (tarfile.TarError, OSError, KeyError, ValueError) as error:
        raise Failure(f"corrupt archive: {error}")
    return files, manifest


# --- push (Mac) --------------------------------------------------------------


def project_path(name):
    """The checkout a project folder is named after, found on disk.

    Claude Code names the folder after the repo's path with every character but [A-Za-z0-9] turned into "-", so several paths give one name; only the one that exists counts.
    """

    def walk(directory, rest):
        if not rest:
            return Path(directory)
        try:
            entries = os.listdir(directory)
        except OSError:
            return None
        for entry in entries:
            key = re.sub(r"[^A-Za-z0-9]", "-", entry)
            width = key.count("-") + 1
            if "-".join(rest[:width]) == key:
                found = walk(os.path.join(directory, entry), rest[width:])
                if found:
                    return found
        return None

    return walk("/", name.split("-")[1:])


def session_cwds(project):
    # Worktrees share their repo's project folder, so these include worktrees removed since.
    for session in sorted(project.glob("*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True):
        with open(session) as f:
            for line in f:
                try:
                    cwd = json.loads(line).get("cwd")
                except ValueError:
                    continue
                if cwd:
                    yield Path(cwd)
                    break


def project_repo(project):
    """Returns (repo, None) or (None, why it has none)."""
    found_checkout = False
    for path in itertools.chain([project_path(project.name)], session_cwds(project)):
        if path and path.is_dir():
            found_checkout = True
            repo = repo_of(path)
            if repo:
                return repo, None
    return None, "no git remote" if found_checkout else "checkout is gone"


def exclude_patterns():
    try:
        text = EXCLUDE.read_text()
    except FileNotFoundError:
        return []
    lines = (line.strip() for line in text.splitlines())
    return [line for line in lines if line and not line.startswith("#")]


def collect():
    """Returns ({"host/owner/repo/name.md": bytes}, sorted repos, skipped project descriptions)."""
    patterns = exclude_patterns()
    newest = {}
    repos = set()
    skipped = []
    for memory in sorted((CONFIG / "projects").glob("*/memory")):
        notes = [p for p in memory.rglob("*.md") if p.is_file()]
        if not notes:
            continue
        repo, reason = project_repo(memory.parent)
        if repo is None:
            skipped.append(f"{memory.parent.name} ({reason})")
            continue
        if any(fnmatch.fnmatchcase(repo, pattern) for pattern in patterns):
            continue
        repos.add(repo)
        # A checkout and its worktrees are one repo: the newest copy of each note wins.
        for note in notes:
            name = f"{repo}/{note.relative_to(memory).as_posix()}"
            if any(fnmatch.fnmatchcase(name, pattern) for pattern in patterns):
                continue
            mtime = note.stat().st_mtime
            if name not in newest or mtime > newest[name][0]:
                newest[name] = (mtime, note.read_bytes())
    return {name: data for name, (_, data) in newest.items()}, sorted(repos), skipped


def log(line):
    default = "~/Library/Logs/claude-memory.log" if platform.system() == "Darwin" else "~/.local/state/claude-memory.log"
    path = Path(os.environ.get("CLAUDE_MEMORY_LOG", default)).expanduser()
    path.parent.mkdir(parents=True, exist_ok=True)
    stamp = utc_now()
    with open(path, "a") as f:
        f.write(f"{stamp} {line}\n")


def utc_now(fmt="%Y-%m-%dT%H:%M:%SZ"):
    return datetime.datetime.now(datetime.timezone.utc).strftime(fmt)


def publish(files, repos, skipped_note=""):
    """Writes the Secrets snapshot of {name: bytes} unless its hash is already there; returns an exit status."""
    try:
        namespace, kube_args = cluster()
    except Failure as error:
        log(f"failed: {error}")
        return 1
    archive = build_archive(files, {"host": platform.node(), "repos": repos})
    if len(archive) > MAX_ARCHIVE_BYTES:
        sizes = {repo: sum(len(data) for name, data in files.items() if name.startswith(repo + "/")) for repo in repos}
        largest = ", ".join(f"{repo} {size // 1024} KiB" for repo, size in sorted(sizes.items(), key=lambda kv: -kv[1])[:3])
        log(f"failed: archive is {len(archive) // 1024} KiB, over the {MAX_ARCHIVE_BYTES // 1024} KiB limit; largest: {largest}")
        return 1
    digest = sha256(archive)
    try:
        current = get_secret(kube_args)
        if current and current["metadata"].get("annotations", {}).get(HASH_ANNOTATION) == digest:
            log(f"unchanged ({len(repos)} repo(s)){skipped_note}")
            return 0
        pushed_at = utc_now()
        chunks = [archive[i : i + CHUNK_BYTES] for i in range(0, len(archive), CHUNK_BYTES)] or [b""]
        if len(chunks) > 1:
            apply([secret_manifest(name, namespace, chunk) for name, chunk in zip(SECRETS[1:], chunks[1:])], kube_args)
        # The index goes last, so a pull never pairs a new index with old chunks; the hash catches the reverse.
        annotations = {HASH_ANNOTATION: digest, PUSHED_AT_ANNOTATION: pushed_at, CHUNKS_ANNOTATION: str(len(chunks))}
        apply([secret_manifest(SECRET, namespace, chunks[0], annotations)], kube_args)
        stale = SECRETS[len(chunks) :]
        if stale:
            kubectl(["delete", "secret", *stale, "--ignore-not-found", *kube_args])
    except Failure as error:
        log(f"failed: {error}")
        return 1
    log(f"pushed {len(repos)} repo(s), {len(archive) // 1024} KiB in {len(chunks)} Secret(s){skipped_note}")
    return 0


def push():
    checkout = git_checkout()
    if checkout:
        try:
            with locked(checkout, LOCK_SECONDS):
                return refresh_secrets(checkout)
        except Failure as error:
            log(f"failed: {error}")
            return 1
    if not EXCLUDE.exists():
        log(f"failed: create {EXCLUDE}, even empty, after deciding which repos' memories stay on this Mac")
        return 1
    files, repos, skipped = collect()
    skipped_note = f"; skipped: {', '.join(skipped)}" if skipped else ""
    return publish(files, repos, skipped_note)


# --- git store ---------------------------------------------------------------


def load_config():
    try:
        config = json.loads(CLUSTER.read_text())
    except (OSError, ValueError):
        return {}
    return config if isinstance(config, dict) else {}


def checkout_path(config):
    return Path(config.get("checkout") or CONFIG / "memory-repo").expanduser()


def git_checkout():
    """The checkout when git mode is on and this process can use it, else None."""
    config = load_config()
    if not isinstance(config.get("repo"), str) or not config["repo"]:
        return None
    path = checkout_path(config)
    git_dir = path / ".git"
    try:
        usable = path.is_dir() and git_dir.exists() and all(os.access(p, os.R_OK | os.W_OK | os.X_OK) for p in (path, git_dir))
    except OSError:
        usable = False
    return path if usable else None


def identity_args(checkout):
    """Our own identity only where git has none; never signs, since a hook must not wait on a prompt."""
    have = all(subprocess.run(["git", "-C", str(checkout), "config", key], capture_output=True, text=True).stdout.strip() for key in ("user.name", "user.email"))
    args = [] if have else ["-c", "user.name=claude-memory", "-c", "user.email=claude-memory@localhost"]
    return args + ["-c", "commit.gpgsign=false"]


def git(checkout, *args, timeout=60, check=True, input=None):
    """Runs git in checkout with no prompts; a timeout kills the whole process group. Output is bytes."""
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0", GIT_EDITOR="true", LC_ALL="C")
    env.setdefault("GIT_SSH_COMMAND", "ssh -o BatchMode=yes")
    command = ["git", "-C", str(checkout), *identity_args(checkout), *args]
    try:
        proc = subprocess.Popen(command, stdin=subprocess.PIPE if input is not None else subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env, start_new_session=True)
    except OSError as error:
        raise Failure(f"git: {error}")
    try:
        out, err = proc.communicate(input, timeout=timeout)
    except subprocess.TimeoutExpired:
        os.killpg(proc.pid, signal.SIGKILL)
        proc.communicate()
        raise Failure(f"git {args[0]} timed out after {timeout:g} s")
    if check and proc.returncode != 0:
        lines = err.decode(errors="replace").strip().splitlines() or [f"exited {proc.returncode}"]
        raise Failure(f"git {args[0]}: {lines[-1]}")
    return subprocess.CompletedProcess(command, proc.returncode, out, err)


def git_text(checkout, *args, **kwargs):
    return git(checkout, *args, **kwargs).stdout.decode(errors="replace").strip()


@contextlib.contextmanager
def locked(checkout, wait):
    handle = open(Path(checkout) / ".git" / LOCK, "a+")
    deadline = time.monotonic() + wait
    try:
        while True:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if time.monotonic() >= deadline:
                    raise Failure(f"another memory sync held the lock for over {wait:g} s")
                time.sleep(0.1)
        yield
    finally:
        handle.close()


def rebase_running(checkout):
    for name in ("rebase-merge", "rebase-apply"):
        path = Path(git_text(checkout, "rev-parse", "--git-path", name))
        if (path if path.is_absolute() else Path(checkout) / path).exists():
            return True
    return False


def abort_rebase(checkout):
    if rebase_running(checkout):
        git(checkout, "rebase", "--abort", check=False)


def matches_exclude(name, patterns):
    return any(fnmatch.fnmatchcase(name, pattern) for pattern in patterns)


def sync_excludes(checkout):
    """Lists untracked notes that match memory-sync.exclude in .git/info/exclude, so they are never staged."""
    patterns = exclude_patterns()
    if not patterns:
        return
    names = git_text(checkout, "ls-files", "--others", "--exclude-standard", "-z").split("\0")
    hidden = sorted(name for name in names if name and matches_exclude(name, patterns))
    if hidden:
        path = Path(git_text(checkout, "rev-parse", "--git-path", "info/exclude"))
        path = path if path.is_absolute() else Path(checkout) / path
        path.parent.mkdir(parents=True, exist_ok=True)
        existing = path.read_text() if path.exists() else ""
        with open(path, "a") as f:
            f.write(("" if existing.endswith("\n") or not existing else "\n") + "".join(f"{name}\n" for name in hidden))


def ensure_gitattributes(checkout):
    """MEMORY.md merges as a union at any depth; an older, narrower line is replaced, not kept beside it."""
    path = Path(checkout) / ".gitattributes"
    text = path.read_text() if path.exists() else ""
    lines = text.splitlines()
    if GITATTRIBUTES_LINE in lines and not any(line in OLD_GITATTRIBUTES_LINES for line in lines):
        return
    kept = [line for line in lines if line not in OLD_GITATTRIBUTES_LINES and line != GITATTRIBUTES_LINE]
    path.write_text("".join(f"{line}\n" for line in kept + [GITATTRIBUTES_LINE]))


def symlinked(checkout, name):
    """True when name, or a folder on its way inside the checkout, is a symlink: never staged, archived or followed."""
    path = Path(checkout)
    for part in PurePosixPath(name).parts:
        path = path / part
        if path.is_symlink():
            return True
    return False


def commit_all(checkout):
    """Stages every regular note inside the checkout (not what .git/info/exclude lists, never a symlink) and commits; True when something changed."""
    changed = git_text(checkout, "ls-files", "-z", "--others", "--modified", "--deleted", "--exclude-standard").split("\0")
    names = sorted({n for n in changed if n and (n == ".gitattributes" or len(PurePosixPath(n).parts) >= 4)})
    for name in [n for n in names if symlinked(checkout, n)]:
        log(f"refused to stage symlink {name}")
    names = [n for n in names if not symlinked(checkout, n)]
    if names:
        git(checkout, "--literal-pathspecs", "add", "-A", "--pathspec-from-file=-", "--pathspec-file-nul", input="\0".join(names).encode())
    if git(checkout, "diff", "--cached", "--quiet", check=False).returncode == 0:
        return False
    git(checkout, "commit", "-q", "-m", f"memory: {platform.node()} {utc_now('%Y-%m-%dT%H:%M:%SZ')}")
    return True


def current_branch(checkout):
    return git_text(checkout, "symbolic-ref", "--short", "HEAD")


def upstream_ref(checkout, branch):
    result = git(checkout, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}", check=False)
    if result.returncode == 0:
        return result.stdout.decode().strip()
    remote = f"origin/{branch}"
    return remote if git(checkout, "rev-parse", "--verify", "-q", f"refs/remotes/{remote}", check=False).returncode == 0 else None


def ahead_of(checkout, upstream):
    if upstream is None:
        return git(checkout, "rev-parse", "--verify", "-q", "HEAD", check=False).returncode == 0
    return int(git_text(checkout, "rev-list", "--count", f"{upstream}..HEAD")) > 0


def stage_blob(checkout, stage, path):
    result = git(checkout, "show", f":{stage}:{path}", check=False)
    return result.stdout if result.returncode == 0 else None


def conflict_name(checkout, path):
    stem = path[: -len(".md")] if path.endswith(".md") else path
    host = re.sub(r"[^A-Za-z0-9._-]", "-", platform.node())
    base = f"{stem}.conflict-{host}-{utc_now('%Y%m%dT%H%M%SZ')}"
    name, n = f"{base}.md", 1
    while (Path(checkout) / name).exists():
        n += 1
        name = f"{base}-{n}.md"
    return name


def index_for(checkout, path):
    """The MEMORY.md nearest above path, or the one beside it when none exists yet."""
    directory = (Path(checkout) / path).parent
    for candidate in [directory, *directory.parents]:
        if candidate == Path(checkout):
            break
        if (candidate / "MEMORY.md").exists():
            return candidate / "MEMORY.md"
    return directory / "MEMORY.md"


def point_to_conflict(checkout, path, name):
    """Adds a line to the MEMORY.md that serves path, pointing at its conflict file name. Returns that index's path in the checkout."""
    index = index_for(checkout, path)
    text = index.read_text() if index.exists() else ""
    relative = os.path.relpath(Path(checkout) / name, index.parent)
    line = f"- [Unresolved conflict in {PurePosixPath(path).name}]({relative}) — this machine's version kept, upstream's saved there; merge them, then delete the file and this line\n"
    index.write_text(text + ("" if text.endswith("\n") or not text else "\n") + line)
    return str(index.relative_to(checkout))


def resolve_conflicts(checkout, paths, conflicts):
    """Keeps this machine's version at each path (stage 3 during a rebase) and saves upstream's (stage 2) beside it."""
    for path in sorted(paths, key=lambda p: (PurePosixPath(p).name != "MEMORY.md", p)):
        local, upstream = stage_blob(checkout, 3, path), stage_blob(checkout, 2, path)
        full = Path(checkout) / path
        if local is None:
            git(checkout, "rm", "-q", "-f", "--", path)
        else:
            full.write_bytes(local)
            git(checkout, "add", "--", path)
        if upstream is None or upstream == local:
            continue
        name = conflict_name(checkout, path)
        (Path(checkout) / name).write_bytes(upstream)
        git(checkout, "add", "--", name)
        git(checkout, "add", "--", point_to_conflict(checkout, path, name))
        conflicts.append(f"{path} (upstream saved as {name})")


def rebase_onto(checkout, upstream, conflicts):
    if git(checkout, "merge-base", "--is-ancestor", upstream, "HEAD", check=False).returncode == 0:
        return
    result = git(checkout, "rebase", upstream, check=False)
    for _ in range(200):
        if result.returncode == 0:
            return
        if not rebase_running(checkout):
            lines = result.stderr.decode(errors="replace").strip().splitlines() or ["failed"]
            raise Failure(f"git rebase: {lines[-1]}")
        unmerged = [p for p in git_text(checkout, "diff", "--name-only", "--diff-filter=U", "-z").split("\0") if p]
        if unmerged:
            resolve_conflicts(checkout, unmerged, conflicts)
        elif git(checkout, "diff", "--cached", "--quiet", check=False).returncode != 0:
            raise Failure("git rebase: stopped with no conflict")
        # A step left empty by the resolution has nothing to continue with, so it is dropped.
        result = git(checkout, "rebase", "--continue", check=False)
        if result.returncode != 0 and rebase_running(checkout) and not [p for p in git_text(checkout, "diff", "--name-only", "--diff-filter=U", "-z").split("\0") if p] and git(checkout, "diff", "--cached", "--quiet", check=False).returncode == 0:
            result = git(checkout, "rebase", "--skip", check=False)
    raise Failure("git rebase: too many steps")


def fetch_and_rebase(checkout, conflicts, timeout):
    """Fetches, then rebases onto the upstream branch; returns it, or None when the remote has no such branch yet."""
    git(checkout, "fetch", "origin", timeout=timeout)
    upstream = upstream_ref(checkout, current_branch(checkout))
    if upstream:
        rebase_onto(checkout, upstream, conflicts)
    return upstream


def sync_remote(checkout, conflicts):
    branch = current_branch(checkout)
    for attempt in range(1, PUSH_ATTEMPTS + 1):
        upstream = fetch_and_rebase(checkout, conflicts, 60)
        if upstream and not ahead_of(checkout, upstream):
            return "nothing to push"
        result = git(checkout, "push", "-u", "origin", f"HEAD:refs/heads/{branch}", check=False)
        if result.returncode == 0:
            return f"pushed {git_text(checkout, 'rev-parse', '--short', 'HEAD')}"
        error = result.stderr.decode(errors="replace")
        if "non-fast-forward" not in error and "fetch first" not in error:
            lines = error.strip().splitlines() or ["failed"]
            raise Failure(f"git push: {lines[-1]}")
    raise Failure(f"git push: still rejected after {PUSH_ATTEMPTS} attempts")


def refresh_secrets(checkout):
    """The Secrets snapshot from tracked files only, so notes kept on this machine never leave it."""
    names = [n for n in git_text(checkout, "ls-files", "-z").split("\0") if n]
    files = {}
    for name in names:
        if len(PurePosixPath(name).parts) < 4 or symlinked(checkout, name):
            continue
        try:
            files[name] = (Path(checkout) / name).read_bytes()
        except OSError:
            continue  # tracked but gone: the next commit records the deletion
    indexed = sorted({str(PurePosixPath(n).parent) for n in files if PurePosixPath(n).name == "MEMORY.md"})
    loose = {"/".join(PurePosixPath(n).parts[:3]) for n in files if not any(n.startswith(d + "/") for d in indexed)}
    return publish(files, sorted(set(indexed) | loose))


# --- linking -----------------------------------------------------------------


def project_slug(directory):
    """Claude Code names a project's folder after the main checkout's path, worktrees included."""
    result = subprocess.run(["git", "-C", str(directory), "rev-parse", "--path-format=absolute", "--git-common-dir"], capture_output=True, text=True)
    common = Path(result.stdout.strip()) if result.returncode == 0 and result.stdout.strip() else None
    root = common.parent if common is not None and common.name == ".git" else Path(directory)
    return re.sub(r"[^A-Za-z0-9]", "-", os.path.realpath(root))


def regular_notes(folder):
    """The regular files under folder; symlinks (files or folders) are never followed or imported."""
    found = []
    for root, _, names in os.walk(folder, followlinks=False):
        found += [Path(root) / n for n in sorted(names) if not (Path(root) / n).is_symlink()]
    return found


def import_notes(checkout, source, key):
    """Imports source's notes into <checkout>/<key> without ever replacing one. Returns (copied, conflicts).

    A missing note is copied. MEMORY.md gains the source's lines it lacks, in order. Any other note that differs keeps the checkout's version, and the source's goes beside it as <name>.conflict-<host>-<ts>.md with a pointer line in MEMORY.md.
    """
    target = Path(checkout) / key
    copied, conflicts = [], []
    notes = sorted(regular_notes(source), key=lambda p: (p.name != "MEMORY.md", p))
    for path in notes:
        relative = f"{key}/{path.relative_to(source).as_posix()}"
        dest = Path(checkout) / relative
        if symlinked(checkout, relative):
            continue
        data = path.read_bytes()
        if not dest.is_file():
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(path, dest)
            copied.append(relative)
        elif dest.read_bytes() == data:
            continue
        elif path.name == "MEMORY.md":
            have = dest.read_text(errors="replace").splitlines()
            extra = [line for line in dict.fromkeys(data.decode(errors="replace").splitlines()) if line.strip() and line not in have]
            if extra:
                text = dest.read_text(errors="replace")
                dest.write_text(text + ("" if text.endswith("\n") or not text else "\n") + "".join(f"{line}\n" for line in extra))
                copied.append(relative)
        elif not any(c.read_bytes() == data for c in dest.parent.glob(f"{dest.stem}.conflict-*.md")):  # a repeated import adds no second copy
            name = conflict_name(checkout, relative)
            (Path(checkout) / name).write_bytes(data)
            point_to_conflict(checkout, relative, name)
            conflicts.append(f"{relative} (the backup's version saved as {name})")
    return copied, conflicts


def move_to_backup(memory, slug):
    backup = CONFIG / "memory-backup" / f"{slug}-{utc_now('%Y%m%dT%H%M%SZ')}"
    backup.parent.mkdir(parents=True, exist_ok=True)
    shutil.move(str(memory), str(backup))
    return backup


def link_memory(checkout, memory, key, slug, adopt=False):
    """Makes memory (a project's folder) a symlink to <checkout>/<key>. Returns (state, detail): linked, already, moved (detail: the backup) or skipped.

    Only migrate (adopt) imports notes from a folder it finds; start never does, because other processes can write these folders and only trusted sessions may write the checkout.
    """
    target = Path(checkout) / key
    if memory.is_symlink() and os.path.realpath(memory) == os.path.realpath(target):
        target.mkdir(parents=True, exist_ok=True)
        return "already", ""
    backup = None
    if adopt:
        if memory.is_symlink():
            return "skipped", "links elsewhere"
        if memory.exists() and not memory.is_dir():
            return "skipped", "not a folder"
        files = regular_notes(memory) if memory.is_dir() else []
        copied, conflicts = import_notes(checkout, memory, key)
        for conflict in conflicts:
            log(f"import conflict {conflict}")
        target.mkdir(parents=True, exist_ok=True)
        if copied or conflicts:
            sync_excludes(checkout)
            commit_all(checkout)
        if files:
            backup = move_to_backup(memory, slug)
    elif os.path.lexists(memory):
        if memory.is_dir() and not memory.is_symlink() and not any(p.is_file() or p.is_symlink() for p in memory.rglob("*")):
            pass  # empty
        else:
            backup = move_to_backup(memory, slug)
    if backup is None and os.path.lexists(memory):
        if memory.is_dir() and not memory.is_symlink():
            shutil.rmtree(memory)
        else:
            memory.unlink()
    target.mkdir(parents=True, exist_ok=True)
    memory.parent.mkdir(parents=True, exist_ok=True)
    os.symlink(target, memory)
    return ("moved", str(backup)) if backup and not adopt else ("linked", "")


def link_project(checkout):
    directory = os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
    key = repo_of(directory)
    if not key or ".." in key.split("/") or matches_exclude(key, exclude_patterns()):
        return None
    slug = project_slug(directory)
    state, detail = link_memory(checkout, CONFIG / "projects" / slug / "memory", key, slug)
    log(f"link {key}: {state}{': ' + detail if detail else ''}")
    if state == "moved":
        return f"Memory: moved unlinked notes in {slug} to {detail}; run claude-memory migrate to import them"
    return None


# --- start / end -------------------------------------------------------------


def start_git(checkout):
    deadline = time.monotonic() + PULL_SECONDS
    conflicts = []
    extra = None
    moved = None
    try:
        with locked(checkout, 5):
            try:
                abort_rebase(checkout)
                ensure_gitattributes(checkout)
                sync_excludes(checkout)
                commit_all(checkout)
                fetch_and_rebase_for_start(checkout, conflicts, deadline)
                message = f"pulled {git_text(checkout, 'rev-parse', '--short', 'HEAD')}"
            except Failure as error:
                abort_rebase(checkout)
                message = f"pull failed: {error}; using the local checkout"
            try:
                moved = link_project(checkout)
            except (Failure, OSError) as error:
                extra = f"linking failed: {error}"
    except Failure as error:
        message = f"pull skipped: {error}; using the local checkout"
    line = f"Memory: git sync, {message}"
    if conflicts:
        line += f"; {len(conflicts)} conflict(s) kept this machine's version, see MEMORY.md"
    if extra:
        line += f"; {extra}"
    log(f"start: {line[len('Memory: git sync, '):]}" + "".join(f"; conflict {c}" for c in conflicts))
    print(line)
    if moved:
        log(moved)
        print(moved)
    return 0


def fetch_and_rebase_for_start(checkout, conflicts, deadline):
    upstream = fetch_and_rebase(checkout, conflicts, max(1.0, deadline - time.monotonic()))
    if upstream is None:
        raise Failure(f"the remote has no {current_branch(checkout)} branch yet")


def end_git(checkout):
    status = 0
    conflicts = []
    try:
        with locked(checkout, LOCK_SECONDS):
            try:
                abort_rebase(checkout)
                ensure_gitattributes(checkout)
                sync_excludes(checkout)
                committed = commit_all(checkout)
                if committed or ahead_of(checkout, upstream_ref(checkout, current_branch(checkout))):
                    result = sync_remote(checkout, conflicts)
                else:
                    result = "nothing changed"
                log(f"end: {'committed, ' if committed else ''}{result}" + "".join(f"; conflict {c}" for c in conflicts))
            except Failure as error:
                abort_rebase(checkout)
                log(f"end failed: {error}; the local commit stays for the next end" + "".join(f"; conflict {c}" for c in conflicts))
                status = 1
            try:
                refresh_secrets(checkout)
            except (Failure, OSError) as error:
                log(f"failed: Secrets refresh: {error}")
    except Failure as error:
        log(f"end failed: {error}")
        return 1
    return status


# --- migrate (Mac) -----------------------------------------------------------


def migrate(sources=()):
    config = load_config()
    if not isinstance(config.get("repo"), str) or not config["repo"]:
        sys.stderr.write(f'{CLUSTER} has no "repo": nothing to migrate to\n')
        return 1
    if not EXCLUDE.exists():
        sys.stderr.write(f"create {EXCLUDE}, even empty, after deciding which repos' memories stay on this Mac\n")
        return 1
    checkout = checkout_path(config)
    try:
        if not (checkout / ".git").exists():
            if checkout.exists() and any(checkout.iterdir()):
                raise Failure(f"{checkout} exists and is not a git checkout")
            checkout.parent.mkdir(parents=True, exist_ok=True)
            result = subprocess.run(["git", "clone", "-q", config["repo"], str(checkout)], capture_output=True, text=True, env=dict(os.environ, GIT_TERMINAL_PROMPT="0"))
            if result.returncode != 0:
                lines = result.stderr.strip().splitlines() or ["failed"]
                raise Failure(f"git clone: {lines[-1]}")
        if git(checkout, "rev-parse", "--verify", "-q", "HEAD", check=False).returncode != 0:
            git(checkout, "symbolic-ref", "HEAD", "refs/heads/master")  # an empty remote: start its history as master
        files, repos, skipped = collect()
        for name, data in files.items():
            dest = checkout / name
            if not dest.exists():
                dest.parent.mkdir(parents=True, exist_ok=True)
                dest.write_bytes(data)
        imported = []
        for source in map(Path, sources):
            slug = re.sub(r"-\d{8}T\d{6}Z$", "", source.name)
            key, _ = project_repo(CONFIG / "projects" / slug)
            if not source.is_dir() or source.is_symlink():
                skipped.append(f"{source} (not a backup folder)")
            elif key is None or ".." in key.split("/") or matches_exclude(key, exclude_patterns()):
                skipped.append(f"{source} (no repo key, or kept on this machine)")
            else:
                copied, conflicts = import_notes(checkout, source, key)
                imported.append(f"{key}: {len(copied)} note(s) from {source}" + "".join(f"; conflict {c}" for c in conflicts))
                for conflict in conflicts:
                    log(f"import conflict {conflict}")
        ensure_gitattributes(checkout)
        sync_excludes(checkout)
        commit_all(checkout)
        branch = current_branch(checkout)
        if ahead_of(checkout, upstream_ref(checkout, branch)):
            git(checkout, "push", "-u", "origin", f"HEAD:refs/heads/{branch}")
        linked, already, kept = [], [], []
        for memory in sorted(p for p in (CONFIG / "projects").glob("*/memory") if os.path.lexists(p)):
            project = memory.parent
            key, _ = project_repo(project)
            if key is None or ".." in key.split("/"):
                if memory.is_symlink():
                    already.append(project.name)
                continue  # a folder with notes and no repo is already in collect()'s skipped list
            if matches_exclude(key, exclude_patterns()):
                kept.append(project.name)
                continue
            state, detail = link_memory(checkout, memory, key, project.name, adopt=True)
            if state == "skipped":
                skipped.append(f"{project.name} ({detail})")
            else:
                (linked if state == "linked" else already).append(project.name)
        sync_excludes(checkout)
        commit_all(checkout)
        if ahead_of(checkout, upstream_ref(checkout, branch)):  # notes adopted from the folders above
            git(checkout, "push", "-u", "origin", f"HEAD:refs/heads/{branch}")
    except Failure as error:
        log(f"migrate failed: {error}")
        sys.stderr.write(f"migrate failed: {error}\n")
        return 1
    hooks("--git")
    refreshed = refresh_secrets(checkout)
    notes = sum(1 for name in git_text(checkout, "ls-files", "-z").split("\0") if len(PurePosixPath(name).parts) >= 4)
    print(f"repos: {len(repos)}, notes: {notes}, folders linked: {len(linked)}, already linked: {len(already)}, kept on this machine (excluded): {len(kept)}, skipped: {len(skipped)}")
    for item in imported:
        print(f"  imported {item}")
    for item in skipped:
        print(f"  skipped: {item}")
    if refreshed != 0:
        print("  Secrets refresh failed; see the log")
    log(f"migrate: {len(repos)} repo(s), {notes} note(s), {len(linked)} linked, {len(already)} already, {len(skipped)} skipped")
    return 1 if refreshed != 0 else 0


# --- pull (cloud) ------------------------------------------------------------


def fetch():
    kube_args = cluster("--request-timeout=5s")[1]
    secret = get_secret(kube_args)
    if secret is None:
        raise Failure(f'secret "{SECRET}" not found')
    try:
        annotations = secret["metadata"]["annotations"]
        expected, pushed_at = annotations[HASH_ANNOTATION], annotations[PUSHED_AT_ANNOTATION]
        names = SECRETS[1 : int(annotations.get(CHUNKS_ANNOTATION, "1"))]
        chunks = [secret]
        if names:
            listed = json.loads(kubectl(["get", "secret", *names, "-o", "json", *kube_args]))
            by_name = {item["metadata"]["name"]: item for item in listed.get("items", [listed])}
            chunks += [by_name[name] for name in names]
        data = b"".join(base64.b64decode(chunk["data"][DATA_KEY]) for chunk in chunks)
    except (KeyError, ValueError) as error:
        raise Failure(f"corrupt archive: {error!r}")
    if sha256(data) != expected:
        raise Failure("archive hash does not match its annotation")
    files, manifest = read_archive(data)
    manifest["pushed_at"] = pushed_at

    staging = Path(tempfile.mkdtemp(prefix=".memory-sync-", dir=CONFIG))
    for name, content in files.items():
        (staging / name).parent.mkdir(parents=True, exist_ok=True)
        (staging / name).write_bytes(content)
    (staging / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
    # Swap whole directories so a session never reads a half-written tree.
    retired = CONFIG / ".memory-sync-retired"
    shutil.rmtree(retired, ignore_errors=True)
    if SNAPSHOT.exists():
        SNAPSHOT.rename(retired)
    staging.rename(SNAPSHOT)
    shutil.rmtree(retired, ignore_errors=True)


def age(pushed_at):
    pushed = datetime.datetime.strptime(pushed_at, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)
    minutes = int((datetime.datetime.now(datetime.timezone.utc) - pushed).total_seconds() // 60)
    if minutes < 120:
        return f"{minutes} min"
    if minutes < 48 * 60:
        return f"{minutes // 60} h"
    return f"{minutes // (24 * 60)} days"


def context():
    manifest = json.loads((SNAPSHOT / "manifest.json").read_text())
    pushed_at = manifest["pushed_at"]
    lines = [
        f"## Mac memory snapshot (read-only, pushed {pushed_at}, {age(pushed_at)} ago)",
        f"Other projects: {SNAPSHOT}/<host>/<owner>/<repo>/ — search there when relevant.",
        "This session cannot add memories; tell the user what is worth remembering.",
    ]
    repo = repo_of(os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd())
    memory = SNAPSHOT / repo / "MEMORY.md" if repo else None
    if memory and memory.is_file():
        text = memory.read_bytes()[:CONTEXT_BYTES].decode(errors="ignore")
        notes = text.splitlines(keepends=True)[:CONTEXT_LINES]
        lines += ["", f"Memory for {repo} (topic files are next to it in {memory.parent}/):", "", "".join(notes).rstrip("\n")]
    return "\n".join(lines)


def refresh():
    """Replaces the installed copy with the one at SOURCE; True when it changed."""
    me = Path(__file__).resolve()
    if os.environ.get("CLAUDE_MEMORY_REFRESHED") or me != INSTALLED.resolve():
        return False
    try:
        with urllib.request.urlopen(SOURCE, timeout=5) as response:
            current = response.read()
        compile(current, str(me), "exec")
    except Exception:  # an unreachable or broken source leaves this copy in charge
        return False
    if current == me.read_bytes():
        return False
    staged = me.with_name(".claude-memory.new")
    staged.write_bytes(current)
    staged.chmod(0o755)
    os.replace(staged, me)
    return True


def pull():
    problem = None
    try:
        fetch()
    except Exception as error:  # a session must start whatever goes wrong here
        problem = str(error) if isinstance(error, Failure) else f"{type(error).__name__}: {error}"
    if problem:
        print(f"Mac memory snapshot unavailable: {problem}; mention this to the user.")
    if (SNAPSHOT / "manifest.json").exists():
        if problem:
            print("Using the earlier snapshot already in this container:\n")
        print(context())
    return 0


# --- hooks -------------------------------------------------------------------


def hooks(flag):
    path = CONFIG / "settings.json"
    settings = json.loads(path.read_text()) if path.exists() else {}
    entries = HOOK_COMMANDS[flag]
    # --git also retires the older SessionStart pull and SessionEnd push of a machine that had them.
    events = {event for event, _, _ in entries} | ({"SessionStart", "SessionEnd"} if flag != "--cloud" else set())
    for event in sorted(events):
        groups = settings.setdefault("hooks", {}).setdefault(event, [])
        for group in groups:
            group["hooks"] = [h for h in group.get("hooks", []) if "claude-memory " not in h.get("command", "")]
        groups[:] = [group for group in groups if group["hooks"]]
    for event, command, timeout in entries:
        hook = {"type": "command", "command": command}
        if timeout:
            hook["timeout"] = timeout
        settings["hooks"][event].append({"hooks": [hook]})
    path.write_text(json.dumps(settings, indent=2) + "\n")
    return 0


def background(command):
    # A SessionEnd hook must return at once; the work may wait on the cluster or a lock.
    subprocess.Popen([sys.executable, os.path.abspath(__file__), command], start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


def reexec_if_updated(command):
    if refresh():
        os.execve(sys.executable, [sys.executable, str(INSTALLED), command], {**os.environ, "CLAUDE_MEMORY_REFRESHED": "1"})


def start():
    checkout = git_checkout()
    if checkout is None:
        if platform.system() == "Darwin":
            return 0  # the Mac's own folders are the writable store until migrate: no read-only context
        reexec_if_updated("start")
        return pull()
    try:
        return start_git(checkout)
    except Exception as error:  # a session must start whatever goes wrong here
        log(f"start failed: {type(error).__name__}: {error}")
        print(f"Memory: git sync failed: {error}")
        return 0


def end():
    checkout = git_checkout()
    if checkout is not None:
        return end_git(checkout)
    if platform.system() == "Darwin":
        return push()  # a Mac without a usable checkout (not yet migrated, "repo" set or not) keeps publishing its project folders
    return 0


def main(argv):
    command, options = (argv[0], argv[1:]) if argv else (None, [])
    if command == "push" and options in ([], ["--background"]):
        return background("push") if options else push()
    if command == "end" and options in ([], ["--background"]):
        return background("end") if options else end()
    if command == "pull" and not options:
        reexec_if_updated("pull")
        return pull()
    if command == "start" and not options:
        return start()
    if command == "migrate" and len(options) % 2 == 0 and options[::2] == ["--from"] * (len(options) // 2):
        return migrate(options[1::2])
    if command == "hooks" and len(options) == 1 and options[0] in HOOK_COMMANDS:
        return hooks(options[0])
    sys.stderr.write(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
