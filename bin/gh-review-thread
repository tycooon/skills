#!/usr/bin/env python3
"""Reply to or resolve a GitHub review thread for an allowed repository owner."""

import json
from pathlib import Path
import re
import subprocess
import sys

MARKER = "<!-- posted-by-agent -->"
OWNER_QUERY = """query($thread: ID!) {
  node(id: $thread) {
    ... on PullRequestReviewThread {
      pullRequest { repository { owner { login } } }
    }
  }
}"""
REPLY = """mutation($thread: ID!, $body: String!) {
  addPullRequestReviewThreadReply(input: {
    pullRequestReviewThreadId: $thread, body: $body
  }) { comment { id } }
}"""
RESOLVE = """mutation($thread: ID!) {
  resolveReviewThread(input: {threadId: $thread}) { thread { id isResolved } }
}"""


def fail(code, message):
    print(f"gh-review-thread: {message}", file=sys.stderr)
    raise SystemExit(code)


def api(query, variables):
    try:
        result = subprocess.run(
            ["gh", "api", "graphql", "--hostname", "github.com", "--input", "-"],
            input=json.dumps({"query": query, "variables": variables}),
            text=True, capture_output=True,
        )
        if result.returncode:
            fail(4, result.stderr.strip() or result.stdout.strip() or "gh API failed")
        response = json.loads(result.stdout)
        if response.get("errors"):
            fail(4, json.dumps(response["errors"]))
        return response["data"]
    except (OSError, ValueError, KeyError, TypeError, AttributeError) as error:
        fail(4, f"invalid API response or failed API command: {error}")


def main():
    args = sys.argv[1:]
    if not (len(args) == 2 and args[0] == "resolve" or
            len(args) == 3 and args[0] == "reply"):
        fail(2, "usage: gh-review-thread reply THREAD_ID BODY_FILE | resolve THREAD_ID")
    verb, thread = args[:2]
    if not re.fullmatch(r"PRRT_[A-Za-z0-9_-]+", thread):
        fail(2, "THREAD_ID must be a GitHub PRRT_ node id")
    body = None
    if verb == "reply":
        path = Path(args[2])
        try:
            if not path.is_file():
                fail(2, "BODY_FILE must be a regular file")
            with path.open(encoding="utf-8", newline="") as source:
                body = source.read()
        except (OSError, ValueError) as error:
            fail(2, f"cannot read BODY_FILE: {error}")
        if not body.strip():
            fail(2, "BODY_FILE must not be empty")
        if not body.rstrip().endswith(MARKER):
            body += "\n" + MARKER

    owners_file = Path.home() / ".config/gh-review-thread/owners"
    try:
        owners = {line.strip().casefold() for line in owners_file.read_text(encoding="utf-8").splitlines() if line.strip()}
    except (OSError, ValueError) as error:
        fail(3, f"refused: cannot read owner allowlist {owners_file}: {error}")
    if not owners:
        fail(3, f"refused: owner allowlist {owners_file} is empty")
    variables = {"thread": thread}
    data = api(OWNER_QUERY, variables)
    try:
        owner = data["node"]["pullRequest"]["repository"]["owner"]["login"]
        if not isinstance(owner, str) or not owner:
            raise ValueError("missing repository owner")
    except (KeyError, TypeError, ValueError) as error:
        fail(4, f"cannot read thread repository owner: {error}")
    if owner.casefold() not in owners:
        fail(3, f"refused: owner {owner!r} is not listed in {owners_file}")

    if verb == "reply":
        data = api(REPLY, dict(variables, body=body))
        try:
            comment_id = data["addPullRequestReviewThreadReply"]["comment"]["id"]
            if not isinstance(comment_id, str) or not comment_id:
                raise ValueError("missing comment id")
        except (KeyError, TypeError, ValueError) as error:
            fail(4, f"invalid reply response: {error}")
        print(comment_id)
    else:
        data = api(RESOLVE, variables)
        try:
            resolved = data["resolveReviewThread"]["thread"]
            if resolved["id"] != thread or resolved["isResolved"] is not True:
                raise ValueError("thread was not resolved")
        except (KeyError, TypeError, ValueError) as error:
            fail(4, f"invalid resolve response: {error}")
        print("resolved")


if __name__ == "__main__":
    main()
