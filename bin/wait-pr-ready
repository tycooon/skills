#!/usr/bin/env python3
"""Wait until a GitHub PR is ready to merge, then exit with the reason.

  wait-pr-ready <pr-url> [--head SHA] [--no-ci] [--reviewer LOGIN]... [--after TIME] [--known-conflict]
  wait-pr-ready <pr-url> --until-review [--head SHA]

Run it as one background shell command: the agent's session resumes when it
exits. It only detects readiness and never changes the PR. Ready means all four
of babysit-pr's conditions hold on the same head: the external AI reviewer's
newest verdict approves the head (or a head it differs from only by a
base-sync, read against the base the PR had when the verdict was posted), every check on the head is green, no review thread is unresolved,
and the base allows the merge (CLEAN, or UNSTABLE/HAS_HOOKS).

Exit codes:
  0  ready; the line ends with the PR's activity mark, for --after
  10 merged
  11 closed without merging
  12 the head moved away from the one being watched
  13 about 4 hours passed with no activity on the PR
  14 a review, comment or review thread landed. With --until-review, any; while
     waiting for readiness, one that leaves the PR not ready (findings), so a
     session wakes for them even where nothing else relays them. An AI
     reviewer's approval covering the head, with no thread open, is no finding
     while checks are still running or GitHub still computes mergeability: the
     wait goes on
  15 the watched head conflicts with the base: nothing else resolves it, so the
     session runs its fix round (address-pr, or the Codex resume that owns the PR).
     Not with --known-conflict
  2  usage error, an unsupported host, or the PR could not be read for too long

Options:
  --head SHA        the head to watch, e.g. the commit just pushed. Without it,
                    the head the first read sees.
  --no-ci           the repository has no CI at all, so skip the checks gate.
                    Without it, a head with no checks counts as having none to
                    pass when the repository has no Actions workflow, or when
                    none of its workflows ran for the head CI_SETTLE after the
                    waiter first saw it (path filters that matched nothing).
  --reviewer LOGIN  an account whose reviews count as the AI reviewer's even
                    without an identity line. Repeatable.
  --after TIME      report ready only once the PR has activity newer than TIME
                    (ISO 8601), e.g. the mark of a ready that a recheck refused.
                    With --until-review: a review or comment posted after TIME
                    counts as new, even one the first read already sees.
  --until-review    don't wait for readiness: exit 14 on the first review,
                    comment or review thread the first read didn't have.
  --known-conflict  the session already ran a round on this head's conflict and
                    left it in place: don't exit 15 for it again, wait for the
                    head to move (12) or the PR to change otherwise.
"""

import argparse
import json
import re
import subprocess
import sys
import time
from datetime import datetime, timezone

# Waits after a read that saw no new activity: 1, 1, 2, 2, then 5 minutes. A
# reviewer or CI run usually lands within minutes; one GraphQL read per wait
# keeps even the 1-minute rungs far inside the API's hourly budget.
BACKOFF = [60, 60, 120, 120, 300]
QUIET_LIMIT = 4 * 3600
# Wait after a failed read. Kept apart from BACKOFF so MAX_FAILED_READS still
# tolerates about 15 minutes of fast failures (a GitHub blip, a laptop waking).
RETRY_WAIT = 180
# A pushed head can take a moment to show up on the PR.
HEAD_SETTLE = 600
# Actions creates a push's workflow runs within seconds. A head with no run this
# long after the waiter first saw it triggered none: its paths matched no
# workflow's filters, and no check will ever report on it.
CI_SETTLE = 600
MAX_FAILED_READS = 6

QUERY = """
query($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      state
      headRefOid
      baseRefName
      updatedAt
      mergeable
      mergeStateStatus
      timelineItems(itemTypes: [BASE_REF_CHANGED_EVENT, AUTOMATIC_BASE_CHANGE_SUCCEEDED_EVENT], last: 20) {
        nodes {
          ... on BaseRefChangedEvent { createdAt previousRefName }
          ... on AutomaticBaseChangeSucceededEvent { createdAt oldBase }
        }
      }
      reviewThreads(first: 100) { totalCount nodes { isResolved } }
      reviews(last: 50) {
        totalCount
        nodes { author { login } state body submittedAt commit { oid } }
      }
      comments(last: 50) {
        totalCount
        nodes { author { login } body createdAt }
      }
      commits(last: 1) {
        nodes {
          commit {
            oid
            committedDate
            statusCheckRollup {
              contexts(first: 100) {
                nodes {
                  __typename
                  ... on CheckRun { name status conclusion completedAt }
                  ... on StatusContext { context state createdAt }
                }
              }
            }
          }
        }
      }
    }
  }
}
"""

# review-pr's verdicts carry an identity line ("AI reviewer: Claude."); a teammate's
# Approve, or a person merely naming an agent, does not.
IDENTITY = re.compile(r"\bAI reviewer\b", re.I)
MERGEABLE_STATES = {"CLEAN", "HAS_HOOKS", "UNSTABLE"}
GO_SIGNAL = re.compile(r"^\W*(approved|lgtm|ship it)\b|\bAPPROVED\b|\bLGTM\b", re.I)
NO_GO = re.compile(r"\bnot (yet )?(approv|lgtm)|\bunapprov|\bwithout approv", re.I)
SHA = re.compile(r"\b[0-9a-f]{40}\b")
GREEN_CONCLUSIONS = {"SUCCESS", "NEUTRAL", "SKIPPED"}


def parse_url(url):
    m = re.fullmatch(r"https://github\.com/([^/]+)/([^/]+)/pull/(\d+)/?", url.strip())
    if not m:
        return None
    return m.group(1), m.group(2), int(m.group(3))


def ts(value):
    return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp() if value else 0.0


def gh(args, stdin=None):
    return subprocess.run(["gh", *args], input=stdin, capture_output=True, text=True, timeout=120)


def read_pr(owner, name, number):
    r = gh(["api", "graphql", "-f", f"query={QUERY}", "-F", f"owner={owner}", "-F", f"name={name}", "-F", f"number={number}"])
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or "gh api graphql failed")
    pr = json.loads(r.stdout)["data"]["repository"]["pullRequest"]
    if pr is None:
        raise RuntimeError("no such pull request")
    return pr


def authored_lines(owner, name, base, sha):
    """The PR's own added and removed lines at sha, as review-pr's base-sync test reads them."""
    r = gh(["api", "-H", "Accept: application/vnd.github.diff", f"repos/{owner}/{name}/compare/{base}...{sha}"])
    if r.returncode != 0:
        return None
    lines, path, header = [], None, False
    for line in r.stdout.splitlines():
        if line.startswith("diff --git "):
            path, header = line.split(" ")[2], True
        elif line.startswith("@@"):
            header = False
        elif not header and line[:1] in "+-":
            lines.append(f"{path} {line}")
    return lines


def base_at(pr, at):
    """The base branch the PR had at time `at`.

    A stacked PR retargeted after its base merged (by hand, or by GitHub when
    the base branch goes) has a new base, and its old head's diff against that
    base also carries the merged base PR, so a verdict on the old head is read
    against the base it was posted under.
    """
    events = [e for e in (pr.get("timelineItems") or {}).get("nodes") or [] if e and ts(e["createdAt"]) > ts(at)]
    if events:
        first = min(events, key=lambda e: ts(e["createdAt"]))
        return first.get("previousRefName") or first["oldBase"]
    return pr["baseRefName"]


MERGED_HEAD_QUERY = """
query($owner: String!, $name: String!, $branch: String!) {
  repository(owner: $owner, name: $name) {
    pullRequests(headRefName: $branch, states: MERGED, last: 1) { nodes { headRefOid } }
  }
}
"""


def merged_branch_tip(owner, name, branch):
    """The last head of the merged PR from `branch`: what a base branch deleted on merge pointed at."""
    r = gh(["api", "graphql", "-f", f"query={MERGED_HEAD_QUERY}", "-F", f"owner={owner}", "-F", f"name={name}", "-F", f"branch={branch}"])
    if r.returncode != 0:
        return None
    nodes = json.loads(r.stdout)["data"]["repository"]["pullRequests"]["nodes"]
    return nodes[0]["headRefOid"] if nodes else None


def workflow_count(owner, name):
    r = gh(["api", f"repos/{owner}/{name}/actions/workflows", "--jq", ".total_count"])
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or "gh api actions/workflows failed")
    return int(r.stdout)


def workflow_runs(owner, name, sha):
    r = gh(["api", f"repos/{owner}/{name}/actions/runs?head_sha={sha}&per_page=1", "--jq", ".total_count"])
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or "gh api actions/runs failed")
    return int(r.stdout)


def has_checks(pr):
    rollup = pr["commits"]["nodes"][0]["commit"]["statusCheckRollup"] if pr["commits"]["nodes"] else None
    return bool(rollup and rollup["contexts"]["nodes"])


def checks_state(pr, no_ci):
    """no_ci is False, True (--no-ci) or the reason a head has no checks to wait for."""
    if no_ci:
        return True, no_ci if isinstance(no_ci, str) else "no CI"
    rollup = pr["commits"]["nodes"][0]["commit"]["statusCheckRollup"] if pr["commits"]["nodes"] else None
    contexts = rollup["contexts"]["nodes"] if rollup else []
    if not contexts:
        return False, "no checks reported yet"
    waiting = []
    for c in contexts:
        if c["__typename"] == "CheckRun":
            if c["status"] != "COMPLETED" or c["conclusion"] not in GREEN_CONCLUSIONS:
                waiting.append(f"{c['name']}={c['conclusion'] or c['status']}")
        elif c["state"] != "SUCCESS":
            waiting.append(f"{c['context']}={c['state']}")
    if waiting:
        return False, "checks not green: " + ", ".join(waiting[:5])
    return True, f"{len(contexts)} checks green"


def checks_still_running(pr):
    """Whether the checks gate is unmet only because checks are still to report: none has failed."""
    rollup = pr["commits"]["nodes"][0]["commit"]["statusCheckRollup"] if pr["commits"]["nodes"] else None
    for c in (rollup["contexts"]["nodes"] if rollup else []):
        if c["__typename"] == "CheckRun":
            if c["status"] == "COMPLETED" and c["conclusion"] not in GREEN_CONCLUSIONS:
                return False
        elif c["state"] not in ("SUCCESS", "PENDING", "EXPECTED"):
            return False
    return True


def posts(pr):
    """Reviews and comments: (key, author, body, posted_at, review_state, commit)."""
    out = []
    for r in pr["reviews"]["nodes"]:
        login = (r["author"] or {}).get("login")
        out.append((("review", login, r["submittedAt"]), r["author"], r["body"] or "", r["submittedAt"], r["state"], (r["commit"] or {}).get("oid")))
    for c in pr["comments"]["nodes"]:
        login = (c["author"] or {}).get("login")
        out.append((("comment", login, c["createdAt"]), c["author"], c["body"] or "", c["createdAt"], None, None))
    return out


def is_thread_reply(body, state):
    # A thread reply shows up as a bodiless COMMENTED review; it is no verdict.
    return not body.strip() and state != "APPROVED"


def is_go(body, state):
    return state == "APPROVED" or (state != "CHANGES_REQUESTED" and bool(GO_SIGNAL.search(body)) and not NO_GO.search(body))


def is_reviewer(author, body, reviewers):
    return bool(author) and (author["login"] in reviewers or bool(IDENTITY.search(body)))


def verdicts(pr, reviewers):
    """Each AI reviewer's newest verdict-bearing post: (login, is_go, named_sha, posted_at)."""
    newest = {}
    for _, author, body, at, state, commit in posts(pr):
        if not is_reviewer(author, body, reviewers) or is_thread_reply(body, state):
            continue
        login = author["login"]
        named = SHA.findall(body)
        sha = named[-1] if named else commit
        if login not in newest or ts(at) >= ts(newest[login][3]):
            newest[login] = (login, is_go(body, state), sha, at)
    return list(newest.values())


def only_approvals(pr, seen, *, no_ci, reviewers, same_authored_lines):
    """Whether the posts not in `seen` leave the session nothing to do.

    That holds when each is an AI reviewer's go verdict or a thread reply, the
    approval covers the head, no thread is open, and what still holds the PR
    back clears on its own: checks still running, or mergeability GitHub is
    still computing. A failed check, a BEHIND or BLOCKED base, or a verdict the
    approval gate doesn't count still wakes the session, as nothing else may.
    """
    unresolved = sum(1 for t in pr["reviewThreads"]["nodes"] if not t["isResolved"])
    if unresolved or not approval_state(pr, reviewers, same_authored_lines)[0]:
        return False
    if not (checks_state(pr, no_ci)[0] or checks_still_running(pr)):
        return False
    if not (pr["mergeStateStatus"] in MERGEABLE_STATES and pr["mergeable"] == "MERGEABLE") and pr["mergeable"] != "UNKNOWN":
        return False
    for key, author, body, _, state, _ in posts(pr):
        if key in seen or is_thread_reply(body, state):
            continue
        if not (is_reviewer(author, body, reviewers) and is_go(body, state)):
            return False
    return True


def approval_state(pr, reviewers, same_authored_lines):
    head = pr["headRefOid"]
    head_date = ts(pr["commits"]["nodes"][0]["commit"]["committedDate"]) if pr["commits"]["nodes"] else 0
    found = verdicts(pr, reviewers)
    for login, go, sha, at in found:
        if not go:
            continue
        if sha == head or (sha is None and ts(at) >= head_date):
            return True, f"approved by {login} on {head[:12]}"
        if sha and same_authored_lines(sha, head, at):
            return True, f"approved by {login} on {sha[:12]}, a base-sync of {head[:12]}"
    if not found:
        return False, "no AI reviewer verdict yet"
    return False, "no AI reviewer approval covering " + head[:12]


def evaluate(pr, *, no_ci, reviewers, same_authored_lines):
    """Returns (ready, reasons) for one read of the PR."""
    gates = [
        approval_state(pr, reviewers, same_authored_lines),
        checks_state(pr, no_ci),
    ]
    unresolved = sum(1 for t in pr["reviewThreads"]["nodes"] if not t["isResolved"])
    gates.append((unresolved == 0, f"{unresolved} unresolved threads"))
    mergeable, status = pr["mergeable"], pr["mergeStateStatus"]
    gates.append((mergeable == "MERGEABLE" and status in MERGEABLE_STATES, f"mergeable={mergeable}/{status}"))
    return all(ok for ok, _ in gates), [why for _, why in gates]


def review_count(pr):
    return sum(pr[k].get("totalCount", len(pr[k]["nodes"])) for k in ("reviews", "comments", "reviewThreads"))


def newest_review_time(pr):
    posts = [r["submittedAt"] for r in pr["reviews"]["nodes"]] + [c["createdAt"] for c in pr["comments"]["nodes"]]
    return max((ts(t) for t in posts), default=0.0)


def activity_mark(pr):
    marks = [ts(pr["updatedAt"])]
    for node in pr["commits"]["nodes"]:
        rollup = node["commit"]["statusCheckRollup"]
        for c in (rollup["contexts"]["nodes"] if rollup else []):
            marks.append(ts(c.get("completedAt") or c.get("createdAt")))
    return max(marks)


def iso(t):
    return datetime.fromtimestamp(t, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def main(argv=None, now=time.time, sleep=time.sleep):
    parser = argparse.ArgumentParser(add_help=True, description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("url")
    parser.add_argument("--head")
    parser.add_argument("--no-ci", action="store_true")
    parser.add_argument("--reviewer", action="append", default=[])
    parser.add_argument("--after", type=ts, default=0.0)
    parser.add_argument("--until-review", action="store_true")
    parser.add_argument("--known-conflict", action="store_true")
    args = parser.parse_args(argv)

    target = parse_url(args.url)
    if not target:
        print(f"unsupported: {args.url} is not a GitHub PR URL; GitLab MRs are watched by babysit-pr's polling", file=sys.stderr)
        return 2
    owner, name, number = target
    started = now()
    state = {"expected": args.head, "head_seen": args.head is None, "reviews": None, "seen_at": {}, "workflows": None}
    lines_cache = {}

    def lines(base, sha, current_base):
        if (base, sha) not in lines_cache:
            found = authored_lines(owner, name, base, sha)
            if found is None and base != current_base:
                # A base branch deleted when its PR merged: read against that PR's last head.
                tip = merged_branch_tip(owner, name, base)
                found = authored_lines(owner, name, tip, sha) if tip else None
            lines_cache[base, sha] = found
        return lines_cache[base, sha]

    def same_authored_lines(pr, old, new, at):
        """old's lines against the base its verdict was posted under, new's against today's."""
        current = pr["baseRefName"]
        before = lines(base_at(pr, at), old, current)
        return before is not None and before == lines(current, new, current)

    def without_checks(pr, head):
        """Why the head has no checks to wait for, or False while some may still come."""
        if args.no_ci:
            return True
        if has_checks(pr):
            return False
        if state["workflows"] is None:
            state["workflows"] = workflow_count(owner, name)
        if state["workflows"] == 0:
            return "no CI: the repository has no Actions workflow"
        if now() - state["seen_at"].setdefault(head, now()) < CI_SETTLE:
            return False
        if workflow_runs(owner, name, head) == 0:
            return f"no CI for this head: no workflow ran in {CI_SETTLE // 60} min (path filters)"
        return False

    def read_once():
        """One read: (exit code, line) to stop, or (None, waiting reason) and the activity mark."""
        pr = read_pr(owner, name, number)
        head = pr["headRefOid"]
        if pr["state"] == "MERGED":
            return (10, f"merged: {args.url}"), 0
        if pr["state"] == "CLOSED":
            return (11, f"closed without merging: {args.url}"), 0
        if state["expected"] is None:
            state["expected"] = head
        # An abbreviated --head names the PR's head once that head starts with it.
        if len(state["expected"]) < 40 and head.startswith(state["expected"].lower()):
            state["expected"] = head
        if head == state["expected"]:
            state["head_seen"] = True
        elif state["head_seen"]:
            return (12, f"head changed: {args.url} moved from {state['expected']} to {head}"), 0
        elif now() - started > HEAD_SETTLE:
            return (12, f"head changed: {args.url} is at {head}, not the expected {state['expected']}"), 0
        mark = activity_mark(pr)
        # GitHub reports UNKNOWN while it recomputes and CONFLICTING only once
        # it has tried the merge, so one CONFLICTING read on the watched head
        # is final for that head.
        if state["head_seen"] and pr["mergeable"] == "CONFLICTING" and not args.known_conflict:
            return (15, f"conflict: {args.url} at {head} conflicts with {pr['baseRefName']}"), mark
        if state["reviews"] is None:
            state["reviews"] = review_count(pr)
            state["seen"] = {key for key, *_ in posts(pr)}
        new_reviews = review_count(pr) > state["reviews"]
        if args.until_review:
            # A thread opens with a review, so the time test covers threads too.
            if new_reviews or (args.after and newest_review_time(pr) > args.after):
                return (14, f"review activity: a review, comment or thread landed on {args.url} at {head}"), mark
            return (None, "no new review activity"), mark
        if not state["head_seen"]:
            return (None, f"head {state['expected'][:12]} not on the PR yet"), mark
        gates = {"no_ci": without_checks(pr, head), "reviewers": set(args.reviewer), "same_authored_lines": lambda o, n, at: same_authored_lines(pr, o, n, at)}
        ready, reasons = evaluate(pr, **gates)
        if ready and mark <= args.after:
            ready = False
            reasons.append(f"no activity since {iso(args.after)}")
        if ready:
            return (0, f"ready: {args.url} at {head}: " + "; ".join(reasons) + f"; activity {iso(mark)}"), mark
        if new_reviews and not only_approvals(pr, state["seen"], **gates):
            return (14, f"review activity: a review, comment or thread landed on {args.url} at {head}, not ready: " + "; ".join(reasons)), mark
        return (None, "; ".join(reasons)), mark

    mark, step, failures, waiting = 0.0, 0, 0, "nothing read yet"
    while True:
        try:
            (code, line), latest = read_once()
            failures = 0
        except (RuntimeError, subprocess.SubprocessError, ValueError, KeyError, TypeError, IndexError) as e:
            failures += 1
            if failures >= MAX_FAILED_READS:
                print(f"error: could not read {args.url} {failures} times in a row: {e}")
                return 2
            print(f"read failed ({e}); retrying", file=sys.stderr)
            code, latest = None, 0.0
        else:
            if code is not None:
                print(line)
                return code
            waiting = line
            print(f"{datetime.now(timezone.utc):%H:%M:%SZ} waiting: {waiting}", file=sys.stderr)

        latest = max(latest, started)
        if latest > mark:
            mark, step = latest, 0
        if now() - mark > QUIET_LIMIT:
            print(f"quiet: no activity on {args.url} for {int((now() - mark) / 3600)}h; still waiting: {waiting}")
            return 13
        sleep(RETRY_WAIT if failures else BACKOFF[min(step, len(BACKOFF) - 1)])
        if not failures:
            step += 1


if __name__ == "__main__":
    sys.exit(main())
