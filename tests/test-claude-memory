        (b.memory / "mine.md").write_text("mine\n")
        rival = self.root_clone()
        calls = {"fetch": 0}
        with unittest.mock.patch.dict(os.environ, b.env):
            module = load_module()
        original = module.git

        def racing(checkout, *args, **kwargs):
            result = original(checkout, *args, **kwargs)
            if args[0] == "fetch":
                calls["fetch"] += 1
                if calls["fetch"] == 1:
                    (rival / KEY / "rival.md").write_text("rival\n")
                    git(rival, "add", "-A")
                    git(rival, "-c", "user.name=r", "-c", "user.email=r@r", "commit", "-q", "-m", "rival")
                    git(rival, "push", "-q", "origin", "HEAD:master")
            return result

        module.git = racing
        with unittest.mock.patch.dict(os.environ, b.env):
            self.assertEqual(module.end(), 0)
        self.assertEqual(calls["fetch"], 2)
        self.assertEqual(self.remote_file(f"{KEY}/mine.md"), "mine")
        self.assertEqual(self.remote_file(f"{KEY}/rival.md"), "rival")

    def root_clone(self):
        path = self.a.root / "rival"
        subprocess.run(["git", "clone", "-q", str(self.bare), str(path)], check=True, capture_output=True)
        return path


