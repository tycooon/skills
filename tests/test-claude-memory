class GitMode(unittest.TestCase):
    """Two machines (sandboxes) sharing one local bare repo."""

    def setUp(self):
        self.boxes = []
        self.bare = None
        a = self.machine()
        self.bare = a.root / "remote.git"
        subprocess.run(["git", "init", "-q", "--bare", "-b", "master", str(self.bare)], check=True)
        self.a = a
        self.configure(a)

    def tearDown(self):
        for box in self.boxes:
            for path in [box.config / "memory-repo"]:
                if path.exists():
                    path.chmod(0o755)
            box.close()

    def machine(self):
        box = Sandbox()
        self.boxes.append(box)
        box.app = box.checkout("app", "git@github.com:acme/app.git")
        box.env["CLAUDE_PROJECT_DIR"] = str(box.app)
        box.env["GIT_CONFIG_GLOBAL"] = "/dev/null"  # no identity: the tool supplies its own
        box.env["GIT_CONFIG_SYSTEM"] = "/dev/null"
        box.slug = re.sub(r"[^A-Za-z0-9]", "-", str(box.app))
        box.memory = box.config / "projects" / box.slug / "memory"
        box.repo = box.config / "memory-repo"
        return box

    def configure(self, box):
        config = json.loads((box.config / "memory-sync.json").read_text())
        config["repo"] = str(self.bare)
        (box.config / "memory-sync.json").write_text(json.dumps(config))

    def second(self):
        box = self.machine()
        self.configure(box)
