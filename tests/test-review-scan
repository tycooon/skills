    def test_commands_wait_for_the_same_watch_lock(self):
        self.activity[PR1] = act()
        commands = [("pause", self.watch), ("resume", self.watch), ("tick", self.watch, "--dry-run"),
                    ("settle", self.watch, PR1, "--head", A, *SINCE), ("nudge", PR1, "--head", B)]
        for args in commands:
            with self.subTest(command=args[0]):
                self.cli("pause", self.watch)
                attempted, done = threading.Event(), threading.Event()
                results, errors = [], []
                real_flock = rs.fcntl.flock

                def flock(fd, operation):
                    attempted.set()
                    return real_flock(fd, operation)

                def run():
                    try:
                        results.append(rs.main(list(args)))
                    except BaseException as error:
                        errors.append(error)
                    finally:
                        done.set()

                worker = threading.Thread(target=run, daemon=True)
                with contextlib.redirect_stdout(io.StringIO()):
                    try:
                        with rs.Watch(self.watch).locked():
                            before = self.prs()
                            with patch.object(rs.fcntl, "flock", side_effect=flock):
                                worker.start()
                                self.assertTrue(attempted.wait(2), "command did not take the watch lock")
                                self.assertFalse(done.is_set(), "command bypassed the held lock")
                                self.assertEqual(self.prs(), before)
                    finally:
                        worker.join(2)
                self.assertFalse(worker.is_alive())
                self.assertEqual(errors, [])
                self.assertEqual(results, [0])

    def test_tick_already_holding_lock_finishes_before_pause_returns(self):
        attempted, done = threading.Event(), threading.Event()
        errors = []
        real_flock = rs.fcntl.flock

        def pause():
            try:
                rs.main(["pause", self.watch])
            except BaseException as error:
                errors.append(error)
            finally:
                done.set()

        worker = threading.Thread(target=pause, daemon=True)

        def flock(fd, operation):
            if threading.current_thread() is worker:
                attempted.set()
            return real_flock(fd, operation)

        def spawn(w, url, brief):
            self.spawn(w, url, brief)
            if url == PR1:
                worker.start()
                self.assertTrue(attempted.wait(2))
                self.assertFalse(done.is_set())

        with contextlib.redirect_stdout(io.StringIO()), patch.object(rs.fcntl, "flock", side_effect=flock):
            try:
                self.assertEqual(rs.cmd_tick(self.tick_args(self.watch), spawn=spawn), 0)
            finally:
                if worker.ident is not None:
                    worker.join(2)
        self.assertFalse(worker.is_alive())
        self.assertEqual(errors, [])
        self.assertTrue(done.is_set())
        self.assertEqual([u for u, _ in self.spawned], [PR1, PR2])
        self.spawned.clear()
        self.assertEqual(self.cli("tick", self.watch)[0], 0)
        self.assertEqual(self.spawned, [])


