def full_pr(threads=()):
    """The PR as wait-pr-ready reads it: our formal approval of A, with a finding thread at each (path, line)."""
    finding = {"author": {"login": "review-bot"}, "pullRequestReview": {"id": "r1", "state": "APPROVED"}}
    return {"headRefOid": B, "baseRefName": "master", "timelineItems": {"nodes": []},
            "reviews": {"nodes": [{"id": "r1", "author": {"login": "review-bot"}, "state": "APPROVED", "body": "",
                                   "submittedAt": "2026-10-23T09:00:00Z", "commit": {"oid": A}}]},
            "comments": {"nodes": []},
            "reviewThreads": {"nodes": [{"isResolved": False, "path": path, "line": line, "originalLine": line,
                                         "diffSide": "RIGHT", "comments": {"nodes": [finding]}}
                                        for path, line in threads]}}


class Settle(Base):
    def setUp(self):
        super().setUp()
        # wait-pr-ready's reads, for the covering test settle runs on --covered-by: B a base-sync of A.
        wpr = rs.wait_pr_ready()
        self.full, self.lines, self.hunks = full_pr(), {A: ["f +x"], B: ["f +x"]}, {}
        for name, fake in {"read_pr": lambda owner, name, number: self.full,
                           "authored_lines": lambda owner, name, base, sha: self.lines[sha],
                           "changed_hunks": lambda owner, name, old, new: self.hunks}.items():
            self.addCleanup(setattr, wpr, name, getattr(wpr, name))
            setattr(wpr, name, fake)
        self.cli("tick", self.watch)

    def test_refuses_when_head_moved(self):
        self.activity[PR1] = act(head=B)
        code, _ = self.cli("settle", self.watch, PR1, "--head", A, *SINCE)
        self.assertEqual(code, 3)
        self.assertNotIn("settled", self.prs()[PR1])

    def test_refuses_when_someone_else_posted_during_the_run(self):
        self.activity[PR1] = act(authors={"review-bot", "author"})
        code, out = self.cli("settle", self.watch, PR1, "--head", A, *SINCE)
        self.assertEqual(code, 4)
        self.assertIn("author", out)

