                    for attempt in range(12):
                        now = rs.parse_time("2026-10-23T12:00:00Z") + rs.dt.timedelta(minutes=2 * attempt)
                        with patch.object(rs, "now_utc", return_value=now), self.assertRaises(OSError):
                            rs.spawn_run(self.w, PR1, "failed brief")
                    self.assertEqual(list(self.w.runs.rglob("*.*")), [])

    def test_repeated_popen_failures_remove_only_the_failed_runs_files(self):
        for runner in ("claude", "codex"):
            with self.subTest(runner=runner):
                self.w.config["runner"] = runner
                self.w.config["reviewer_model"] = "sonnet" if runner == "claude" else "gpt-6-astra"
                url = PR1 if runner == "claude" else PR2
                rs.spawn_run(self.w, url, "preserved brief")
                before = {path: path.read_bytes() for path in self.w.runs.rglob("*.*")}
                with patch.object(rs.subprocess, "Popen", side_effect=OSError("cannot start")):
                    for attempt in range(12):
                        now = rs.parse_time("2026-10-23T12:02:00Z") + rs.dt.timedelta(minutes=2 * attempt)
                        with patch.object(rs, "now_utc", return_value=now), self.assertRaisesRegex(OSError, "cannot start"):
                            rs.spawn_run(self.w, url, "failed brief")
                after = {path: path.read_bytes() for path in self.w.runs.rglob("*.*")}
                self.assertEqual(after, before)

    def test_spawning_keeps_ten_runs_and_preserves_legacy_files(self):
        self.w.config["runner"] = "codex"
        self.w.config["reviewer_model"] = "gpt-6-astra"
        legacy = [self.w.runs / f"{self.w.slug(PR1)}.{ext}" for ext in ("brief.md", "jsonl", "last.md")]
        for path in legacy:
            path.write_text("legacy")
        other = self.w.runs / self.w.slug(PR2)
        other.mkdir()
        (other / "20261023T120000Z.jsonl").write_text("other PR")
        for n in range(1, 13):
            rs.spawn_run(self.w, PR1, f"brief {n}")
            if n == 11:
                self.assertFalse((self.run_dir / "20261023T120000Z.jsonl").exists())
                self.assertTrue((self.run_dir / "20261023T120000Z-2.jsonl").exists())
        expected = {f"20261023T120000Z-{n}.{ext}" for n in range(3, 13)
                    for ext in ("brief.md", "jsonl", "last.md")}
        self.assertEqual({p.name for p in self.run_dir.iterdir()}, expected)
        for path in legacy:
            self.assertEqual(path.read_text(), "legacy")
        self.assertEqual((other / "20261023T120000Z.jsonl").read_text(), "other PR")

    def age_directory(self, name, age):
        directory = self.w.runs / name
        directory.mkdir()
        stamp = (rs.now_utc() - rs.dt.timedelta(days=age)).timestamp()
        for ext in ("brief.md", "jsonl", "last.md"):
            path = directory / f"20260901T120000Z.{ext}"
            path.write_text("old run")
            os.utime(path, (stamp, stamp))
        return directory

    def test_tick_prunes_only_old_idle_directories(self):
        self.listing["acme/app"] = []
        old = self.age_directory("old-idle", 31)
        recent = self.age_directory("recent", 29)
        boundary = self.age_directory("boundary", 30)
        active = self.age_directory("old-active", 31)
        stale = self.age_directory("old-stale", 31)
        newest = self.age_directory("newest", 31)
        fresh = newest / "20261023T120000Z.jsonl"
        fresh.write_text("fresh log")
        os.utime(fresh, (rs.now_utc().timestamp(), rs.now_utc().timestamp()))
        live_pid = self.w.runs / "old-active.pid"
        live_pid.write_text("4242 start")
        stale_pid = self.w.runs / "old-stale.pid"
        stale_pid.write_text("4242 different-start")
        legacy = self.w.runs / "old-idle.jsonl"
        legacy.write_text("legacy")
        code, _ = self.cli("tick", self.watch)
        self.assertEqual(code, 0)
        self.assertFalse(old.exists())
        self.assertFalse(stale.exists())
        for path in (recent, boundary, active, newest, live_pid, stale_pid, legacy):
            self.assertTrue(path.exists(), path)

    def test_tick_does_not_follow_directory_symlinks(self):
        self.listing["acme/app"] = []
        outside = self.w.dir / "outside"
        outside.mkdir()
        path = outside / "20260901T120000Z.jsonl"
        path.write_text("preserve")
        os.utime(path, (0, 0))
        (self.w.runs / "linked").symlink_to(outside, target_is_directory=True)
        self.cli("tick", self.watch)
        self.assertEqual(path.read_text(), "preserve")

    def test_pruning_errors_do_not_fail_spawn_or_tick(self):
        for n in range(10):
            rs.spawn_run(self.w, PR1, f"brief {n}")
        with patch.object(Path, "unlink", side_effect=PermissionError("denied")):
            log = rs.spawn_run(self.w, PR1, "eleventh")
        self.assertEqual((self.w.dir / log).read_text(), "log: eleventh")
        self.listing["acme/app"] = []
        self.age_directory("old-idle", 31)
        for method in ("unlink", "iterdir", "stat", "rmdir"):
            original = getattr(Path, method)
            def fail_in_runs(path, *args, **kwargs):
                if path == self.w.runs or self.w.runs in path.parents:
                    raise OSError("unavailable")
                return original(path, *args, **kwargs)
            with self.subTest(method=method), patch.object(Path, method, fail_in_runs):
                code, _ = self.cli("tick", self.watch)
                self.assertEqual(code, 0)


class Covers(unittest.TestCase):
    def test_specs(self):
        self.assertTrue(rs.covers("acme/app", PR1))
        self.assertTrue(rs.covers("acme", PR1))
        self.assertFalse(rs.covers("other", PR1))
        mr = "https://gitlab.example.com/grp/sub/proj/-/merge_requests/5"
        self.assertTrue(rs.covers("gitlab:gitlab.example.com/grp", mr))
        self.assertTrue(rs.covers("gitlab:gitlab.example.com/grp/sub/proj!", mr))
        self.assertFalse(rs.covers("gitlab:gitlab.example.com/gr", mr))


