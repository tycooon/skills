    def test_every_target_unread_notifies_once(self):
        first = rs.iso(rs.now_utc())
        self.assertNotIn("_unread", rs.Watch(self.watch).load().prs)
        with patch.object(rs, "list_target", side_effect=rs.ScanError("net/http: TLS handshake timeout")):
            for n in range(1, 4):
                with self.subTest(tick=n):
                    rs.now_utc = lambda: rs.parse_time(first) + rs.dt.timedelta(minutes=2 * (n - 1))
                    code, out = self.cli("tick", self.watch)
                    self.assertEqual(code, 5)
                    self.assertIn("UNREAD (net/http: TLS handshake timeout)", out)
                    self.assertEqual(self.prs()["_unread"], {"ticks": n, "since": first})
                    self.assertEqual(len(self.notified), int(n >= 2))
                    _, status = self.cli("status", self.watch)
                    if n == 1:
                        self.assertNotIn("PROBLEM", status)
                        self.assertNotIn("could not read any target", out)
                    else:
                        self.assertIn(f"PROBLEM since {first}:", status)
                        self.assertIn("could not read any target (acme/app)", out)
        log = (rs.HOME / self.watch / "scan.log").read_text()
        self.assertEqual(log.count("UNREAD (net/http: TLS handshake timeout)"), 3)
        rs.list_target = lambda spec: self.listing[spec]
        self.cli("tick", self.watch)
        _, out = self.cli("status", self.watch)
        self.assertNotIn("PROBLEM", out)
        self.assertNotIn("_unread", self.prs())

    def test_success_breaks_the_unread_streak(self):
        for unread in (True, False, True):
            with patch.object(rs, "list_target", side_effect=rs.ScanError("timeout") if unread else None,
                              return_value=[]):
                code, _ = self.cli("tick", self.watch)
            self.assertEqual(code, 5 if unread else 0)
            if unread:
                self.assertEqual(self.prs()["_unread"]["ticks"], 1)
            else:
                self.assertNotIn("_unread", self.prs())
            self.assertEqual(self.notified, [])

    def test_partial_read_breaks_the_unread_streak(self):
        self.cli("init", self.watch, "--target", "acme/app", "--target", "acme/lib", "--own", "review-bot")
        for results in ((rs.ScanError("timeout"), rs.ScanError("timeout")),
                        (rs.ScanError("timeout"), []),
                        (rs.ScanError("timeout"), rs.ScanError("timeout"))):
            with patch.object(rs, "list_target", side_effect=results):
                code, out = self.cli("tick", self.watch)
            self.assertEqual(code, 5)
            self.assertIn("UNREAD", out)
            if isinstance(results[1], list):
                self.assertNotIn("_unread", self.prs())
            else:
                self.assertEqual(self.prs()["_unread"]["ticks"], 1)
            self.assertEqual(self.notified, [])

    def test_dry_run_neither_extends_nor_resets_the_unread_streak(self):
        first = rs.iso(rs.now_utc())
        with patch.object(rs, "list_target", side_effect=rs.ScanError("timeout")):
            self.assertEqual(self.cli("tick", self.watch)[0], 5)
        before = self.prs()
        for unread in (True, False):
            rs.now_utc = lambda: rs.parse_time(first) + rs.dt.timedelta(minutes=2)
