from pathlib import Path

sys.dont_write_bytecode = True  # loading bin/review-scan as a module would litter bin/
SCRIPT = Path(__file__).resolve().parent.parent / "bin" / "review-scan"
TMP = tempfile.TemporaryDirectory()
os.environ["REVIEW_SCAN_HOME"] = TMP.name


def load_module():
    loader = importlib.machinery.SourceFileLoader("review_scan", str(SCRIPT))
    spec = importlib.util.spec_from_loader("review_scan", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


rs = load_module()
A, B = "a" * 40, "b" * 40
PR1 = "https://github.com/acme/app/pull/1"
PR2 = "https://github.com/acme/app/pull/2"
RECENT = "2026-10-23T10:00:00Z"


def act(head=A, updated=RECENT, authors=(), approvers=("review-bot",), threads=(), approved_at=None):
    if approved_at is None:
        approved_at = {(who, head) for who in approvers}
    return {"head": head, "updated": updated, "authors": set(authors), "approved_at": set(approved_at),
            "noted_at": set(), "author": "dev", "threads": set(threads)}


SINCE = ["--since", "2026-10-23T11:00:00Z", "--verdict", "approved"]


def row(url, head=A, updated=RECENT, draft=False, state="open", named=False):
    return rs.pr_row(url, head, updated, draft, f"title {url[-1]}", "master", f"br{url[-1]}", "dev", state, named)


class Base(unittest.TestCase):
    def setUp(self):
        self.listing = {"acme/app": [row(PR1), row(PR2)]}
        self.activity = {}
        self.spawned = []
        rs.list_target = lambda spec: self.listing[spec]
        rs.activity_since = lambda url, since: self.activity[url]
        rs.now_utc = lambda: rs.parse_time("2026-10-23T12:00:00Z")
        self.notified = []
        rs.notify = self.notified.append
        self.watch = f"w{self.id().split('.')[-1]}"
        self.cli("init", self.watch, "--target", "acme/app", "--own", "review-bot", "--reviewer-model", "sonnet")

    def cli(self, *argv, spawn=None):
        out = io.StringIO()
        with contextlib.redirect_stdout(out):
            code = rs.main(list(argv)) if argv[0] != "tick" else rs.cmd_tick(self.tick_args(*argv[1:]),
                                                                                spawn=spawn or self.spawn)
        return code, out.getvalue()

    def tick_args(self, watch, *flags):
        class A_: pass
        a = A_()
        a.watch, a.full, a.only, a.dry_run = watch, "--full" in flags, None, "--dry-run" in flags
        a.chained = "--chained" in flags
        if "--only" in flags:
            a.only = flags[flags.index("--only") + 1]
        return a

    def spawn(self, w, url, brief):
        self.spawned.append((url, brief))

    def prs(self):
        return json.loads((rs.HOME / self.watch / "prs.json").read_text())


class Pause(Base):
    def test_unsupported_saved_model_can_be_paused_and_skips_ticks(self):
        w = rs.Watch(self.watch).load()
        self.addCleanup(rs.write_json, w.dir / "config.json", dict(w.config))
        w.config["reviewer_model"] = "old-custom-alias"
        rs.write_json(w.dir / "config.json", w.config)
        self.assertEqual(self.cli("pause", self.watch)[0], 0)
        with patch.object(rs, "list_target", side_effect=AssertionError("read while paused")):
            self.assertEqual(self.cli("tick", self.watch)[0], 0)
        self.assertEqual(self.spawned, [])
        self.assertEqual(self.cli("resume", self.watch)[0], 0)
        self.assertFalse(rs.Watch(self.watch).load().paused)

    def test_paused_ticks_skip_reads_cleanup_and_launches(self):
        with rs.Watch(self.watch).locked() as w:
            w.prs.update(_paused=True, _tick={"kept_urls": [PR1]})
            w.save()
        before = self.prs()
        old = w.runs / "old-idle"
        old.mkdir()
        log = old / "old.jsonl"
        log.write_text("keep while paused")
        stamp = (rs.now_utc() - rs.dt.timedelta(days=31)).timestamp()
        os.utime(log, (stamp, stamp))
        flags = [(), ("--chained",), ("--full",), ("--only", PR1), ("--dry-run",),
                 ("--chained", "--full", "--only", PR1, "--dry-run")]
        for scheduled in (False, True):
            with patch.object(rs, "is_scheduled", return_value=scheduled), \
                    patch.object(rs, "list_target", wraps=rs.list_target) as listing:
                for variant in flags:
                    with self.subTest(scheduled=scheduled, flags=variant):
                        code, out = self.cli("tick", self.watch, *variant)
                        self.assertEqual(code, 0)
                        self.assertIn(": paused;", out)
                        self.assertEqual(listing.call_count, 0)
                        self.assertEqual(self.spawned, [])
                        self.assertEqual(self.prs(), before)
                        self.assertTrue(log.exists())
        self.assertEqual(self.notified, [])

    def test_controls_are_idempotent_and_preserve_existing_state(self):
        self.cli("tick", self.watch)
        w = rs.Watch(self.watch).load()
        before = self.prs()
        config = (w.dir / "config.json").read_bytes()
        pid = w.runs / f"{w.slug(PR1)}.pid"
        pid.write_text("4242 start")
        with patch.object(rs.os, "killpg", side_effect=AssertionError("signalled a run")), \
                patch.object(rs.subprocess, "run", side_effect=AssertionError("changed schedule")), \
                patch.object(rs.subprocess, "Popen", side_effect=AssertionError("started a run")):
            for command in ("pause", "resume"):
                code, out = self.cli(command, self.watch)
                self.assertEqual(code, 0)
                state = self.prs()
                self.assertEqual(self.cli(command, self.watch)[0], 0)
                self.assertEqual(self.prs(), state)
                self.assertEqual({k: v for k, v in state.items() if k != "_paused"}, before)
                self.assertEqual((w.dir / "config.json").read_bytes(), config)
                self.assertEqual(pid.read_text(), "4242 start")
                if command == "resume":
                    self.assertIn(f"review-scan tick {self.watch}", out)
        self.spawned.clear()
        self.cli("tick", self.watch)
        self.assertEqual([u for u, _ in self.spawned], [PR1, PR2])

    def test_pause_persists_after_module_reload(self):
        self.cli("pause", self.watch)
        reloaded = load_module()
        with patch.object(reloaded, "list_target", side_effect=AssertionError("read while paused")), \
                contextlib.redirect_stdout(io.StringIO()) as out:
            self.assertEqual(reloaded.main(["tick", self.watch]), 0)
        self.assertIn(": paused;", out.getvalue())

    def test_legacy_state_and_other_watches_still_run(self):
        other = self.watch + "-other"
        self.cli("init", other, "--target", "acme/app", "--own", "review-bot")
        self.cli("pause", self.watch)
        self.assertEqual(self.cli("tick", other)[0], 0)
        self.assertEqual([u for u, _ in self.spawned], [PR1, PR2])
        self.assertNotIn("_paused", rs.Watch(other).load().prs)
        self.spawned.clear()
        self.assertEqual(self.cli("tick", self.watch)[0], 0)
        self.assertEqual(self.spawned, [])

    def test_missing_watch_controls_fail_without_creating_state(self):
        name = self.watch + "-missing"
        for command in ("pause", "resume"):
            with self.subTest(command=command), self.assertRaisesRegex(SystemExit, f"no watch '{name}'"):
                self.cli(command, name)
            self.assertFalse((Path(TMP.name) / name).exists())

    def test_pause_survives_configuration_changes_and_reinit(self):
        self.cli("pause", self.watch)
        before = self.prs()
        with patch.object(rs, "claude_auth_status", return_value={"loggedIn": False}):
            self.cli("account", self.watch, "default")
        self.cli("model", self.watch, "opus", "--effort", "high")
        for _ in range(2):
            self.cli("init", self.watch, "--target", "acme/app", "--own", "review-bot")
        self.assertEqual(self.prs(), before)
        self.cli("tick", self.watch)
        self.assertEqual(self.spawned, [])

    def test_pause_survives_install_and_uninstall_still_terminates_runs(self):
        self.cli("pause", self.watch)
        before = self.prs()
        w = rs.Watch(self.watch).load()
        pid = w.runs / f"{w.slug(PR1)}.pid"
        pid.write_text("4242 start")
        plist = w.dir / "watch.plist"
        with patch.object(rs.sys, "platform", "darwin"), \
                patch.object(rs, "plist_path", return_value=plist), \
                patch.object(rs.subprocess, "run"), \
                patch.object(rs, "our_pid", return_value=4242), \
                patch.object(rs.os, "killpg") as kill:
            self.cli("install", self.watch)
            self.assertTrue(plist.exists())
            self.assertEqual(self.cli("tick", self.watch, "--chained")[0], 0)
            self.cli("uninstall", self.watch)
            self.assertFalse(plist.exists())
            kill.assert_called_once_with(4242, rs.signal.SIGTERM)
            self.cli("install", self.watch)
            self.assertEqual(self.prs(), before)
        self.assertEqual(self.spawned, [])

    def test_status_shows_pause_independently_of_schedule(self):
        for scheduled in (False, True):
            with patch.object(rs, "is_scheduled", return_value=scheduled):
                for command in ("pause", "resume"):
                    self.cli(command, self.watch)
                    for args in (("list",), ("status",), ("status", self.watch)):
                        with self.subTest(scheduled=scheduled, command=command, args=args):
                            code, out = self.cli(*args)
                            self.assertEqual(code, 0)
                            prefix = f"watch {self.watch}:" if len(args) == 2 else f"{self.watch}:"
                            line = next(line for line in out.splitlines() if line.startswith(prefix))
                            self.assertIn(", scheduled" if scheduled else ", not scheduled", line)
                            self.assertEqual(", paused" in line, command == "pause")


class Tick(Base):
