            self.assertEqual(self.cli("tick", self.watch)[0], 5)
        self.assertEqual(self.prs()["_unread"], {"ticks": 2, "since": first})
        self.assertEqual(self.prs()["_alert"]["since"], first)
        self.assertEqual(len(self.notified), 1)

