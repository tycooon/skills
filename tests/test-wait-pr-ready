class Approval(unittest.TestCase):
    def test_formal_approval_naming_the_head(self):
        ready, reasons = evaluate(ready_pr())
        self.assertTrue(ready, reasons)

    def test_teammate_approve_does_not_count(self):
        pr = ready_pr(reviews={"nodes": [review("alice", "APPROVED", "")]})
        self.assertFalse(evaluate(pr)[0])

    def test_listed_reviewer_counts_without_identity(self):
        pr = ready_pr(reviews={"nodes": [review("alice", "APPROVED", "")]})
        self.assertTrue(evaluate(pr, reviewers=["alice"])[0])

    def test_listed_reviewers_are_the_only_verdict_source(self):
        # A session reviewer posting from the author's account carries the identity line too.
        session = review("author", "COMMENTED", f"APPROVED. AI reviewer: Claude (session reviewer). Reviewed {HEAD}.")
        pr = ready_pr(reviews={"nodes": [session]})
        self.assertFalse(evaluate(pr, reviewers=["review-bot"])[0])
        self.assertTrue(evaluate(pr)[0], "without --reviewer the identity line still counts")
        both = ready_pr(reviews={"nodes": [session, review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {HEAD}.")]})
        self.assertTrue(evaluate(both, reviewers=["review-bot"])[0])

    def test_newer_findings_review_replaces_the_approval(self):
        pr = ready_pr(reviews={"nodes": [
            review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {OLD}.", sha=OLD, at="2026-10-15T08:00:00Z"),
            review("review-bot", "COMMENTED", "AI reviewer: Claude.", at="2026-10-15T10:00:00Z"),
        ]})
        self.assertFalse(evaluate(pr, same=lambda o, n, at: True)[0])

    def test_bodiless_thread_reply_is_not_a_verdict(self):
        pr = ready_pr()
        pr["reviews"]["nodes"].append(review("review-bot", "COMMENTED", "", at="2026-10-15T11:00:00Z"))
        self.assertTrue(evaluate(pr)[0])

    def test_approval_on_older_head_needs_base_sync(self):
        pr = ready_pr(reviews={"nodes": [review("review-bot", "APPROVED", f"AI reviewer: Claude. Reviewed {OLD}.", sha=OLD)]})
        self.assertFalse(evaluate(pr, same=lambda o, n, at: False)[0])
        ready, reasons = evaluate(pr, same=lambda o, n, at: (o, n) == (OLD, HEAD))
        self.assertTrue(ready)
        self.assertIn("base-sync", reasons[0])

    def test_go_signal_comment(self):
        pr = ready_pr(reviews={"nodes": []}, comments={"nodes": [comment("tycooon", f"APPROVED. AI reviewer: Codex. Reviewed {HEAD}.")]})
        self.assertTrue(evaluate(pr)[0])

    def test_negated_go_signal_is_not_approval(self):
        pr = ready_pr(reviews={"nodes": []}, comments={"nodes": [comment("tycooon", "AI reviewer: Codex. Not approving until the test is fixed.")]})
        self.assertFalse(evaluate(pr)[0])

    def test_person_naming_an_agent_is_not_a_verdict(self):
        pr = ready_pr(reviews={"nodes": []}, comments={"nodes": [comment("tycooon", "Claude's findings are addressed, Codex approved the earlier design", at="2026-10-15T09:10:00Z")]})
        self.assertFalse(evaluate(pr)[0])

    def test_shaless_comment_must_follow_the_head_commit(self):
        late = ready_pr(reviews={"nodes": []}, comments={"nodes": [comment("tycooon", "LGTM — AI reviewer: Codex", at="2026-10-15T09:10:00Z")]})
        early = ready_pr(reviews={"nodes": []}, comments={"nodes": [comment("tycooon", "LGTM — AI reviewer: Codex", at="2026-10-15T08:50:00Z")]})
        self.assertTrue(evaluate(late)[0])
        self.assertFalse(evaluate(early)[0])


def retarget(at="2026-10-15T10:30:00Z", previous="feature"):
    return {"nodes": [{"createdAt": at, "previousRefName": previous}]}


class BaseAt(unittest.TestCase):
    def test_no_retarget_reads_the_current_base(self):
        self.assertEqual(w.base_at(ready_pr(), "2026-10-15T10:00:00Z"), "master")

    def test_verdict_before_a_retarget_reads_the_base_it_was_posted_under(self):
        pr = ready_pr(timelineItems=retarget())
        self.assertEqual(w.base_at(pr, "2026-10-15T10:00:00Z"), "feature")
        self.assertEqual(w.base_at(pr, "2026-10-15T11:00:00Z"), "master")

    def test_the_first_retarget_after_the_verdict_wins(self):
        pr = ready_pr(timelineItems={"nodes": [
            {"createdAt": "2026-10-15T09:00:00Z", "previousRefName": "older"},
            {"createdAt": "2026-10-15T12:00:00Z", "previousRefName": "middle"},
            {"createdAt": "2026-10-15T11:00:00Z", "previousRefName": "feature"},
        ]})
        self.assertEqual(w.base_at(pr, "2026-10-15T10:00:00Z"), "feature")

    def test_githubs_automatic_retarget_counts(self):
        pr = ready_pr(timelineItems={"nodes": [{"createdAt": "2026-10-15T10:30:00Z", "oldBase": "feature"}]})
        self.assertEqual(w.base_at(pr, "2026-10-15T10:00:00Z"), "feature")


class OtherGates(unittest.TestCase):
    def test_pending_failed_or_missing_checks_block(self):
        for contexts in ([check("test", status="IN_PROGRESS", conclusion=None)], [check("test", conclusion="FAILURE")], []):
            pr = ready_pr()
            pr["commits"]["nodes"][0]["commit"]["statusCheckRollup"] = {"contexts": {"nodes": contexts}}
            self.assertFalse(evaluate(pr)[0], contexts)

    def test_no_ci_skips_the_checks_gate(self):
        pr = ready_pr()
        pr["commits"]["nodes"][0]["commit"]["statusCheckRollup"] = None
        self.assertFalse(evaluate(pr)[0])
        self.assertTrue(evaluate(pr, no_ci=True)[0])

    def test_status_context(self):
        pr = ready_pr()
        pr["commits"]["nodes"][0]["commit"]["statusCheckRollup"] = {"contexts": {"nodes": [{"__typename": "StatusContext", "context": "ci", "state": "PENDING", "createdAt": None}]}}
        self.assertFalse(evaluate(pr)[0])

    def test_unresolved_thread_blocks(self):
        self.assertFalse(evaluate(ready_pr(reviewThreads={"nodes": [{"isResolved": False}]}))[0])

    def test_merge_blocks(self):
        for mergeable, status in (("CONFLICTING", "DIRTY"), ("MERGEABLE", "BEHIND"), ("MERGEABLE", "BLOCKED"), ("MERGEABLE", "DRAFT"), ("UNKNOWN", "UNKNOWN")):
            self.assertFalse(evaluate(ready_pr(mergeable=mergeable, mergeStateStatus=status))[0], status)


class Loop(unittest.TestCase):
    def run_main(self, reads, args=(), clock_step=0, workflows=1, runs=1, head=(), recent_checks=1, url=URL,
                 start="2026-10-15T10:00:00Z", stderr=None):
        """Feeds main() one PR per read; each sleep advances the fake clock by its wait plus clock_step.
        workflows and runs are what the Actions API reports for the repository and the head,
        recent_checks how many recent heads carry checks;
        head yields head_runs' (active, failed, oldest) per call, by default an hour-old green run."""
        reads = iter(reads)
        clock = [w.ts(start)]
        waits = []

        def read_pr(*_):
            pr = next(reads)
            if isinstance(pr, Exception):
                raise pr
            return copy.deepcopy(pr)

        def sleep(seconds):
            waits.append(seconds)
            clock[0] += seconds + clock_step

        head = iter(head)
        originals = w.read_pr, w.workflow_count, w.recent_checks, w.workflow_runs, w.head_runs, w.gl_read_mr
        w.read_pr = read_pr
        w.gl_read_mr = read_pr
        w.workflow_count = lambda *_: workflows
        w.recent_checks = lambda *_: recent_checks
        w.workflow_runs = lambda *_: runs
        w.head_runs = lambda *_: next(head, ([], [], w.ts("2026-10-15T09:00:00Z")))
        out = io.StringIO()
        try:
            with contextlib.redirect_stdout(out), contextlib.redirect_stderr(stderr if stderr is not None else io.StringIO()):
                code = w.main([url, *args], now=lambda: clock[0], sleep=sleep)
        finally:
            w.read_pr, w.workflow_count, w.recent_checks, w.workflow_runs, w.head_runs, w.gl_read_mr = originals
        return code, out.getvalue(), waits

    def test_an_owed_thread_on_the_first_read_wakes_both_modes(self):
        for args in ([], ["--until-review"]):
            for state in ("APPROVED", "COMMENTED"):
                with self.subTest(args=args, state=state):
                    thread = thread_with_last_comment(state=state)
                    pr = ready_pr(reviewThreads={"nodes": [thread]})
                    code, out, waits = self.run_main([pr], args=args)
                    self.assertEqual(code, 14, out)
                    self.assertIn(f"an open thread awaits the author on {URL} at {HEAD}: {URL}#discussion_r1", out)
                    self.assertTrue(out.endswith("; activity 2026-10-15T10:00:00Z\n"), out)
                    self.assertEqual(waits, [])

    def test_the_owed_thread_mark_covers_every_last_comment(self):
        first = thread_with_last_comment(at="2026-10-15T10:05:00Z")
        second = thread_with_last_comment(at="2026-10-15T10:06:00Z")
        second["replies"]["nodes"][0]["url"] = URL + "#discussion_r2"
        pr = ready_pr(reviewThreads={"nodes": [first, second]})
        code, out, waits = self.run_main([pr])
        self.assertEqual(code, 14, out)
        self.assertIn(URL + "#discussion_r1 (2 threads)", out)
        self.assertTrue(out.endswith("; activity 2026-10-15T10:06:00Z\n"), out)
        self.assertEqual(waits, [])
        code, _, waits = self.run_main([pr, ready_pr(headRefOid=OLD)], args=["--after", "2026-10-15T10:06:00Z"], start="2026-10-15T10:06:00Z")
        self.assertEqual(code, 12)
        self.assertEqual(len(waits), 1)

    def test_a_fractional_comment_time_survives_the_printed_rearm_mark(self):
        at = "2026-10-15T10:05:00.123456Z"
        pr = ready_pr(reviewThreads={"nodes": [thread_with_last_comment(at=at)]})
        code, out, _ = self.run_main([pr])
        self.assertEqual(code, 14, out)
        mark = out.strip().split("; activity ")[-1]
        self.assertGreaterEqual(w.ts(mark), w.ts(at))
        code, out, waits = self.run_main([pr, ready_pr(headRefOid=OLD)], args=["--after", mark], start=mark)
        self.assertEqual(code, 12, out)
        self.assertEqual(len(waits), 1)

