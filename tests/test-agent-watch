    def test_brief_timeout_is_a_failed_start(self):
        original = self.aw.run_shell
        def run(cmd, *args, **kw):
            if cmd.endswith(' brief'):
                raise subprocess.TimeoutExpired(cmd, 120)
            return original(cmd, *args, **kw)
        with patch.object(self.aw, 'run_shell', side_effect=run):
            self.assertEqual(self.tick()[0], 5)
        self.assertEqual(self.started, [])

    def test_linux_schedules_of_both_tools_do_not_remove_each_other(self):
        loader = importlib.machinery.SourceFileLoader('review_scan', str(SCRIPT.with_name('review-scan')))
        rs = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
        loader.exec_module(rs)
        rs.engine.HOME = self.aw.HOME
        with contextlib.redirect_stdout(io.StringIO()):
            rs.main(['init', 'review', '--target', 'acme/app', '--own', 'bot', '--reviewer-model', 'sonnet'])
        tab = ['# user entry\n']
        def cron(cmd, **kw):
            if cmd == ['crontab', '-']:
                tab[0] = kw['input']
            return subprocess.CompletedProcess(cmd, 0, stdout=tab[0], stderr='')
        with patch.object(self.aw.subprocess, 'run', side_effect=cron):
            self.cli('install', 'work')
            with contextlib.redirect_stdout(io.StringIO()):
                self.assertEqual(rs.main(['install', 'review']), 0)
                self.assertEqual(rs.main(['install', 'review']), 0)
            self.assertEqual(tab[0].count('# review-scan:review'), 1)
            self.assertEqual(tab[0].count('# agent-watch:work'), 1)
            self.assertTrue(rs.is_scheduled('review'))
            self.cli('uninstall', 'work')
            self.assertTrue(rs.is_scheduled('review'))
            with contextlib.redirect_stdout(io.StringIO()):
                self.assertEqual(rs.main(['uninstall', 'review']), 0)
            self.assertEqual(tab[0], '# user entry\n')



