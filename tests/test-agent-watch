    def run_log(self, key, stamp, events=None):
        w = self.aw.Watch('work').load()
        directory = w.runs / w.slug(key)
        directory.mkdir(exist_ok=True)
        (directory / (stamp + '.brief.md')).write_text('Work on item')
        log = directory / (stamp + '.jsonl')
        if events is not None:
            log.write_text(''.join(json.dumps(event) + '\n' for event in events))
        return log

    def failed_history(self, events):
        self.settings['items'] = []
        self.write()
        return [self.run_log(key, stamp, events) for key, stamp in (
            ('one', '20261031T095700Z'), ('two', '20261031T095800Z'),
            ('one', '20261031T095900Z'))]

