    def test_linux_crontab_install_uninstall_is_scoped(self):
        tab = ['# user entry\n* * * * * other-command\n']
        original = self.aw.subprocess.run
        def cron(cmd, **kw):
            if cmd == ['crontab', '-l']:
                return subprocess.CompletedProcess(cmd, 0, stdout=tab[0], stderr='')
            if cmd == ['crontab', '-']:
                tab[0] = kw['input']
                return subprocess.CompletedProcess(cmd, 0, stdout='', stderr='')
            return original(cmd, **kw)
        with patch.object(self.aw.sys, 'platform', 'linux'), patch.object(self.aw.subprocess, 'run', side_effect=cron):
            self.assertEqual(self.cli('install', 'work')[0], 0)
            first = tab[0]
            self.assertEqual(self.cli('install', 'work')[0], 0)
            self.assertEqual(tab[0], first)
            self.assertTrue(self.aw.is_scheduled('work'))
            self.assertFalse(self.aw.is_scheduled('wor'))
            self.assertEqual(self.cli('uninstall', 'work')[0], 0)
            self.assertEqual(tab[0], '# user entry\n* * * * * other-command\n')
            self.assertFalse(self.aw.is_scheduled('work'))

    def test_real_runner_receives_brief_in_run_dir_and_settles_batch(self):
        self.init('--max-items-per-run', '2')
        self.settings['items'] = [item('one'), item('two')]
        self.write()
        binary = self.root / 'claude'
        binary.write_text('#!' + sys.executable + '\n' + '''import json, pathlib, shlex, subprocess, sys
if sys.argv[1:3] == ['auth', 'status']:
    print('{"loggedIn": true}')
    sys.exit(0)
brief = sys.stdin.read()
pathlib.Path('runner.json').write_text(json.dumps({'cwd': str(pathlib.Path.cwd()), 'brief': brief}))
for line in brief.splitlines():
    if 'agent-watch settle ' in line:
        cmd = shlex.split(line.split(' --verdict ')[0]) + ['--verdict', 'done']
        subprocess.run(cmd, check=True)
''')
        binary.chmod(0o755)
        env = dict(os.environ, PATH=str(self.root) + os.pathsep + os.environ['PATH'],
                   AGENT_WATCH_HOME=str(self.aw.HOME))
        p = subprocess.run([str(SCRIPT), 'tick', 'work'], env=env, capture_output=True, text=True, timeout=10)
        self.assertEqual(p.returncode, 0, p.stderr)
        import time
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline:
            state = self.state()
            if all('settled' in state.get(key, {}) for key in ('one', 'two')):
                break
            time.sleep(.02)
        self.assertTrue(all('settled' in state.get(key, {}) for key in ('one', 'two')), state)
        observed = json.loads((self.root / 'runner.json').read_text())
        self.assertEqual(observed['cwd'], str(self.root))
        self.assertIn('Work on one, two', observed['brief'])
        self.assertEqual(self.calls('brief')[0][1]['items'], self.settings['items'])
        self.assertEqual(state['_tick']['started'], 1)

    def git(self, directory, *args):
        return subprocess.run(['git', '-C', str(directory), *args], check=True,
                              capture_output=True, text=True).stdout.strip()

    def checkout(self):
        directory = self.root / 'main checkout'
        directory.mkdir()
        self.git(directory, 'init')
        self.git(directory, '-c', 'user.name=Test', '-c', 'user.email=test@example.com',
                 '-c', 'commit.gpgsign=false', 'commit', '--allow-empty', '-m', 'Initial commit')
        return directory

    def launch_git_dirs(self, directory, model='gpt-6-astra', prepare=None):
        extra = ['--run-dir', str(directory), '--reviewer-model', model]
        if prepare:
            extra.extend(['--prepare-cmd', prepare])
        self.assertEqual(self.init(*extra)[0], 0)
        original = subprocess.Popen
        launched = []
        with patch.object(self.aw.shutil, 'which', return_value='/stub/runner'), \
             patch.object(self.aw, 'codex_logged_in', return_value=True), \
             patch.object(self.aw, 'claude_logged_in', return_value=True), \
             patch.object(self.aw, 'proc_start', return_value='start'), \
             patch.object(self.aw.subprocess, 'Popen') as popen:
            popen.return_value.pid = 4242
            def capture(cmd, *args, **kwargs):
                if cmd[:3] == ['/bin/sh', '-c', self.aw.WRAPPER]:
                    launched.append(cmd[7:])
                    return popen.return_value
                return original(cmd, *args, **kwargs)
            popen.side_effect = capture
            result = self.cli('tick', 'work')
            self.assertEqual(result[0], 0, result)
            argv, = launched
        return [argv[i + 1] for i, arg in enumerate(argv) if arg == '--add-dir']

