    def test_command_keys_cannot_collide_in_pidfiles(self):
        w = self.aw.Watch('work').load()
        self.assertNotEqual(w.slug('one/two'), w.slug('one:two'))
        self.assertLess(len(w.slug('x' * 1000)), 150)

