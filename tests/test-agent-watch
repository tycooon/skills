        self.settings['items'] = [item('one'), item('two'), item('three')]
        self.write()
        rc, out, err = self.tick()
        self.assertEqual(rc, 5)
        self.assertIn('1 run(s) failed to start', out)
        self.assertEqual(out.count('run FAILED to start'), 3)

    def test_fingerprint_cycle_clears_previous_hold(self):
        self.init('--max-attempts', '1')
        self.tick()
        self.settle()
        self.settings['items'] = [item('one', 'v2')]
        self.write()
        self.tick()
