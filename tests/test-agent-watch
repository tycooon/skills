    def test_only_log_tail_is_used_and_last_turn_failure_wins(self):
        logs = self.failed_history([{'type': 'turn.completed'}])
        for log in logs:
            with log.open('a') as f:
                f.write('x' * 200000 + '\n')
                f.write('{"type":"turn.completed"}\n')
                f.write('{"type":"turn.failed","error":{"message":"tail failure"}}\n')
        oversized = self.run_log('large', '20261031T095600Z', [
            {'type': 'result', 'subtype': 'success', 'is_error': False, 'result': 'x' * 200000}])
        beyond_cap = self.run_log('large', '20261031T095500Z', [
            {'type': 'turn.completed', 'result': 'x' * (5 * 1024 * 1024)}])
        original = Path.open
        class BoundedReader:
            def __init__(self, file):
                self.file = file
                self.read_bytes = 0
            def __enter__(self):
                self.file.__enter__()
                return self
            def __exit__(self, *args):
                return self.file.__exit__(*args)
            def __getattr__(self, name):
                return getattr(self.file, name)
            def read(self, size=-1):
                self_test.assertGreater(size, 0)
                self_test.assertLessEqual(size, 65536)
                self.read_bytes += size
                self_test.assertLessEqual(self.read_bytes, 4 * 1024 * 1024 + 4096)
                return self.file.read(size)
        self_test = self
        def bounded(path, *args, **kwargs):
            file = original(path, *args, **kwargs)
            return BoundedReader(file) if path.suffix == '.jsonl' else file
        with patch.object(Path, 'open', bounded):
            self.tick()
            self.assertTrue(self.aw.run_result(oversized)[0])
            self.assertFalse(self.aw.run_result(beyond_cap)[0])
        self.assertIn('last 3 runs failed: tail failure', self.state()['_alert']['problem'])

