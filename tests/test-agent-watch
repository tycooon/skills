        self.assertEqual(len(self.started), 3)

    def test_timed_out_commands_kill_descendants(self):
        communicate = self.aw.subprocess.Popen.communicate
        def short_timeout(process, *args, **kwargs):
            if kwargs.get('timeout') is not None:
                self.assertEqual(kwargs['timeout'], 120)
                kwargs['timeout'] = .3
            return communicate(process, *args, **kwargs)

        def alive(pid):
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                return False
            return True

        for kind in ('list', 'brief', 'verify', 'prepare', 'notify'):
            with self.subTest(command=kind):
                pidfile = self.root / f'{kind}.child'
                command = shlex.join(['sh', '-c', f'sleep 30 & echo $! > {shlex.quote(str(pidfile))}; wait'])
                w = self.aw.Watch('work').load()
                w.config.update(source_cmd=command, notify_cmd=command)
                try:
                    with patch.object(self.aw.subprocess.Popen, 'communicate', short_timeout), contextlib.redirect_stderr(io.StringIO()):
                        if kind == 'notify':
                            self.aw.notify_watch(w, 'timeout test')
                            self.assertIn('notification command failed:', (w.dir / 'scan.log').read_text())
                        else:
                            with self.assertRaisesRegex(self.aw.ScanError, 'timed out'):
                                if kind == 'prepare':
                                    self.aw.shell_command(command, str(self.root))
                                else:
                                    self.aw.SOURCE.invoke(w, kind, {})
                    self.assertTrue(pidfile.exists(), 'the shell must start its child before timing out')
                    child = int(pidfile.read_text())
                    deadline = time.monotonic() + 3
                    while alive(child) and time.monotonic() < deadline:
                        time.sleep(.02)
                    self.assertFalse(alive(child), f'{kind} left child {child} alive after its timeout')
                finally:
                    if pidfile.exists():
                        with contextlib.suppress(ProcessLookupError):
                            os.kill(int(pidfile.read_text()), signal.SIGKILL)

    def test_timeout_cleanup_tolerates_group_already_exited(self):
        communicate = self.aw.subprocess.Popen.communicate
        def exited(process, *args, **kwargs):
            if kwargs.get('timeout'):
                process.wait()
                raise subprocess.TimeoutExpired(process.args, kwargs['timeout'])
            return communicate(process, *args, **kwargs)
        with patch.object(self.aw.subprocess.Popen, 'communicate', exited):
            with self.assertRaisesRegex(self.aw.ScanError, 'timed out'):
                self.aw.shell_command('exit 0', str(self.root))

    def test_source_timeouts_are_bounded(self):
        self.tick()
        with patch.object(self.aw, 'run_shell', side_effect=subprocess.TimeoutExpired('source', 120)):
            self.assertEqual(self.tick()[0], 5)
            self.assertEqual(self.settle()[0], 6)

    def test_pause_allows_settle_and_recheck_waits(self):
        self.tick()
        self.cli('pause', 'work')
        self.assertEqual(self.settle()[0], 0)
        self.cli('recheck', 'work', 'one', '--reason', 'again')
        self.tick()
        self.assertEqual(len(self.started), 1)
        self.cli('resume', 'work')
        self.tick()
        self.assertEqual(len(self.started), 2)

    def test_linux_crontab_install_uninstall_is_scoped(self):
        tab = ['# user entry\n* * * * * other-command\n']
        original = self.aw.subprocess.run
        def cron(cmd, **kw):
            if cmd == ['crontab', '-l']:
                return subprocess.CompletedProcess(cmd, 0, stdout=tab[0], stderr='')
            if cmd == ['crontab', '-']:
                tab[0] = kw['input']
                return subprocess.CompletedProcess(cmd, 0, stdout='', stderr='')
            return original(cmd, **kw)
        with patch.object(self.aw.sys, 'platform', 'linux'), patch.object(self.aw.subprocess, 'run', side_effect=cron):
            self.assertEqual(self.cli('install', 'work')[0], 0)
            first = tab[0]
            self.assertEqual(self.cli('install', 'work')[0], 0)
            self.assertEqual(tab[0], first)
            self.assertTrue(self.aw.is_scheduled('work'))
            self.assertFalse(self.aw.is_scheduled('wor'))
            self.assertEqual(self.cli('uninstall', 'work')[0], 0)
            self.assertEqual(tab[0], '# user entry\n* * * * * other-command\n')
            self.assertFalse(self.aw.is_scheduled('work'))

    def test_real_runner_receives_brief_in_run_dir_and_settles_batch(self):
        self.init('--max-items-per-run', '2')
        self.settings['items'] = [item('one'), item('two')]
        self.write()
        binary = self.root / 'claude'
        binary.write_text('#!' + sys.executable + '\n' + '''import json, pathlib, shlex, subprocess, sys
if sys.argv[1:3] == ['auth', 'status']:
    print('{"loggedIn": true}')
    sys.exit(0)
brief = sys.stdin.read()
pathlib.Path('runner.json').write_text(json.dumps({'cwd': str(pathlib.Path.cwd()), 'brief': brief}))
for line in brief.splitlines():
    if 'agent-watch settle ' in line:
        cmd = shlex.split(line.split(' --verdict ')[0]) + ['--verdict', 'done']
        subprocess.run(cmd, check=True)
''')
        binary.chmod(0o755)
        env = dict(os.environ, PATH=str(self.root) + os.pathsep + os.environ['PATH'],
                   AGENT_WATCH_HOME=str(self.aw.HOME))
        p = subprocess.run([str(SCRIPT), 'tick', 'work'], env=env, capture_output=True, text=True, timeout=10)
        self.assertEqual(p.returncode, 0, p.stderr)
        import time
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline:
            state = self.state()
            if all('settled' in state.get(key, {}) for key in ('one', 'two')):
                break
            time.sleep(.02)
        self.assertTrue(all('settled' in state.get(key, {}) for key in ('one', 'two')), state)
        observed = json.loads((self.root / 'runner.json').read_text())
        self.assertEqual(observed['cwd'], str(self.root))
        self.assertIn('Work on one, two', observed['brief'])
        self.assertEqual(self.calls('brief')[0][1]['items'], self.settings['items'])
        self.assertEqual(state['_tick']['started'], 1)

    def test_live_pidfile_counts_even_after_its_item_leaves_listing(self):
        self.tick()
        self.settings['items'] = [item('two')]
        self.write()
        w = self.aw.Watch('work').load()
        (w.runs / 'orphan.pid').write_text('123 start')
