    def test_failed_start_does_not_consume_daily_or_attempt_limits(self):
        self.init('--max-runs-per-day', '1', '--max-attempts', '1')
        def fail(*args):
            raise OSError('cannot spawn')
        self.assertEqual(self.tick(fail)[0], 5)
        self.assertEqual(self.state().get('_runs'), [])
        self.assertNotIn('attempts', self.state()['one'])
        self.assertEqual(self.tick()[0], 0)
