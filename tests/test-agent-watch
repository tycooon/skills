            rc, out, _ = self.tick()
            self.assertEqual(rc, 0)
            self.assertIn('1 listed, 1 kept', out)
            self.assertEqual(self.state()['_items'], {'one': active})
            self.assertEqual(self.state()['_tick']['started'], 0)
        self.assertEqual(len(self.started), 2)
        w = self.aw.Watch('work').load()
        listed, failed, _, _ = self.aw.SOURCE.list(w, self.clock)
        self.assertEqual(failed, [])
        self.assertEqual(listed, {'one': placeholder})
        self.assertEqual(w.prs['_items'], {'one': active})
