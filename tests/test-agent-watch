    def test_fallback_reports_logged_out_entry_as_problem(self):
        self.configure([{'kind': 'default'}, {'kind': 'config_dir', 'path': str(self.root)}])
        real_popen = self.aw.subprocess.Popen
        with patch.object(self.aw, 'claude_logged_in', side_effect=lambda a: a['kind'] != 'default'), \
             patch.object(self.aw.shutil, 'which', return_value='/bin/claude'), \
             patch.object(self.aw, 'proc_start', return_value='start'), \
             patch.object(self.aw.subprocess, 'Popen') as popen, \
             patch.object(self.aw, 'notify_watch') as notify:
            fake = popen.return_value
            fake.pid = 4242
            popen.side_effect = lambda cmd, *a, **kw: fake if cmd[:3] == ['/bin/sh', '-c', self.aw.WRAPPER] else real_popen(cmd, *a, **kw)
            rc, out, _ = self.cli('tick', 'work')
        self.assertEqual(rc, 0)
        self.assertIn('logged out (account default)', out)
        self.assertEqual(self.state()['one']['last_run']['account'], str(self.root))
        notify.assert_called_once()
        self.assertFalse(self.state().get('_accounts'))

