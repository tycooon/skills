    def test_launcher_overlapping_completion_checks_chain_once(self):
        w = self.launcher()
        self.assertEqual(self.cli('tick', 'work')[0], 0)
        stamp = self.clock.timestamp() - self.aw.CHAIN_AFTER
        os.utime(self.runfile(w), (stamp, stamp))
        entered, second_attempted, release = threading.Event(), threading.Event(), threading.Event()
        results, errors = {}, []
        original_lock = self.aw.Watch.launcher_locked

        @contextlib.contextmanager
        def observed_lock(watch):
            if threading.current_thread().name == 'second-check':
                second_attempted.set()
            with original_lock(watch):
                yield

        def terminal_status(*args, **kwargs):
            entered.set()
            if not release.wait(2):
                raise AssertionError('completion check was not released')
            return 'succeeded'

        def check(label):
            try:
                results[label] = self.aw.Watch('work').load().running('one')
            except Exception as exc:
                errors.append(exc)

        threads = [threading.Thread(target=check, args=(label,), name=label + '-check', daemon=True)
                   for label in ('first', 'second')]
        with patch.object(self.aw.Watch, 'launcher_locked', observed_lock), \
             patch.object(self.aw, 'launcher_command', side_effect=terminal_status) as status, \
             patch.object(self.aw.subprocess, 'Popen') as chain:
            try:
                threads[0].start()
                self.assertTrue(entered.wait(2), 'first completion check did not reach status')
                threads[1].start()
                self.assertTrue(second_attempted.wait(2), 'second completion check did not attempt the lock')
                self.assertEqual(status.call_count, 1)
            finally:
                release.set()
                for thread in threads:
                    if thread.ident is not None:
                        thread.join(2)
            self.assertFalse(any(thread.is_alive() for thread in threads), 'completion checks did not finish')
            self.assertEqual(errors, [])
            self.assertEqual(results, {'first': False, 'second': False})
            status.assert_called_once_with(self.launcher_argv, 'status', 'run-123', timeout=10)
            chain.assert_called_once()
        self.assertFalse(self.runfile(w).exists())

